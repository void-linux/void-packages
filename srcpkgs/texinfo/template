# Template file for 'texinfo'
pkgname=texinfo
version=7.3
revision=2
build_style=gnu-configure
# tests fail on musl and breaks cross-compilation
configure_args="--disable-perl-xs"
hostmakedepends="gzip perl ncurses-devel"
depends="gzip perl"
makedepends="ncurses-devel"
checkdepends="tar"
short_desc="GNU Documentation System"
maintainer="Enno Boland <gottox@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://www.gnu.org/software/texinfo/"
changelog="https://git.savannah.gnu.org/cgit/texinfo.git/plain/NEWS"
distfiles="${GNU_SITE}/texinfo/texinfo-${version}.tar.xz"
checksum=51f74eb0f51cfa9873b85264dfdd5d46e8957ec95b88f0fb762f63d9e164c72e

post_install() {
	rm -f ${DESTDIR}/usr/share/info/dir
	# Compress manually info files.
	gzip -9 ${DESTDIR}/usr/share/info/*
}
