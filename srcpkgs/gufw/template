# Template file for 'gufw'
pkgname=gufw
version=26.04
revision=1
build_style=python3-module
hostmakedepends="python3-setuptools python3-distutils-extra gettext
 python3-gobject gtk+3"
depends="python3-gobject net-tools ufw gtk+3"
short_desc="GTK+ frontend for ufw"
maintainer="Enno Boland <gottox@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://gufw.org/"
distfiles="https://github.com/costales/gufw/archive/refs/tags/$version.tar.gz"
checksum=e2da0bee3481331c4c7b791b3d7ec8e6e1b1fa86274d56a60decfbf1b90f568f

pre_configure() {
	vsed -i -e \
		"s|/usr/share/gufw/gufw/gufw.py|/usr/lib/python${py3_ver}/site-packages/gufw/gufw.py|" \
		bin/gufw-pkexec
}

pre_build() {
	printf '%s\n' po/*.po | sed 's;po/;;;s/.po//' >po/LINGUAS
	ln -sf /bin/true $XBPS_WRAPPERDIR/intltool-update
	sed -i 's/^_//' gufw.desktop.in
	msgfmt --desktop --template gufw.desktop.in \
		-d po -o gufw.desktop
	rm -f gufw.desktop.in
}

post_install() {
	vinstall gufw.desktop 644 usr/share/applications/
}
