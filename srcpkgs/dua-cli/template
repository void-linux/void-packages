# Template file for 'dua-cli'
pkgname=dua-cli
version=2.44.0
revision=1
build_style=cargo
build_helper=qemu
short_desc="Tool to conveniently learn about the disk usage of directories"
maintainer="cinerea0 <cinerea0@protonmail.com>"
license="MIT"
homepage="https://github.com/Byron/dua-cli"
changelog="https://raw.githubusercontent.com/Byron/dua-cli/main/CHANGELOG.md"
distfiles="https://github.com/Byron/dua-cli/archive/refs/tags/v${version}.tar.gz"
checksum=84fcc09a982542037e990bc3cf861b2e6ef34a556ad45552eceda3bb02801566

post_install() {
	vlicense LICENSE

	for shell in bash fish zsh; do
		vtargetrun ${DESTDIR}/usr/bin/dua completions ${shell} > dua.${shell}
		vcompletion dua.${shell} ${shell}
	done
}
