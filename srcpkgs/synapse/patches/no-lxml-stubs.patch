lxml-stubs is only needed for type checking, not at runtime.
Leaving it in the saml2 extra makes Synapse's dependency check fail at
runtime (and in the test suite) when the stubs are not installed.

diff --git a/pyproject.toml b/pyproject.toml
index 308a550..0250293 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -128,7 +128,6 @@ postgres = [
 ]
 saml2 = [
     "pysaml2>=4.5.0",
-    "lxml-stubs>=0.4.0",
 
     # Transitive dependencies from pysaml2
     # These dependencies aren't directly required by Synapse.
@@ -187,7 +186,6 @@ all = [
     "psycopg2cffi-compat==1.1;platform_python_implementation == 'PyPy'",
     # saml2
     "pysaml2>=4.5.0",
-    "lxml-stubs>=0.4.0",
     # oidc and jwt
     "authlib>=0.15.1",
     # url-preview
