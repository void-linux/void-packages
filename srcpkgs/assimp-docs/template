do_install() {
	vmkdir usr/share/doc/assimp
	vcopy build/html/*.html usr/share/doc/assimp/
	vcopy build/html/*.js usr/share/doc/assimp/
	vcopy build/html/API usr/share/doc/assimp/
	vcopy build/html/_static usr/share/doc/assimp/
	vcopy build/html/about usr/share/doc/assimp/
	vcopy build/html/developer usr/share/doc/assimp/
	vcopy build/html/usage usr/share/doc/assimp/
}

post_install() {
	vlicense LICENSE
}
