# Template file for 'mugshot'
pkgname=mugshot
version=0.4.3
revision=7
build_style=python3-module
hostmakedepends="gettext python3-distutils-extra clutter gdk-pixbuf
 gstreamer1 gtk+3 libcheese"
makedepends="python3-pexpect python3-gobject clutter gdk-pixbuf gtk+3
 gstreamer1 libcheese"
depends="accountsservice gtk+3 python3-dbus python3-gobject python3-pexpect"
short_desc="Program to update personal user details"
maintainer="zethra <jediben97@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/bluesabre/mugshot"
distfiles="https://github.com/bluesabre/mugshot/archive/refs/tags/mugshot-${version}.tar.gz"
checksum=afab48b119091b70d66689931fe1bec95c761a9da16d3ad070f37c6fb54286f8

post_configure() {
	printf '%s\n' po/*.po | sed 's;po/;;;s/.po//' >po/LINGUAS
	ln -sf /bin/true $XBPS_WRAPPERDIR/intltool-update

	sed -i 's/^_//' org.bluesabre.Mugshot.desktop.in
	sed -i 's/[<]_/</;s![<]/_!</!' \
		data/metainfo/mugshot.appdata.xml.in
	msgfmt --desktop -d po \
		--template org.bluesabre.Mugshot.desktop.in \
		--o org.bluesabre.Mugshot.desktop
	msgfmt --xml -d po \
		--template data/metainfo/mugshot.appdata.xml.in \
		-o data/metainfo/mugshot.appdata.xml
	rm org.bluesabre.Mugshot.desktop.in

	sed -i '/^write_appdata_file/d' setup.py
	# rm data/metainfo/mugshot.appdata.xml.in
	# rm com.ubuntu.pkexec.lightdm-gtk-greeter-settings.policy.in
}

pre_install() {
	vinstall org.bluesabre.Mugshot.desktop 644 \
		usr/share/applications/
}
