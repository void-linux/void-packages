# Template file for 'opentmux'
pkgname=opentmux
version=0.2
revision=2
build_style=meson
configure_args="-Dutempter=enabled -Dsixel=true -Dkitty=true"
hostmakedepends="byacc pkg-config"
makedepends="libevent-devel libutempter-devel ncurses-devel"
depends="ncurses-base"
checkdepends="ncurses-term"
short_desc="Terminal Multiplexer (fork of tmux 3.6a)"
maintainer="Leah Neukirchen <leah@vuxu.org>"
license="ISC"
homepage="https://codeberg.org/opentmux/opentmux"
changelog="https://codeberg.org/opentmux/opentmux/raw/branch/main/CHANGELOG.md"
distfiles="https://codeberg.org/opentmux/opentmux/releases/download/v${version}/opentmux-${version}.tar.gz"
checksum=771f729b1c43722007d0f481208acf0f9a0168c904168cf682d718355ce60689
replaces="tmux>=0"
conflicts="tmux>=0"

post_install() {
	{
		echo ' * Copyright (c) 2007-2021 Nicholas Marriott <nicholas.marriott@gmail.com>'
		grep -rh  'Copyright (c) .*[0-9] [a-zA-Z]' *.c compat/*.c |
			grep -v 'Nicholas Marriott' | sort -u
		cat COPYING
	} >LICENSE
	vlicense LICENSE
}
