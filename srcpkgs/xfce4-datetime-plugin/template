# Template file for 'xfce4-datetime-plugin'
pkgname=xfce4-datetime-plugin
version=0.8.3
revision=1
build_style=gnu-configure
configure_args="--with-locales-dir=/usr/share/locale
 ac_cv_path_INTLTOOL_UPDATE=/usr/bin/false
 ac_cv_path_INTLTOOL_MERGE=/usr/bin/false
 ac_cv_path_INTLTOOL_EXTRACT=/usr/bin/false
 ac_cv_path_INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="pkg-config gettext"
makedepends="xfce4-panel-devel"
short_desc="Date and time display plugin for the Xfce panel"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="https://goodies.xfce.org/projects/panel-plugins/xfce4-datetime-plugin"
changelog="https://gitlab.xfce.org/panel-plugins/xfce4-datetime-plugin/-/raw/master/NEWS"
distfiles="https://archive.xfce.org/src/panel-plugins/xfce4-datetime-plugin/${version%.*}/xfce4-datetime-plugin-${version}.tar.bz2"
checksum=6b2eeb79fb586868737426cbd2a4cd43c7f8c58507d8a2f578e0150187cc00b0

pre_configure() {
	vsed -i configure -e '/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.35/'
	vsed -i 's/^_//' panel-plugin/datetime.desktop.in
	printf '%s\n' po/*.po | sed 's!po/!!;s/[.]po//' >po/LINGUAS
}

pre_build() {
	msgfmt --desktop --template panel-plugin/datetime.desktop.in \
		-d po -o panel-plugin/datetime.desktop
}
