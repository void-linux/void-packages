# Template file for 'ldc-cross-config'
pkgname=ldc-cross-config
version=0.0.2
revision=1
depends="ldc"
short_desc="Helper for cross compiling with ldc"
maintainer="Đoàn Trần Công Danh <congdanhqx@gmail.com>"
license="BSD-2-Clause"
homepage="https://voidlinux.org"
repository=bootstrap

_gen_ldc_section() {
	local arch="$1"
	local libc="$2"
	cat <<-EOF
	"$arch-.*linux-$libc": {
	  lib-dirs = [
	    "/usr/$arch-linux-$libc/usr/lib",
	  ];
	}
	EOF
}

_build_ldc_conf() {
	for arch in aarch64 powerpc64 powerpc64le riscv64 x86_64 i686; do
		_gen_ldc_section "$arch" gnu
		_gen_ldc_section "$arch" musl
	done
	for arch in armv7l arm; do
		_gen_ldc_section "$arch" gnueabihf
		_gen_ldc_section "$arch" musleabihf
	done
}

do_build() {
	_build_ldc_conf >51-target-cross.conf
}

do_install() {
	vinstall 51-target-cross.conf 644 etc/ldc2.conf
}
