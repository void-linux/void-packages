# Template file for 'pop-launcher'
pkgname=pop-launcher
version=1.5.0
revision=1
build_style="cargo"
configure_args="--all"
build_options="sccache"
archs="x86_64* i686"
hostmakedepends="pkg-config just cargo cargo-auditable $(vopt_if sccache "rust-sccache")"
makedepends="libxkbcommon-devel"
checkdepends="qalculate"
short_desc="Modular IPC-based desktop launcher service"
maintainer="Bella Wagner <belladev109@proton.me>"
license="MPL-2.0"
homepage="https://github.com/pop-os/launcher"
distfiles="https://github.com/pop-os/launcher/archive/refs/tags/epoch-${version}.tar.gz"
checksum=39858eb5a15dac23604981a045db219a7cd435bc9d553974fa653ee0431f9871

pre_build() {
	$(vopt_if sccache "export RUSTC_WRAPPER=/usr/bin/sccache")
}

do_install() {
	just target-dir="target/${RUST_TARGET}/release" rootdir=${DESTDIR} install
}
