# Template file for 'raddebugger'
pkgname=raddebugger
version=0.9.29
revision=1
hostmakedepends="clang llvm git"
makedepends="freetype-devel libX11-devel libXext-devel libXfixes-devel libXrandr-devel libglvnd-devel"
short_desc="Native, user-mode, multi-process, graphical debugger by Epic Games"
maintainer="Zach <zachallrd@gmail.com>"
license="MIT"
homepage="https://github.com/EpicGames/raddebugger"
distfiles="${homepage}/archive/refs/tags/v${version}-alpha.tar.gz>${pkgname}-${version}-alpha.tar.gz"
checksum=a9e1646d04c408c91ae1312b5844e79e76849f96091021501f6caa3b49688434

pre_build() {
	# Satisfy build.sh by faking a git repository
	git init
	git config user.name "Void Linux"
	git config user.email "void@voidlinux.org"
	git commit --allow-empty -m "dummy commit"
}

do_build() {
	# Specify the target (raddbg) alongside the release flag
	CC=clang CXX=clang++ ./build.sh raddbg release
}

do_install() {
	vbin build/raddbg
	vlicense LICENSE
}
