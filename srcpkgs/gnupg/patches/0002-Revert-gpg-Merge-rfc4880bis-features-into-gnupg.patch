From: Anthony Accioly <54103-aaccioly@users.gitlab.alpinelinux.org>
Date: Fri, 18 Sep 2026 03:12:29 +0000
Subject: [PATCH] gpg: generate RFC4880-compatible keys by default

GnuPG 2.5.x defaults to the LibrePGP standard and the v5 key format,
which can cause interoperability problems with RFC4880 clients.  This
patch keeps compatible defaults for RSA and classic ECC curves, while
allowing advanced users to opt in to LibrePGP by choosing one of the
newer algorithms (e.g. Kyber, Curve 448) or by explicitly using a
compatibility mode such as --gnupg or --rfc4880bis (an alias for
--gnupg), which also implements authenticated encryption (AEAD) over
OCB.

  compliance mode    pref-aead-algos   features subpacket
  (default)          (none)            01 (MDC)
  --gnupg            2 (OCB)           07 (MDC + AEAD + v5)
  --rfc4880          (none)            01 (MDC)

This replaces the previous patches that targeted gnupg 2.4.x:

See original discussion for 2.4.x at https://lore.kernel.org/distributions/F30D6590-3E0C-4865-A944-7DE118A619CF@gentoo.org/
Old superseded patch for 2.4.x: https://gitlab.alpinelinux.org/alpine/aports/-/blob/5198d9ceccba6bdf4bff6e4bcb2e3c7e745e254a/main/gnupg/HACK-revert-rfc4880bis-default.patch
---
 g10/gpg.c    | 20 ++++++++++++++++++--
 g10/keygen.c | 33 +++++++++++++++++++++------------
 2 files changed, 39 insertions(+), 14 deletions(-)

diff --git a/g10/gpg.c b/g10/gpg.c
index 053cdce..77278b8 100644
--- a/g10/gpg.c
+++ b/g10/gpg.c
@@ -1020,7 +1020,7 @@ static gpgrt_opt_t opts[] = {
   ARGPARSE_s_n (oNoop, "no-allow-multiple-messages", "@"),
   ARGPARSE_s_s (oNoop, "aead-algo", "@"),
   ARGPARSE_s_s (oNoop, "personal-aead-preferences","@"),
-  ARGPARSE_s_n (oNoop, "rfc4880bis", "@"),
+  ARGPARSE_s_n (oGnuPG, "rfc4880bis", "@"),
   ARGPARSE_s_n (oNoop, "override-compliance-check", "@"),
 
 
@@ -2309,6 +2309,7 @@ set_compliance_option (enum cmd_and_opt_values option)
     case oGnuPG:
       /* set up default options affected by policy compliance: */
       opt.compliance = CO_GNUPG;
+      opt.flags.rfc4880bis = 1;
       opt.flags.dsa2 = 0;
       opt.flags.require_cross_cert = 1;
       opt.rfc2440_text = 0;
@@ -2374,6 +2375,12 @@ set_compliance_option (enum cmd_and_opt_values option)
     default:
       BUG ();
     }
+
+  /* The strict compliance cases above recurse into the oGnuPG case,
+     which re-enables the LibrePGP features.  Disable them again for
+     every mode but --gnupg/--rfc4880bis.  */
+  if (option != oGnuPG)
+    opt.flags.rfc4880bis = 0;
 }
 
 
@@ -2556,6 +2563,10 @@ main (int argc, char **argv)
     opt.with_subkey_fingerprint = 1;
     set_compliance_option (oGnuPG);
 
+    /* Only an explicit compliance option enables the LibrePGP features;
+       the implicit default keeps generating RFC4880-compatible keys.  */
+    opt.flags.rfc4880bis = 0;
+
     /* Check special options given on the command line.  */
     orig_argc = argc;
     orig_argv = argv;
@@ -4035,6 +4046,11 @@ main (int argc, char **argv)
     if( may_coredump && !opt.quiet )
 	log_info(_("WARNING: program may create a core file!\n"));
 
+    if (!opt.flags.rfc4880bis)
+      {
+        opt.mimemode = 0; /* This will use text mode instead.  */
+      }
+
     if (eyes_only) {
       if (opt.set_filename)
 	  log_info(_("WARNING: %s overrides %s\n"),
@@ -4257,7 +4273,7 @@ main (int argc, char **argv)
     /* Check our chosen algorithms against the list of legal
        algorithms. */
 
-    if(!GNUPG)
+    if(!GNUPG && !opt.flags.rfc4880bis)
       {
 	const char *badalg=NULL;
 	preftype_t badtype=PREFTYPE_NONE;
diff --git a/g10/keygen.c b/g10/keygen.c
index bb30a1d..9d8e996 100644
--- a/g10/keygen.c
+++ b/g10/keygen.c
@@ -492,7 +492,7 @@ keygen_set_std_prefs (const char *string,int personal)
 	    if ( !openpgp_cipher_test_algo (CIPHER_ALGO_3DES) )
               strcat(dummy_string,"S2 "); /* 3DES - RFC4880 default. */
 
-            if (!openpgp_aead_test_algo (AEAD_ALGO_OCB))
+            if (opt.flags.rfc4880bis && !openpgp_aead_test_algo (AEAD_ALGO_OCB))
 	      strcat(dummy_string,"A2 ");
 
             if (personal)
@@ -999,7 +999,7 @@ keygen_upd_std_prefs (PKT_signature *sig, void *opaque)
   /* Make sure that the MDC feature flag is set if needed.  */
   add_feature_mdc (sig,mdc_available);
   add_feature_aead (sig, aead_available);
-  add_feature_v5 (sig, 1);
+  add_feature_v5 (sig, opt.flags.rfc4880bis);
   add_keyserver_modify (sig,ks_modify);
   keygen_add_keyserver_url(sig,NULL);
 
@@ -4153,7 +4153,10 @@ parse_key_parameter_part (ctrl_t ctrl,
                 }
             }
           else if (!ascii_strcasecmp (s, "v5"))
-            keyversion = 5;
+            {
+              if (opt.flags.rfc4880bis)
+                keyversion = 5;
+            }
           else if (!ascii_strcasecmp (s, "v4"))
             keyversion = 4;
           else
@@ -4334,6 +4337,9 @@ parse_key_parameter_part (ctrl_t ctrl,
   /* Ed448, X448 and the PQC algos must only be used as v5 keys.  */
   if (is_448 || is_pqc)
     {
+      /* Kyber and the 448-bit curves are LibrePGP by nature, so always
+         enable the LibrePGP features regardless of the compliance mode.  */
+      opt.flags.rfc4880bis = 1;
       if (keyversion == 4)
         log_info (_("WARNING: v4 is specified, but overridden by v5.\n"));
 
@@ -4414,7 +4420,7 @@ parse_key_parameter_part (ctrl_t ctrl,
  *   ecdsa := Use algorithm ECDSA.
  *   eddsa := Use algorithm EdDSA.
  *   ecdh  := Use algorithm ECDH.
- *   v5    := Create version 5 key
+ *   v5    := Create version 5 key (only when LibrePGP features are enabled; Kyber/448 always are)
  *
  * There are several defaults and fallbacks depending on the
  * algorithm.  PART can be used to select which part of STRING is
@@ -5396,9 +5402,9 @@ read_parameter_file (ctrl_t ctrl, const char *fname )
 	    }
 	}
 
-        if ((keywords[i].key == pVERSION
-             || keywords[i].key == pSUBVERSION))
-          ; /* Ignore version.  */
+        if (!opt.flags.rfc4880bis && (keywords[i].key == pVERSION
+                                      || keywords[i].key == pSUBVERSION))
+          ; /* Ignore version unless the LibrePGP features are active.  */
         else
           {
             r = xmalloc_clear( sizeof *r + strlen( value ) );
@@ -5493,11 +5499,14 @@ quickgen_set_para (struct para_data_s *para, int for_subkey,
   r->next = para;
   para = r;
 
-  r = xmalloc_clear (sizeof *r + 20);
-  r->key = for_subkey? pSUBVERSION : pVERSION;
-  snprintf (r->u.value, 20, "%d", version);
-  r->next = para;
-  para = r;
+  if (opt.flags.rfc4880bis)
+    {
+      r = xmalloc_clear (sizeof *r + 20);
+      r->key = for_subkey? pSUBVERSION : pVERSION;
+      snprintf (r->u.value, 20, "%d", version);
+      r->next = para;
+      para = r;
+    }
 
   if (keytime)
     {
