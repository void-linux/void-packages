# Template file for 'qiv'
pkgname=qiv
version=3.0.4
revision=1
build_style=gnu-makefile
hostmakedepends="pkg-config"
makedepends="file-devel gtk+3-devel libexif-devel lcms2-devel"
depends="file"
short_desc="Quick Image Viewer"
maintainer="Leah Neukirchen <leah@vuxu.org>"
license="GPL-2.0-only"
homepage="http://spiegl.de/qiv/"
distfiles="https://codeberg.org/ciberandy/qiv/releases/download/v${version}/qiv-${version}.tar.gz"
checksum=f127f65982e62c169cfbbc8cadffe885f71e2f4c3dd48d7da59852f67b378089
make_check=no # needs X11 running

pre_build() {
	export CFLAGS="$CFLAGS $LDFLAGS"
}

do_install() {
	make install PREFIX=${DESTDIR}/usr
}
