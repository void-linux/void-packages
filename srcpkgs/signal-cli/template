# Template file for 'signal-cli'
pkgname=signal-cli
version=0.14.6
revision=1
archs="x86_64"
depends="openjdk25-jre"
short_desc="Command-line/D-Bus/JSON-RPC client for Signal"
maintainer="Zoa Hickenlooper <zoa@router.sex>"
license="GPL-3.0-or-later"
homepage="https://github.com/AsamK/signal-cli"
changelog="https://github.com/AsamK/signal-cli/releases"
distfiles="https://github.com/AsamK/signal-cli/releases/download/v${version}/signal-cli-${version}.tar.gz"
checksum=e90f4faea709b3c0a55909646a2b94289b9779ba9c8fd5c6eaa847d3f67312eb

do_install() {
	vmkdir usr/lib/signal-cli
	vcopy bin usr/lib/signal-cli/
	rm -f ${DESTDIR}/usr/lib/signal-cli/bin/signal-cli.bat
	vcopy lib usr/lib/signal-cli/
	vmkdir usr/bin
	# Don't symlink straight to the upstream launcher: it falls back to
	# whatever "java" resolves first on PATH when JAVA_HOME is unset, which
	# silently picks up an unrelated JRE (e.g. a user-managed SDKMAN
	# install) ahead of the openjdk25-jre this package actually depends on,
	# causing UnsupportedClassVersionError. Pin JAVA_HOME explicitly.
	cat <<-EOF > signal-cli
	#!/bin/sh
	export JAVA_HOME=/usr/lib/jvm/openjdk25
	exec /usr/lib/signal-cli/bin/signal-cli "\$@"
	EOF
	vbin signal-cli
	for m in man/man*/*; do
		vman "$m"
	done
}

signal-cli-daemon_package() {
	depends="signal-cli>=${version}_${revision} dbus"
	short_desc+=" - D-Bus system service"
	system_accounts="_signalcli"
	_signalcli_homedir="/var/lib/signal-cli"
	make_dirs="
	 /var/lib/signal-cli 0755 _signalcli _signalcli
	 /var/lib/signal-cli/data 0700 _signalcli _signalcli
	 /var/lib/signal-cli/attachments 0750 _signalcli _signalcli
	 /var/lib/signal-cli/avatars 0750 _signalcli _signalcli
	 /var/lib/signal-cli/stickers 0750 _signalcli _signalcli"

	pkg_install() {
		vinstall ${FILESDIR}/org.asamk.Signal.conf 644 etc/dbus-1/system.d
		vsv signal-cli
	}
}
