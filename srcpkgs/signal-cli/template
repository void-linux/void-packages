do_install() {
	vmkdir usr/lib/signal-cli
	vcopy bin usr/lib/signal-cli/
	vcopy lib usr/lib/signal-cli/
	vmkdir usr/bin
	ln -s /usr/lib/signal-cli/bin/signal-cli ${DESTDIR}/usr/bin/signal-cli
}
