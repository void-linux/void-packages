# Template file for 'ChiPass'
pkgname=ChiPass
version=2026.09.0
revision=1
build_style=cmake
# Release 2026.09.0 is missing toplevel directory
create_worksrc=yes
build_worksrc=ChiPass-$version
cmake_builddir=ChiPass-$version
configure_args="-DCHIPASS_WITH_TESTS=ON -DCHIPASS_WITH_UPDATE_CHECK=OFF
 -DCHIPASS_WITH_MANUAL=$(vopt_if manual ON OFF)
 -DCHIPASS_WITH_AUTOTYPE=$(vopt_if autotype ON OFF)
 -DCHIPASS_WITH_BROWSER=$(vopt_if browser ON OFF)
 -DCHIPASS_WITH_BROWSER_PASSKEYS=$(vopt_if passkey ON OF)
 -DCHIPASS_WITH_FDOSECRETS=$(vopt_if fdosecrets ON OFF)
 -DCHIPASS_WITH_KEESHARE=$(vopt_if keeshare ON OFF)
 -DCHIPASS_WITH_NETWORKING=$(vopt_if network ON OFF)
 -DCHIPASS_WITH_SSHAGENT=$(vopt_if sshagent ON OFF)
 -DCHIPASS_WITH_YUBIKEY=$(vopt_if yubikey ON OFF)"
hostmakedepends="qt6-base qt6-tools qt6-translations pkg-config ruby-asciidoctor AppStream"
makedepends="qt6-svg-devel qt6-qt5compat-devel qt6-base-devel qt6-base-private-devel
 qt6-translations
 botan-devel libargon2-devel qrencode-devel readline-devel libusb-devel
 zlib-devel zxcvbn-c-devel
 $(vopt_if autotype 'libX11-devel')
 $(vopt_if keeshare minizip-devel)
 $(vopt_if yubikey pcsclite-devel)"
checkdepends="dbus"
short_desc="A cross-platform secure password manager"
maintainer="ConfuSomu <ConfuSomu@twilightsparkle.space>"
license="GPL-3.0-or-later, BSD-3-Clause, CC0-1.0, LGPL-2.0-only, LGPL-2.1-only,
 LGPL-3.0-or-later, Nokia-Qt-exception-1.1, MIT, BSL-1.0"
homepage="https://chipass.org/"
changelog="https://codeberg.org/ChiPass/ChiPass/src/tag/v${version}/CHANGELOG.md"
distfiles="https://codeberg.org/ChiPass/ChiPass/releases/download/v${version}/ChiPass-${version}-source.tar.bz2"
checksum=0e0fa8d3ccd3652c04bb82226fc85a6af505b60325a8f09ab94fcb4a6013f8a8

build_options="autotype browser fdosecrets keeshare manual network passkey sshagent yubikey"
desc_option_autotype="Include auto-type (emulation of keyboard input)"
desc_option_browser="Include browser integration with keepassxc-browser-plugin"
desc_option_fdosecrets="Include freedesktop.org Secret Storage API server"
desc_option_keeshare="Include sharing integration with KeeShare"
desc_option_manual="Include user documentation"
desc_option_network="Include networking features, such as favicon download"
desc_option_passkey="Include passkey support for browser integration"
desc_option_sshagent="Include SSH agent support"
desc_option_yubikey="Include YubiKey support"
build_options_default="autotype browser fdosecrets keeshare manual network passkey sshagent yubikey"

post_install() {
	vlicense COPYING
	vlicense LICENSE.BSD
	vlicense LICENSE.MIT
}

do_check() {
	mkdir -p /tmp/rt
	chmod 0700 /tmp/rt
	# Used by Qt and DBus
	export XDG_RUNTIME_DIR="/tmp/rt"

	# Ignore failed tests
	# This is similar to keepassxc template
	# Fails on:
	# - TestEntryModel::testAttributesModel()
	# - TestCli::testClip()
	QT_QPA_PLATFORM=vnc ninja -C ChiPass-$version test || true
}
