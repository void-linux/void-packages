# Template file for 'svt-av1'
pkgname=svt-av1
version=4.3.1
revision=1
build_style=cmake
configure_args="-DSVT_AV1_LTO=ON"
short_desc="AV1-compliant encoder/decoder library core"
maintainer="Orphaned <orphan@voidlinux.org>"
license="BSD-3-Clause-Clear"
homepage="https://github.com/AOMediaCodec/SVT-AV1"
changelog="https://raw.githubusercontent.com/AOMediaCodec/SVT-AV1/main/CHANGELOG.md"
distfiles="https://github.com/AOMediaCodec/SVT-AV1/archive/refs/tags/v${version}.tar.gz"
checksum=ad94f481cb74821af183f37f4533fc52324b76ffbd98ec7723e282bab0cf9fc4

case "$XBPS_TARGET_MACHINE" in
	i686* | x86_64*) hostmakedepends="nasm"
esac

libsvt-av1_package() {
	short_desc+=" - library files"
	pkg_install() {
		vmove "usr/lib/libSvtAv1Enc.so.*"
		vlicense LICENSE.md
	}
}

libsvt-av1-devel_package() {
	short_desc+=" - development files"
	depends="libsvt-av1>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
