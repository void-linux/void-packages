# Template file for 'wget2'
pkgname=wget2
version=2.3.0
revision=1
build_style=gnu-configure
configure_args="$(vopt_if ssl '--with-ssl=openssl') $(vopt_if gnutls '--with-ssl=gnutls')
 --without-libhsts"
hostmakedepends="autoconf pkg-config doxygen pandoc texinfo"
makedepends="libpsl-devel nghttp2-devel gpgme-devel zlib-devel brotli-devel libzstd-devel
 lzlib-devel libidn2-devel pcre2-devel libmicrohttpd-devel $(vopt_if gnutls 'gnutls-devel')
 $(vopt_if ssl 'openssl-devel')"
depends="ca-certificates"
short_desc="Successor of GNU Wget, a file and recursive website downloader"
maintainer="xJayMorex <github@johntaylor.hu>"
license="GPL-3.0-or-later, LGPL-3.0-or-later"
homepage="https://gitlab.com/gnuwget/wget2"
changelog="https://gitlab.com/gnuwget/wget2/-/releases"
distfiles="${GNU_SITE}/wget/wget2-${version}.tar.gz"
checksum=4f1915b2a55a789a15f2f9ada7cc44bca81418e648f76fd88a7f4dd028b2149f

build_options="gnutls ssl"
build_options_default="ssl"
vopt_conflict gnutls ssl

post_install() {
	rm -f ${DESTDIR}/usr/bin/wget2_noinstall
}
