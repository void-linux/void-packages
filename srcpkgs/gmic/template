# Template file for 'gmic'
pkgname=gmic
version=4.0.7
revision=1
_zart_hash=d014169343f835381ad232ee11e077326561c9eb
build_style=gnu-makefile
build_helper=qmake
make_build_args="NOSTRIP=yes lib libc cli_shared"
hostmakedepends="pkg-config gimp qt6-base qt6-tools qt5-host-tools qt5-qmake cmake ninja eigen"
makedepends="fftw-devel imath-devel libopenexr-devel MesaLib-devel libopencv-devel
 libgomp-devel lcms2-devel libpng-devel libjpeg-turbo-devel tiff-devel libcurl-devel
 gimp-devel qt5-devel qt6-base-devel libwebp-devel libgraphicsmagick-devel"
short_desc="GREYC's Magic for Image Computing (image processing framework)"
maintainer="Orphaned <orphan@voidlinux.org>"
license="CECILL-2.1, CECILL-C"
homepage="https://gmic.eu/"
distfiles="https://gmic.eu/get_file.php?file=source/gmic_${version}.tar.gz>gmic_${version}.tar.gz
 https://github.com/c-koi/zart/archive/${_zart_hash}.tar.gz>zart-${_zart_hash}.tar.gz"
checksum="f84b215f40cb00de37bff5ec801103af211679794c3602d39c5430dab76005de
 baebe339566993194f98a71895bff09520b08f38e66eae215758aaa260557bcf"

skip_extraction="zart-${_zart_hash}.tar.gz"

post_extract() {
	vsrcextract -C zart zart-${_zart_hash}.tar.gz
	case "$XBPS_TARGET_MACHINE" in
		arm*) vsed -e "s|-mtune=generic||g" -i src/Makefile ;;
	esac
}

# mixed build systems, manually build them instead of letting the gmic
# makefile do it.
post_build() {
	cmake_args="-Wno-dev -G Ninja -DBUILD_WITH_QT6=ON -DENABLE_SYSTEM_GMIC=OFF -DENABLE_DYNAMIC_LINKING=ON
	 -DENABLE_OPENCV=ON -DGMIC_PATH=${wrksrc}/src -DCMAKE_INSTALL_PREFIX=/usr"

	# copied out of the cmake build-style
	if [ "$CROSS_BUILD" ]; then
		case "$XBPS_TARGET_MACHINE" in
			x86_64*) _CMAKE_SYSTEM_PROCESSOR=x86_64 ;;
			i686*) _CMAKE_SYSTEM_PROCESSOR=x86 ;;
			aarch64*) _CMAKE_SYSTEM_PROCESSOR=aarch64 ;;
			arm*) _CMAKE_SYSTEM_PROCESSOR=arm ;;
			mips*) _CMAKE_SYSTEM_PROCESSOR=mips ;;
			ppc64le*) _CMAKE_SYSTEM_PROCESSOR=ppc64le ;;
			ppc64*) _CMAKE_SYSTEM_PROCESSOR=ppc64 ;;
			ppcle*) _CMAKE_SYSTEM_PROCESSOR=ppcle ;;
			ppc*) _CMAKE_SYSTEM_PROCESSOR=ppc ;;
			riscv64*) _CMAKE_SYSTEM_PROCESSOR=riscv64 ;;
			*) _CMAKE_SYSTEM_PROCESSOR=generic ;;
		esac
		cat > cross_${XBPS_CROSS_TRIPLET}.cmake <<_EOF
SET(CMAKE_SYSTEM_NAME Linux)
SET(CMAKE_SYSTEM_VERSION 1)

SET(CMAKE_C_COMPILER   ${CC})
SET(CMAKE_CXX_COMPILER ${CXX})
SET(CMAKE_CROSSCOMPILING TRUE)

SET(CMAKE_SYSTEM_PROCESSOR ${_CMAKE_SYSTEM_PROCESSOR})

SET(CMAKE_FIND_ROOT_PATH  "${XBPS_CROSS_BASE}/usr;${XBPS_CROSS_BASE}")

SET(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
SET(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
SET(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
_EOF
		cmake_args+=" -DQT_HOST_PATH=/usr"
		cmake_args+=" -DCMAKE_TOOLCHAIN_FILE=${wrksrc}/${build_wrksrc}/cross_${XBPS_CROSS_TRIPLET}.cmake"
	fi

	set -x

	# gmic_qt and gimp
	for _i in none gimp3 ;do
		cmake ${cmake_args} -DGMIC_QT_HOST="${_i}" -B "build-${_i}" -S gmic-qt
		vsed -e "s|-llibgmicstatic|${wrksrc}/src/libgmic.so|g" -i "build-${_i}/build.ninja"
		ninja ${makejobs} -C "build-${_i}"
	done

	(
		cd zart
		qmake-qt5 CONFIG+=release GMIC_PATH="${wrksrc}/src" GMIC_DYNAMIC_LINKING=on zart.pro
		make ${makejobs}
	)
}

# gimptool --gimpplugindir - puts plugin into lib64/32
post_install() {
	vlicense COPYING
	if [ -e ${DESTDIR}/usr/lib${XBPS_TARGET_WORDSIZE} ] && [ ! -L ${DESTDIR}/usr/lib${XBPS_TARGET_WORDSIZE} ]; then
		mv "$DESTDIR/usr/lib${XBPS_TARGET_WORDSIZE}"/* "$DESTDIR/usr/lib"
		rmdir ${DESTDIR}/usr/lib${XBPS_TARGET_WORDSIZE}
	fi
	for _i in none gimp3 ;do
		DESTDIR=${DESTDIR} ninja -C "build-${_i}" install
	done
	(
		cd zart
		make DESTDIR=$DESTDIR install
	)
}

libgmic_package() {
	short_desc+=" - libraries"
	pkg_install() {
		vmove "usr/lib/*.so.*"
	}
}

gmic-gimp_package() {
	short_desc+=" - GIMP plugin"
	depends="gimp"
	pkg_install() {
		vmove "usr/lib/gimp"
	}
}

gmic-zart_package() {
	short_desc+=" - ZArt tool"
	pkg_install() {
		vmove usr/bin/zart
		vmove usr/share/applications/zart.desktop
		vmove usr/share/icons/hicolor/48x48/apps/zart.png
		vmove usr/share/icons/hicolor/scalable/apps/zart.svg
	}
}

gmic-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
	}
}
