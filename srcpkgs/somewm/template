pkgname=somewm
version=2.1.0
revision=1
_wlroots_ver=0.20.2
build_style=meson
configure_args="-Db_sanitize=none -Dwerror=false"
hostmakedepends="pkg-config wayland-devel"
makedepends="LuaJIT-devel lua51-lgi cairo-devel pango-devel gdk-pixbuf-devel
 librsvg-devel libglib-devel dbus-devel wayland-protocols libdrm-devel
 libinput-devel libxkbcommon-devel libgbm-devel libglvnd-devel pixman-devel
 eudev-libudev-devel libseat-devel libdisplay-info-devel libliftoff-devel
 lcms2-devel hwids libffi-devel expat-devel xorg-server-xwayland libxcb-devel
 xcb-util-devel xcb-util-wm-devel xcb-util-renderutil-devel
 xcb-util-errors-devel pam-devel"
depends="lua51-lgi libpcre2"
short_desc="Lua framework to build your perfect wayland desktop"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://somewm.org"
changelog="https://github.com/trip-zip/somewm/blob/main/CHANGELOG.md"
distfiles="https://github.com/trip-zip/somewm/archive/refs/tags/v${version}.tar.gz
 https://gitlab.freedesktop.org/wlroots/wlroots/-/releases/${_wlroots_ver}/downloads/wlroots-${_wlroots_ver}.tar.gz>wlroots-${_wlroots_ver}.tar.gz"
checksum="881d4941df12cc7674fead1772d6c886690485b2f2fcde580a489cf7b3f3213e
 80c567d2ed4efb2cfa6b077f22c7a710d9c78ba4e185a75e8694001114af0733"

skip_extraction="wlroots-${_wlroots_ver}.tar.gz"

post_extract() {
	vsrcextract -C subprojects/wlroots wlroots-${_wlroots_ver}.tar.gz
}

post_patch() {
	patch -p1 -d subprojects/wlroots <subprojects/packagefiles/wlroots-corners.diff
}

post_install() {
	# Files installed by subprojects
	rm -r \
		"${PKGDESTDIR}/usr/include/wlroots-${_wlroots_ver%.*}" \
		"${PKGDESTDIR}/usr/lib/libwlroots-${_wlroots_ver%.*}.a" \
		"${PKGDESTDIR}/usr/lib/pkgconfig/wlroots-${_wlroots_ver%.*}.pc"
	rm -d \
		"${PKGDESTDIR}/usr/lib/pkgconfig" \
		"${PKGDESTDIR}/usr/include"
}
