# Template file for 'budgie-desktop'
pkgname=budgie-desktop
version=10.9.4
revision=1
build_style=meson
build_helper=gir
configure_args="-Dwith-gtk-doc=false -Duse-old-zenity=true"
hostmakedepends="pkg-config gettext vala glib-devel gobject-introspection
 sassc budgie-screensaver zenity polkit"
makedepends="alsa-lib-devel libcanberra-devel libgee-devel libnotify-devel
 accountsservice-devel libpeas2-devel libwnck-devel magpie-devel ibus-devel
 gnome-desktop-devel pulseaudio-devel upower-devel gtk+3-devel polkit-devel
 gnome-bluetooth1-devel gnome-menus-devel gnome-settings-daemon-devel vala
 libupower-glib3 libuuid-devel gstreamer1-devel libxfce4windowing-devel libwacom-devel"
depends="budgie-session gnome-settings-daemon budgie-control-center elogind
 gnome-themes-extra budgie-screensaver budgie-desktop-view zenity"
short_desc="Modern desktop environment from the Solus Project"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-only, LGPL-2.1-only"
homepage="https://github.com/BuddiesOfBudgie/budgie-desktop"
distfiles="https://github.com/BuddiesOfBudgie/budgie-desktop/releases/download/v${version}/budgie-desktop-v${version}.tar.xz"
checksum=0d1899ecad0051ef54f587b097add678ecb535b0de5e93e4fdfa23da6c557852

post_patch() {
	local file
	sed -i "s/intltool =.*/i18n = import('i18n')/" meson.build
	for file in src/*/*.desktop.in \
		src/dialogs/polkit/meson.build \
		src/raven/widgets/*/*.plugin.in \
		src/panel/applets/*/*.plugin.in; do
		sed -i 's/^_//' $file
	done
	for file in src/daemon/meson.build src/panel/meson.build \
		src/session/meson.build src/wm/meson.build \
		src/dialogs/polkit/meson.build \
		src/raven/widgets/*/meson.build \
		src/panel/applets/*/meson.build; do
		vsed -i "
			s/custom_target..desktop-file-.*/i18n.merge_file(/
			s/custom_target..plugin-file-.*/i18n.merge_file(/
			s/custom_target..raven-plugin-.*/i18n.merge_file(/
			s/custom_target('org.buddiesofbudgie.BudgieScreenshot.*/i18n.merge_file(/
			s/command.*intltool.*desktop.*/po_dir: podir, type: 'desktop',/
		" $file
	done
}

budgie-desktop-devel_package() {
	short_desc+=" - development files"
	depends="${makedepends} ${sourcepkg}-${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove usr/share/vala
		vmove "usr/lib/*.so"
		vmove usr/share/gir-1.0
	}
}
