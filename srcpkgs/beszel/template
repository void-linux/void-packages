# Template file for 'beszel'
pkgname=beszel
version=0.21.0
revision=1
archs="~i686"
build_style=go
go_import_path="github.com/henrygd/beszel"
go_package="${go_import_path}/internal/cmd/agent ${go_import_path}/internal/cmd/hub"
make_check_args="-skip TestServiceUpdateCPUPercent" # requires systemd
make_dirs="/etc/beszel/beszel_data 0755 _beszel _beszel"
hostmakedepends="nodejs"
short_desc="Lightweight server monitoring platform"
maintainer="xJayMorex <github@johntaylor.hu>"
license="MIT"
homepage="https://github.com/henrygd/beszel"
distfiles="https://github.com/henrygd/beszel/archive/refs/tags/v${version}.tar.gz"
checksum=782378299b883d5a02fc0fad73b990a50d07c72c755df08edcf1b0530995129a
system_accounts="_beszel"

if [ "$XBPS_CHECK_PKGS" ]; then
	go_build_tags="testing no_ui"
fi

pre_configure() {
	npm install --prefix ./internal/site
	npm run --prefix ./internal/site build
}

do_install() {
	vbin $(find . -name hub -type f) ${pkgname}
	vlicense LICENSE
	vdoc ${FILESDIR}/beszel-README.voidlinux README.voidlinux
	vsv beszel
}

beszel-agent_package() {
	short_desc+=" agent"
	system_accounts="_beszel"

	pkg_install() {
		vbin $(find . -name agent -type f) ${pkgname}
		vlicense LICENSE
		vdoc ${FILESDIR}/beszel-agent-README.voidlinux README.voidlinux
		vsv beszel-agent
	}
}
