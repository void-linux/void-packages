make_check=no # Tests still depend on build files that have been removed by upstream

post_patch() {
	vsed -i 's,<glib/gi18n.h>,<glib.h>,g' src/ario-profiles.c

	for file in plugins/*/*.desktop.in data/ario.desktop.in*; do
		vsed -i 's/^_//' $file
	done
}
