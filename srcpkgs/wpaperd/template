# Template file for 'wpaperd'
pkgname=wpaperd
version=1.3.0
revision=1
build_style=cargo
make_build_args="-p wpaperd -p wpaperctl"
hostmakedepends="pkg-config scdoc"
makedepends="wayland-devel wlroots0.20-devel"
short_desc="Modern wallpaper daemon for wayland"
maintainer="Red <me@nospawnn.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/danyspin97/wpaperd"
changelog="https://raw.githubusercontent.com/danyspin97/wpaperd/refs/heads/main/CHANGELOG.md"
distfiles="https://github.com/danyspin97/wpaperd/archive/refs/tags/${version}.tar.gz"
checksum=1c2fe605beec2b5728ada9a9d616114e777f3f7f4ea0713bb978705df6f948c5

do_install() {
	vbin target/${RUST_TARGET}/release/wpaperd
	vbin target/${RUST_TARGET}/release/wpaperctl
	scdoc < man/wpaperd-output.5.scd > man/wpaperd-output.5
	vman man/wpaperd-output.5
}
