# Template file for 'crush'
pkgname=crush
version=0.98.1
revision=1
build_style=go
build_helper=qemu
go_import_path=github.com/charmbracelet/crush
go_ldflags="-X ${go_import_path}/internal/version.Version=${version}"
checkdepends="git"
short_desc="Terminal coding agent from Charm"
maintainer="BlackScorp <cccpmik@gmail.com>"
license="FSL-1.1-MIT"
homepage="https://github.com/charmbracelet/crush"
distfiles="https://github.com/charmbracelet/crush/archive/refs/tags/v${version}.tar.gz"
checksum=fcc671cc2615bd9c3bb2ccb8cd74e9dc5f4e5b4990ddd4e041923e5960eebca4

export CGO_ENABLED=0

post_install() {
	vlicense LICENSE.md

	for shell in bash fish zsh; do
		vtargetrun ${DESTDIR}/usr/bin/crush completion ${shell} > crush.${shell}
		vcompletion crush.${shell} ${shell}
	done
	vtargetrun ${DESTDIR}/usr/bin/crush man > crush.1
	vman crush.1
}
