# Template file for 'ggml'
pkgname=ggml
version=1.0.0
revision=1
build_style=cmake
configure_args="-DBUILD_SHARED_LIBS=ON -DGGML_NATIVE=OFF -DGGML_BUILD_EXAMPLES=OFF"
makedepends="libgomp-devel"
short_desc="Tensor library for machine learning"
maintainer="Mateusz Sylwestrzak <slymattz@gmail.com>"
license="MIT"
homepage="https://github.com/ggml-org/ggml"
changelog="https://github.com/ggml-org/ggml/releases"
distfiles="https://github.com/ggml-org/ggml/archive/refs/tags/v${version}.tar.gz"
checksum=27de4df871da091112a1e4ea0e13be70f364af5da666c1246fb26fde2b21fac0

post_install() {
	vlicense LICENSE
}

ggml-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
	}
}
