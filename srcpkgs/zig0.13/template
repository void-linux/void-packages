# Template file for 'zig0.13'
pkgname=zig0.13
version=0.13.0
revision=1
_zigver=${version%.*}
_llvmver=18
_zig_prefix=usr/lib/zig/${_zigver}
archs="x86_64* aarch64*"
build_style=cmake
configure_args="
 -DCMAKE_INSTALL_PREFIX=/${_zig_prefix}
 -DZIG_TARGET_MCPU=baseline"
make_cmd=make
# we add xml2, zstd, zlib and ncurses
# because our lld is static-only and requires those to work
makedepends="clang${_llvmver}-devel llvm${_llvmver}-devel lld${_llvmver}-devel
 libxml2-devel libzstd-devel ncurses-devel zlib-devel"
short_desc="Zig programming language (version ${_zigver})"
maintainer="Alex March <alex@hosaka.cc>"
license="MIT"
homepage="https://ziglang.org"
changelog="https://ziglang.org/download/${version}/release-notes.html"
distfiles="https://ziglang.org/download/${version}/zig-${version}.tar.xz"
checksum=06c73596beeccb71cc073805bdb9c0e05764128f16478fa53bf17dfabc1d4318
alternatives="zig:/usr/bin/zig:/${_zig_prefix}/bin/zig"
nopie=yes
nocross=yes

export CMAKE_GENERATOR="Unix Makefiles"

post_install() {
	vlicense LICENSE
	vmkdir usr/bin
	ln -s ../lib/zig/${_zigver}/bin/zig ${DESTDIR}/usr/bin/zig${_zigver}
}
