# Template file for 'libsepol'
pkgname=libsepol
version=3.11
revision=1
build_style=gnu-makefile
make_install_args=SHLIBDIR=/usr/lib
hostmakedepends="flex"
short_desc="SELinux binary policy manipulation library"
maintainer="Orphaned <orphan@voidlinux.org>"
license="LGPL-2.1-or-later"
homepage="http://userspace.selinuxproject.org"
distfiles="https://github.com/SELinuxProject/selinux/releases/download/${version}/libsepol-${version}.tar.gz"
checksum=79f3d2c88f44b7eb5cf54d9792e03232297e17f97a179163f2750099a00f164d

CFLAGS="-fcommon"

libsepol-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove usr/share/man/man3
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
