From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 17 Apr 2026 11:00:00 -0400
Subject: [PATCH] CMake: explicitly load Qt6WaylandClientPrivate

The utility subdirectories link against Qt6::WaylandClientPrivate, but
the top-level project only loads the public WaylandClient module. Void's
Qt packaging provides the private target through the separate
Qt6WaylandClientPrivate package config, so it must be requested
explicitly before those links are evaluated.
---
 CMakeLists.txt | 1 +
 1 file changed, 1 insertion(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4a6e966..3fc7730 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -9,6 +9,7 @@ set(CMAKE_CXX_STANDARD 23)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
 find_package(Qt6 6.5 REQUIRED COMPONENTS Widgets Quick QuickControls2 WaylandClient)
+find_package(Qt6WaylandClientPrivate REQUIRED)
 find_package(PkgConfig REQUIRED)
 
 pkg_check_modules(hyprutils REQUIRED IMPORTED_TARGET hyprutils)
