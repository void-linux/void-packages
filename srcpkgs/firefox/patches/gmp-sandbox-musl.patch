diff -ruN a/dom/media/gmp/GMPLoader.cpp b/dom/media/gmp/GMPLoader.cpp
--- a/dom/media/gmp/GMPLoader.cpp	2026-10-05 10:51:00.000000000 -0700
+++ b/dom/media/gmp/GMPLoader.cpp	2026-10-08 21:51:03.370275919 -0700
@@ -201,6 +201,15 @@
 #  endif
 #endif
 
+#if defined(XP_LINUX) && !defined(__GLIBC__)
+  // For musl, load gcompat before loading plugins possibly distributed as
+  // glibc-linked binaries. Ignore failure to load.
+  PRLibSpec gcompat_libSpec;
+  gcompat_libSpec.type = PR_LibSpec_Pathname;
+  gcompat_libSpec.value.pathname = "libgcompat.so.0";
+  PR_LoadLibraryWithFlags(gcompat_libSpec, PR_LD_LAZY | PR_LD_GLOBAL);
+#endif
+
   if (!getenv("MOZ_DISABLE_GMP_SANDBOX") && mSandboxStarter &&
       !mSandboxStarter->Start(aUTF8LibPath)) {
     MOZ_CRASH("Cannot start sandbox!");
@@ -278,6 +287,20 @@
   }
   bool Start(const char* aLibPath) override {
     RegisterProfilerObserversForSandboxProfiler();
+
+#ifndef __GLIBC__
+    // For libcs other than glibc, ensure that the emulation of the glibc
+    // dynamic linker is already loaded so that the plugin does not attempt to
+    // load it later. Ignore failure to load.
+#if defined(__i386__)
+    PR_LoadLibrary("ld-linux.so.2");
+#elif defined(__x86_64__)
+    PR_LoadLibrary("ld-linux-x86-64.so.2");
+#elif defined(__aarch64__)
+    PR_LoadLibrary("ld-linux-aarch64.so.2");
+#endif
+#endif
+
     mozilla::SetMediaPluginSandbox(aLibPath);
     return true;
   }
