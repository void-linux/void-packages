From a68d2f37b6158abb70511e31a563043430666ed5 Mon Sep 17 00:00:00 2001
From: "G. Pape" <pape@smarden.org>
Date: Sat, 12 Sep 2026 09:49:13 +0200
Subject: [PATCH] src: svlogd: zero-initialize allocated logdir array

Closes #52
---
 package/CHANGES | 1 +
 src/svlogd.c    | 2 +-
 src/svlogd.dist | 2 +-
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/svlogd.c b/src/svlogd.c
index f4f0f66..7688490 100644
--- a/src/svlogd.c
+++ b/src/svlogd.c
@@ -719,11 +719,11 @@ int main(int argc, char **argv) {
   coe(fdwdir);
   dir =(struct logdir*)alloc(dirn *sizeof(struct logdir));
   if (! dir) die_nomem();
+  byte_zero((char *)dir, dirn *sizeof(struct logdir));
   for (i =0; i < dirn; ++i) {
     dir[i].fddir =-1; dir[i].fdcur =-1;
     dir[i].btmp =(char*)alloc(buflen *sizeof(char));
     if (! dir[i].btmp) die_nomem();
-    dir[i].ppid =0;
   }
   databuf =(char*)alloc(buflen *sizeof(char));
   if (! databuf) die_nomem();
