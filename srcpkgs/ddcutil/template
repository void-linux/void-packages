# Template file for 'ddcutil'
pkgname=ddcutil
version=3.0.2
revision=1
build_style=gnu-configure
configure_args="--libdir=/usr/lib"
hostmakedepends="automake libtool pkg-config"
makedepends="libdrm-devel libgudev-devel libkmod-devel libusb-devel
 libXrandr-devel jansson-devel acl-devel dbus-devel"
short_desc="Query and change monitor settings using DDC/CI and USB"
maintainer="lemmi <lemmi@nerd2nerd.org>"
license="GPL-2.0-or-later"
homepage="https://www.ddcutil.com"
changelog="https://www.ddcutil.com/release_notes_220/"
distfiles="https://github.com/rockowitz/ddcutil/archive/v${version}.tar.gz"
checksum=d6b2a42378233aaff6188a0a5ff9fa0e959cb95742367e2cdfa2c6a023c7fe26

if [ "${XBPS_TARGET_LIBC}" = "musl" ]; then
	makedepends+=" libexecinfo-devel musl-legacy-compat"
	LDFLAGS="-lexecinfo"
fi

pre_configure() {
	NOCONFIGURE=1 ./autogen.sh
}

ddcutil-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
