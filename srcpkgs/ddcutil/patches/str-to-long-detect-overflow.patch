From 51a43c678e2f71d38d1d2ff99103073def4d170e Mon Sep 17 00:00:00 2001
From: "Barak A. Pearlmutter" <bap@debian.org>
Date: Sat, 10 Oct 2026 17:00:00 +0100
Subject: [PATCH] str_to_long(): reject out-of-range values

strtol() saturates to LONG_MIN/LONG_MAX and sets errno to ERANGE on
overflow, which str_to_long() did not check.  On 32-bit architectures,
where long and int are the same width, str_to_int() therefore accepted
e.g. "9999999999" as INT_MAX, failing the test_string_util unit test.

Forwarded: no
Last-Update: 2026-10-10

Gbp-Pq: Name str-to-long-detect-overflow.patch
---
 src/util/string_util.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/util/string_util.c b/src/util/string_util.c
index 984311e3c..0ef44f0d2 100644
--- a/src/util/string_util.c
+++ b/src/util/string_util.c
@@ -1127,10 +1127,11 @@ bool str_to_long(const char * sval, long * p_ival, int base)
             printf("(%s) work = %s\n", __func__, work);
 
          if (has_digits) {
+            errno = 0;
             long result = strtol(work, &endptr, base); // allow hex
             // printf("(%s) sval=%p, endptr=%p, *endptr=|%c| (0x%02x), result=%ld\n",
             //        __func__, sval, endptr, *endptr, *endptr, result);
-            if (*endptr == '\0') {
+            if (*endptr == '\0' && errno != ERANGE) {
                *p_ival = result;
                ok = true;
             }
