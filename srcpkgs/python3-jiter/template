# Template file for 'python3-jiter'
pkgname=python3-jiter
version=0.17.0
revision=1
build_style=python3-pep517
build_helper="rust"
make_check_target="crates/jiter-python/tests"
hostmakedepends="maturin cargo"
makedepends="rust-std python3-devel"
checkdepends="python3-pytest python3-dirty-equals"
short_desc="Fast iterable JSON parser, used in pydantic-core"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://github.com/pydantic/jiter"
changelog="https://github.com/pydantic/jiter/releases"
distfiles="${PYPI_SITE}/j/jiter/jiter-${version}.tar.gz"
checksum=03e432f226a453851079fb84cd17c6da9991eab723e28d716f14ae3d906e0c12

do_build() {
	maturin build -i /usr/bin/python3 -o . \
		--release --target "${RUST_TARGET}" --manylinux off \
		--manifest-path crates/jiter-python/Cargo.toml
	mkdir -p dist
	mv jiter-${version}-*.whl dist/jiter-${version}-py3-none-any.whl
}

post_install() {
	vlicense LICENSE
}
