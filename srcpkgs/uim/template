# Template file for 'uim'
pkgname=uim
version=2.0.0
revision=1
build_style=meson
build_helper="qemu"
configure_args="-Danthy_utf8=enabled -Ddict=enabled
 -Demacs=enabled -Dexpat=enabled -Dfep=enabled -Dffi=enabled
 -Dgtk3=enabled -Dgtk4=enabled -Dlibedit=enabled -Dlibnotify=enabled
 -Dm17nlib=enabled -Dmozc=enabled -Dpref=enabled -Dsqlite3=enabled
 -Dskk=true -Dwayland=enabled -Dx11=enabled -Dxim=enabled"
hostmakedepends="pkg-config gettext protobuf wayland-devel openssl m17n-db"
makedepends="libglib-devel gtk+3-devel gtk4-devel ibus-devel
 ncurses-devel libvterm-devel libgcroots-devel
 libnotify-devel libedit-devel expat-devel libffi-devel
 openssl-devel sqlite-devel libeb-devel
 anthy-unicode-devel m17n-lib-devel
 libX11-devel libXft-devel protobuf-devel
 wayland-devel wayland-protocols cairo-devel"
checkdepends="emacs"
short_desc="Multilingual input method library and environment"
maintainer="Kazuho Sakoda <hyonhyoro.kazuho@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/uim/uim/wiki"
distfiles="https://github.com/uim/uim/releases/download/${version}/uim-${version}.tar.bz2"
checksum=a48d0019668e94463bf06b46f6130ddd8caebe62ce03985debb638b928eba50e

subpackages="uim-fep uim-gtk3 uim-gtk4 uim-wayland uim-xkb
 uim-anthy uim-m17n uim-mozc uim-skk uim-devel ibus-uim"

if [ "$XBPS_TARGET_WORDSIZE" = 32 ]; then
	broken="tutcode: fixnum overflow"
fi

post_install() {
	vlicense COPYING
}

uim-fep_package() {
	short_desc+=" - Front End Processer"
	pkg_install() {
		vmove usr/bin/uim-fep*
		vmove usr/lib/uim/plugin/libuim-editline.so
	}
}

uim-gtk4_package() {
	short_desc+=" - GTK4 IM module"
	pkg_install() {
		vmove usr/lib/gtk-4.0
	}
}

uim-gtk3_package() {
	short_desc+=" - GTK3 IM module"
	pkg_install() {
		vmove "usr/bin/uim-*-gtk3"
		vmove usr/bin/uim-toolbar-gtk3-systray
		vmove "usr/libexec/uim-*-gtk3"
		vmove usr/lib/gtk-3.0
	}
}

uim-wayland_package() {
	short_desc+=" - Wayland"
	pkg_install() {
		vmove usr/bin/uim-wayland
	}
}

uim-xkb_package() {
	short_desc+=" - X11 IM Module"
	pkg_install() {
		vmove usr/bin/uim-xim
		vmove usr/lib/uim/plugin/libuim-xkb.so
	}
}

uim-qt_package() {
	short_desc+=" - Qt5 IM module"
	pkg_install() {
		vmove "usr/bin/uim-*-qt5"
		vmove usr/libexec/uim-candwin-qt5
		vmove usr/lib/qt5
	}
}

uim-qt6_package() {
	short_desc+=" - Qt6 IM module"
	pkg_install() {
		vmove "usr/bin/uim-*-qt6"
		vmove usr/libexec/uim-candwin-qt6
		vmove usr/lib/qt6
	}
}

uim-anthy_package() {
	short_desc+=" - Anthy IME"
	pkg_install() {
		vmove "usr/lib/uim/plugin/libuim-anthy*.so"
		vmove "usr/share/uim/anthy*.scm"
		vmove "usr/share/uim/pixmaps/anthy*.png"
		vdoc "${FILESDIR}/README.voidlinux"
	}
}

uim-m17n_package() {
	short_desc+=" - m17n"
	pkg_install() {
		vmove usr/lib/uim/plugin/libuim-m17nlib.so
		vmove "usr/share/uim/m17n*.scm"
		vmove "usr/share/uim/pixmaps/m17n*.png"
	}
}

uim-mozc_package() {
	short_desc+=" - mozc"
	pkg_install() {
		vmove usr/bin/uim-mozc-helper
		vmove "usr/share/uim/mozc*.scm"
	}
}

uim-skk_package() {
	short_desc+=" - SKK IME"
	pkg_install() {
		vmove usr/lib/uim/plugin/libuim-skk.so
		vmove "usr/share/uim/skk*.scm"
		vmove "usr/share/uim/pixmaps/skk*"
	}
}

ibus-uim_package() {
	short_desc+=" - IBus"
	pkg_install() {
		vmove usr/libexec/ibus-engine-uim
		vmove usr/share/ibus
	}
}

uim-devel_package() {
	depends="uim-${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
