# Template file for 'plantuml'
pkgname=plantuml
reverts="8047_1 8053_1 8059_1"
version=1.2026.6
revision=1
hostmakedepends="gradle openjdk21"
depends="virtual?java-environment graphviz"
short_desc="Create UML diagrams from a plain text language"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="http://plantuml.com/"
distfiles="https://github.com/plantuml/plantuml/archive/v${version}.tar.gz"
checksum=323ca8a555cd14c1e1d439f314cda8796ddeca663f533ea0068a9d05cc0c0b84

do_build() {
	gradle --no-daemon jar --exclude-task test
	echo "#!/bin/sh" > plantuml
	echo "java -jar /usr/share/java/${pkgname}-${version}.jar \$@" >> plantuml
	chmod 755 plantuml
}

do_install() {
	vbin plantuml
	vinstall build/libs/plantuml-${version}.jar 644 usr/share/java ${pkgname}-${version}.jar
}
