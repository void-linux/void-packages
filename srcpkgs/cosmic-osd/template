# Template file for 'cosmic-osd'
pkgname=cosmic-osd
version=1.4.0
revision=1
archs="x86_64* i686"
build_style=cargo
configure_args="--all"
hostmakedepends="pkg-config"
makedepends="libxkbcommon-devel pulseaudio-devel pipewire-devel clang22-devel eudev-libudev-devel libinput-devel just"
depends="dbus-libs eudev-libudev lame libpulseaudio libxkbcommon libpulseaudio libsndfile libxcb libasyncns libflac libvorbis libogg libmpg123 libXau libXdmcp opus"
short_desc="COSMIC OSD"
maintainer="Bella109 <belladev109@proton.me>"
license="GPL-3.0-only"
homepage="https://github.com/pop-os/cosmic-osd"
distfiles="https://github.com/pop-os/cosmic-osd/archive/refs/tags/epoch-${version}.tar.gz"
checksum=5ea21a076bc177fba888b2a5eb4e70d7524b4db0351a6e99d6d9bee4222267b2

# Void installs polkit's helper at /usr/lib/polkit-1/, but cosmic-osd's
# fallback (used since there's no systemd socket activation) is hardcoded
# to /usr/libexec/polkit-agent-helper-1 via option_env!, which breaks
# authentication. Point it at the real path, same pattern as GEOCLUE_AGENT
# in cosmic-settings-daemon.
export POLKIT_AGENT_HELPER_1="/usr/lib/polkit-1/polkit-agent-helper-1"

do_install() {
	just rootdir="${DESTDIR}" cargo-target-dir="target/${RUST_TARGET}" install
}
