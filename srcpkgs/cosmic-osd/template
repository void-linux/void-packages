# Template file for 'cosmic-osd'
pkgname=cosmic-osd
version=1.3.0
revision=2
archs="x86_64* i686"
build_style=cargo
configure_args="--all"
hostmakedepends="pkg-config"
makedepends="libxkbcommon-devel pulseaudio-devel pipewire-devel clang22-devel eudev-libudev-devel libinput-devel just"
depends="dbus-libs eudev-libudev lame libpulseaudio libxkbcommon libpulseaudio libsndfile libxcb libasyncns libflac libvorbis libogg libmpg123 libXau libXdmcp opus"
short_desc="COSMIC OSD"
maintainer="Bella109 <belladev109@proton.me>"
