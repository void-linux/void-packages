# Template file for 'haveged'
pkgname=haveged
version=1.9.26
revision=1
build_style=gnu-configure
short_desc="Entropy harvesting daemon using CPU timings"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://www.issihosts.com/haveged"
changelog="https://raw.githubusercontent.com/jirka-h/haveged/refs/heads/master/ChangeLog"
distfiles="https://github.com/jirka-h/haveged/archive/refs/tags/v${version}.tar.gz"
checksum=74bc6052506451ca9f23ba186f72cf81b124f859351f8a4b777ead32d9bdd4da

post_install() {
	vsv $pkgname
}

libhaveged_package() {
	short_desc+=" - runtime library"
	pkg_install() {
		vmove usr/lib/*.so.*
	}
}

libhaveged-devel_package() {
	short_desc+=" - development files"
	depends="libhaveged-${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/*.a
		vmove usr/lib/*.so
		vmove usr/share/man/man3
	}
}
