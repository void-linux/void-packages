# Template file for 'kf6-kcompletion'
# group=kde-frameworks
pkgname=kf6-kcompletion
version=6.30.0
revision=1
build_style=cmake
hostmakedepends="extra-cmake-modules qt6-tools qt6-base kf6-kconfig"
makedepends="kf6-kcodecs-devel kf6-kconfig-devel kf6-kwidgetsaddons-devel"
short_desc="KDE completion framework"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kcompletion"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=96ad9c429ca53b830359c45614ca4c32ed6b759f3023f1b3db1650ba1c19bd58

# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version%.*}"

kf6-kcompletion-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
