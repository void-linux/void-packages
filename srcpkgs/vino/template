# Template file for 'vino'
pkgname=vino
version=3.22.0
revision=3
build_style=gnu-configure
configure_args="
 ac_cv_path_INTLTOOL_UPDATE=/usr/bin/false
 ac_cv_path_INTLTOOL_MERGE=/usr/bin/false
 ac_cv_path_INTLTOOL_EXTRACT=/usr/bin/false
 ac_cv_path_INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="pkg-config gettext glib-devel"
makedepends="libjpeg-turbo-devel gtk+3-devel
 libnotify-devel avahi-glib-libs-devel dbus-glib-devel telepathy-glib-devel
 libXtst-devel NetworkManager-devel libsecret-devel gnutls-devel libSM-devel"
depends="desktop-file-utils"
short_desc="VNC server for the GNOME desktop"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-only"
homepage="https://wiki.gnome.org/action/show/Projects/Vino"
distfiles="${GNOME_SITE}/$pkgname/${version%.*}/$pkgname-$version.tar.xz"
checksum=2911c779b6a2c46e5bc8e5a0c94c2a4d5bd4a1ee7e35f2818702cb13d9d23bab

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
	makedepends+=" musl-legacy-compat"
fi

post_patch() {
	vsed -i configure -e '/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.50.1/'
	vsed -i server/vino-server.desktop.in.in -e 's/^_//'
}

post_configure() {
	make server/vino-server.desktop.in
	msgfmt --desktop --template server/vino-server.desktop.in \
		-d po -o server/vino-server.desktop
}
