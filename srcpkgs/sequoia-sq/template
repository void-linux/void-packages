# Template file for 'sequoia-sq'
pkgname=sequoia-sq
version=1.5.0
revision=1
build_style=cargo
build_helper=qemu
_llvm_ver=23
configure_args="--no-default-features --features crypto-openssl"
make_install_args="--path tool"
_deps="openssl-devel sqlite-devel libclang${_llvm_ver}"
hostmakedepends="pkg-config llvm${_llvm_ver} clang${_llvm_ver} ${_deps} capnproto"
makedepends="${_deps} capnproto-devel"
depends="sequoia-keystore"
short_desc="Command-line frontend for Sequoia, a new OpenPGP implementation"
maintainer="classabbyamp <void@placeviolette.net>"
license="GPL-2.0-or-later"
homepage="https://sequoia-pgp.org/projects/#sq"
changelog="https://gitlab.com/sequoia-pgp/sequoia-sq/-/raw/main/NEWS"
distfiles="https://gitlab.com/sequoia-pgp/sequoia-sq/-/archive/sequoia-sq/v${version}/sequoia-sq-sequoia-sq-v${version}.tar.gz"
checksum=13552acc38ffa7c362123be3203c956bb20e34ddfd8a53fa1503fa53af1ff456
conflicts="squirrel"

post_patch() {
	# https://github.com/rust-lang/cc-rs/issues/1469
	cargo update --package rusqlite:0.40.2 --precise 0.37.0
	cargo update --package cc:1.6.0 --precise 1.2.14
}

pre_build() {
	export ASSET_OUT_DIR=assets
}

post_install() {
	for page in tool/assets/man-pages/*.?; do
		vman ${page}
	done
	vcompletion tool/assets/shell-completions/sq.bash bash sq
	vcompletion tool/assets/shell-completions/sq.fish fish sq
	vcompletion tool/assets/shell-completions/_sq zsh sq
}
