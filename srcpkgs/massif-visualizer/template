# kgraphviewer is currently not compiled for ARM
# so we are only assking graphing functionaly to x86
if [[ "$XBPS_TARGET_MACHINE" == *"x86_64"* ||  "$XBPS_TARGET_MACHINE" == *"i686"* ]]; then
	makedepends+=" kgraphviewer-devel kparts-devel"
	depends="graphviz"
fi
