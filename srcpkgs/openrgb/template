# Template file for 'openrgb'
pkgname=openrgb
version=1.0rc3
revision=1
build_style=qmake
hostmakedepends="qt5-qmake qt5-host-tools git pkg-config"
makedepends="qt5-devel libusb-devel hidapi-devel mbedtls-devel"
short_desc="Open source RGB lighting control"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-only"
homepage="https://gitlab.com/CalcProgrammer1/OpenRGB"
distfiles="https://gitlab.com/CalcProgrammer1/OpenRGB/-/archive/release_candidate_${version}/OpenRGB-release_candidate_${version}.tar.gz"
checksum=a7bfd20b4804f2c5e39f59d21d8ff69d71f4f76f2a82c030e5fe1cec040d81aa

post_install() {
	vdoc README.md
	vinstall ${FILESDIR}/openrgb.conf 644 usr/lib/modules-load.d
	vsv openrgb
	vdoc "${FILESDIR}/README.voidlinux"

	# Void uses the packaged runit service instead.
	rm -f "${DESTDIR}/usr/lib/systemd/system/openrgb.service"
}
