From 78c112403b9426ef6a8f0e904857119147da0546 Mon Sep 17 00:00:00 2001
From: lprnmns <manasalperen@gmail.com>
Date: Tue, 15 Sep 2026 09:11:58 +0300
Subject: [PATCH 1/2] Test final symlink refusal by errno

---
 tests/test_filelock.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tests/test_filelock.py b/tests/test_filelock.py
index d98eac3e..16fe7343 100644
--- a/tests/test_filelock.py
+++ b/tests/test_filelock.py
@@ -1,5 +1,6 @@
 from __future__ import annotations
 
+import errno
 import inspect
 import logging
 import os
@@ -2042,7 +2043,7 @@ def test_final_symlink_backend_refuses_to_lock(tmp_path: Path) -> None:
     (tmp_path / "link").symlink_to(tmp_path / "target")
     # Keeping the final symlink a distinct key is safe because the backend still refuses to lock through it. O_NOFOLLOW
     # reports the refusal as ELOOP on Linux and macOS, and as EFTYPE ("inappropriate file type") on NetBSD.
-    with pytest.raises(OSError, match=r"Too many levels of symbolic links|symbolic link|Inappropriate file type"):
+    with pytest.raises(OSError, check=lambda error: error.errno in {errno.ELOOP, getattr(errno, "EFTYPE", None)}):
         FileLock(str(tmp_path / "link")).acquire()
 
 

