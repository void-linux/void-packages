# Template file for 'dwl'
pkgname=dwl
version=0.9
revision=1
build_style=gnu-makefile
hostmakedepends="pkg-config wayland-protocols xorg-server-xwayland wayland-devel"
makedepends="libinput-devel wlroots-devel libxkbcommon-devel xcb-util-wm-devel"
depends="xorg-server-xwayland"
short_desc="Simple, hackable dynamic tiling Wayland compositor"
maintainer="elbachir-one <bachiralfa@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://codeberg.org/dwl/dwl"
changelog="https://codeberg.org/dwl/dwl/raw/branch/main/CHANGELOG.md"
distfiles="https://codeberg.org/dwl/dwl/releases/download/v${version}/dwl-v${version}.tar.gz"
checksum=51ed5da49942ca3272b6f2c4f1d7641b0b947a6eb1c264dce8a65b4d245596af

make_build_args="XWAYLAND=-DXWAYLAND"
make_install_args="PREFIX=/usr"

post_extract() {
	if [ -s "${XBPS_SRCDIR}/config.h" ]; then
		cp "${XBPS_SRCDIR}/config.h" .
	fi
}
