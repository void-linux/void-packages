 859964eb00478a4730844c68106f5aed602d1e5d8de96bfa42cca62aadee012f"

distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz>ripes-${version}.tar.gz"

for _e in ${_submodules}; do
	_url=${_e#*|}; _url=${_url%|*}
	_commit=${_e##*|}
	_file="${_url##*/}-${_commit}.tar.gz"
	distfiles+=" ${_url}/archive/${_commit}.tar.gz>${_file}"
	skip_extraction+=" ${_file}"
done

post_extract() {
	local _e _path _url _commit
	for _e in ${_submodules}; do
		_path=${_e%%|*}
		_url=${_e#*|};
		_url=${_url%|*}
		_commit=${_e##*|}
		mkdir -p "${_path}"
		vsrcextract -C "${_path}" "${_url##*/}-${_commit}.tar.gz"
	done
}

post_patch() {
	# upstream overwrites CMAKE_CXX_FLAGS, dropping the distro's CXXFLAGS
	vsed -i CMakeLists.txt \
		-e 's/set(CMAKE_CXX_FLAGS "-Wextra/set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wextra/'
}


post_install() {
	vlicense LICENSE
}
