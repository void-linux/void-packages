# Template file for 'ripes'
pkgname=ripes
version=2.2.6
revision=1
build_style=cmake
hostmakedepends="qt5-core"
makedepends="qt5-svg-devel qt5-charts-devel"
short_desc="Graphical processor simulator and assembly editor for RISC-V"
maintainer="Marcos Vega<marcosmola2@gmail.com>"
license="MIT"
homepage="https://github.com/mortbopet/Ripes"
make_check=no # upstream tests are opt-in (RIPES_BUILD_TESTS) and not run here

_submodules="
external/ELFIO|https://github.com/serge1/ELFIO|79fcd11595d0793dec593e9072e36c7923c57c1a
external/VSRTL|https://github.com/mortbopet/VSRTL|8fd0bce6f5fcf27b89b33cf995b0428b8436ccdf
external/VSRTL/external/Signals|https://github.com/pbhogan/Signals|17881fb92ec314bb43549cc2cc8acfac24916f91
external/VSRTL/external/better-enums|https://github.com/mortbopet/better-enums|52a694bcb8c212ab2ffcd085ea71d9494a537294
external/VSRTL/external/cereal|https://github.com/USCiLab/cereal|51cbda5f30e56c801c07fe3d3aba5d7fb9e6cca4
external/libelfin|https://github.com/mortbopet/libelfin|49d16531a11f5f288e77795a5c6bdd75b46657f7
external/libelfin/external/cpp-mmaplib|https://github.com/yhirose/cpp-mmaplib|c517af7593b81dd6e2b84ee8b846df8c5a445860
"

checksum="5620b026fc5fb6c136732b67d01caabad53c41029258f54517377b08fb9b8c8e
 5a42507e1bec735feb83709fbbab83b35de8d6d591a7a317b25c438cbd34c19b
 7e9babd60d916b8dc5ae93396e912977c6a0841817fdcfe2d5ec300cccc70714
 6510ed0671fedd70e373e2fafc14e428b6f02627d4c5ad6c6bda06da55a10237
