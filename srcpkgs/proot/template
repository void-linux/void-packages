# Template file for 'proot'
pkgname=proot
version=5.5.0
revision=1
archs="x86_64* i686* aarch64* arm*"
build_wrksrc=src
build_style=gnu-makefile
make_use_env=yes
make_build_args="VERSION=${version} WITHOUT_PYTHON=$(vopt_if python 0 1)"
make_check_args="-C ../test"
make_check_target=" "
make_install_args="PREFIX='/usr'"
hostmakedepends="pkg-config python3-docutils python3-lxml"
makedepends="libarchive-devel talloc-devel $(vopt_if care uthash) $(vopt_if python python3-devel) $(vopt_if python swig)"
checkdepends="which"
short_desc="User-space implementation of chroot, mount --bind, and binfmt_misc"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="https://proot-me.github.io"
distfiles="https://github.com/proot-me/PRoot/archive/refs/tags/v${version}.tar.gz"
checksum=287cfb27f58e100b0153006cb352268225bb9ad9d41d9b52ed56d01a22c13e6f
make_install_targets="install $(vopt_if care install_care)"
build_options="care python"

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
	makedepends+=" musl-legacy-compat"

	# The follwing tests are failing:
	# test-brk-syscall
	# test-rlimit-stack-brk
	# test-fake-id-auxv-chroot
	# test-shebang-length-limit
	make_check=no
fi

do_build() {
	: ${make_cmd:=make}
	export PREFIX=/usr prefix=/usr
	# do make in two steps as suggested in the Readme
	# first build the config and loader
	if ${make_cmd} ${make_build_args} -q loader-m32.elf; then
			:
		else
			if [ $? -eq 2 ]; then
				${make_cmd} ${makejobs} ${make_build_args} loader.elf build.h
			else
				${make_cmd} ${makejobs} ${make_build_args} loader.elf loader-m32.elf build.h
		fi
	fi
	# then compile PRoot and CARE
	${make_cmd} ${makejobs} ${make_build_args} proot $(vopt_if care care)
	${make_cmd} -C ../doc proot/man.1
}

post_install() {
	vman ../doc/proot/man.1 proot.1
}
