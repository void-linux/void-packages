# Template file for 'godots'
pkgname=godots
version=1.4.2
revision=1
archs="x86_64* i686* aarch64* armv7* ppc64*"
hostmakedepends="godot godot-export-templates"
depends="libglvnd libX11 libXcursor libXext libXi libXinerama libXrandr libXrender unzip"
short_desc="Hub for managing your Godot versions and projects"
maintainer="Aryo Nazaradeh <aryo.nazaradeh@gmail.com>"
license="MIT"
homepage="https://github.com/MakovWait/godots"
changelog="https://github.com/MakovWait/godots/releases"
distfiles="https://github.com/MakovWait/godots/archive/refs/tags/v${version}.stable.tar.gz"
checksum=e7d49fe689770b69240d9b85f05b1fd81598f654fc49c31c972ef6720dee29df
nocross=https://build.voidlinux.org/builders/armv7l_builder/builds/6342/steps/shell_3/logs/stdio

case "$XBPS_TARGET_MACHINE" in
	x86_64*) arch=x86_64 ;;
	i686*) arch=x86_32 ;;
	aarch64*) arch=arm64 ;;
	armv7*) arch=arm32 ;;
	ppc64*) arch=ppc64 ;;
esac

do_build() {
	mkdir -p ${wrksrc}/data/godot
	ln -sfn /usr/lib/godot/export_templates ${wrksrc}/data/godot/export_templates
	cd ${wrksrc}
	mkdir -p build
	rm -rf tests
	vsed -i export_presets.cfg \
		-e "s/binary_format\/architecture=\"[^\"]*\"/binary_format\/architecture=\"${arch}\"/"
	XDG_DATA_HOME=${wrksrc}/data godot --headless --export-release "Linux/X11" build/godots
}

do_install() {
	vbin ${wrksrc}/build/godots
	vinstall icon.svg 644 usr/share/pixmaps godots.svg
	vinstall packaging/linux/io.github.MakovWait.Godots.desktop 644 \
		usr/share/applications/io.github.MakovWait.Godots.desktop
}

post_install() {
	vlicense LICENSE
}
