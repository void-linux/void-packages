# Template file for 'python3-pip'
pkgname=python3-pip
version=26.3
revision=1
build_style=python3-pep517
hostmakedepends="python3-flit_core"
depends="python3 ca-certificates"
short_desc="PyPA recommended tool for installing PyPI packages (Python3)"
maintainer="Andrew J. Hesford <ajh@sideband.org>"
license="MIT"
homepage="https://pip.pypa.io/"
changelog="https://raw.githubusercontent.com/pypa/pip/master/NEWS.rst"
distfiles="${PYPI_SITE}/p/pip/pip-${version}.tar.gz"
checksum=6c36ae7da8695be67e3cd9f7d87919667ced53f57ce2ede75d89b5912ed2bc4c
# Tests have unpackaged dependencies
make_check=no

post_extract() {
	rm src/pip/_vendor/certifi/cacert.pem
}

post_install() {
	vlicense LICENSE.txt

	rm "${DESTDIR}/usr/bin/pip"
	ln -s pip3 "${DESTDIR}/usr/bin/pip"
}
