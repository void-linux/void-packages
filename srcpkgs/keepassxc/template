# Template file for 'keepassxc'
pkgname=keepassxc
version=2.8.0
revision=1
build_style=cmake
build_helper=qemu
configure_args="
 -DKPXC_FEATURE_DOCS=ON
 -DKPXC_FEATURE_UPDATES=OFF
 -DKPXC_MINIMAL=OFF
 -DKPXC_FEATURE_BROWSER=$(vopt_if browser ON OFF)
 -DKPXC_FEATURE_FDOSECRETS=$(vopt_if fdosecrets ON OFF)
 -DKPXC_FEATURE_NETWORK=$(vopt_if network ON OFF)
 -DKPXC_FEATURE_SSHAGENT=$(vopt_if sshagent ON OFF)
"
hostmakedepends="qt6-base qt6-tools ruby-asciidoctor pkg-config"
makedepends="qt6-svg-devel botan-devel libargon2-devel qrencode-devel
 readline-devel pcsclite-devel libusb-devel keyutils-devel minizip-devel
 libXtst-devel libXi-devel"
checkdepends="xvfb-run"
short_desc="KeePassXC is a cross-platform port of “Keepass Password Safe”"
maintainer="Piraty <mail@piraty.dev>"
license="GPL-3.0-or-later, BSD-3-Clause, CC0-1.0, LGPL-2.0-only, LGPL-2.1-only,
 LGPL-3.0-or-later, Nokia-Qt-exception-1.1, MIT, BSL-1.0"
homepage="https://keepassxc.org/"
changelog="https://raw.githubusercontent.com/keepassxreboot/keepassxc/${version}/CHANGELOG.md"
distfiles="https://github.com/keepassxreboot/keepassxc/releases/download/${version}/keepassxc-${version}-src.tar.xz"
checksum=4ed4b77d375f021fc04648c257fedfb41dc13c6bd5c4965d8ded31284c9c653c

build_options="browser fdosecrets network sshagent"
desc_option_browser="Include browser integration with keepassxc-browser-plugin"
desc_option_fdosecrets="Include Secret Storage Spec server side API"
desc_option_network="Include networking code (favicon download)"
desc_option_sshagent="Include SSH agent support"
build_options_default="browser fdosecrets network sshagent"

if [ "$XBPS_CHECK_PKGS" ]; then
	configure_args+=" -DWITH_TESTS=ON"
else
	configure_args+=" -DWITH_TESTS=OFF"
fi

post_install() {
	vlicense COPYING
	vlicense LICENSE.BSD
	vlicense LICENSE.MIT
}

do_check() {
	xvfb-run ninja -C build test || : #XXX: TestCli::testClip() fails
}
