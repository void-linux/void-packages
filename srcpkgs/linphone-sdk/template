# Template file for 'linphone-sdk'
pkgname=linphone-sdk
version=5.5.15
revision=1
_bcmatroska2_commit=ca080c1689a3bfebe6b71c69444b94b0dba8e54a
_bcg729_commit=8bec1e5fc072f3669e435edd137eb3da6da2eef7
build_style=cmake
# disable unit tests, belle-sip requires another submodule for tests
configure_args="-DENABLE_TESTS=ON -DENABLE_UNIT_TESTS=OFF -DBUILD_SHARED_LIBS=ON
 -DLINPHONESDK_VERSION=${version} -DLINPHONESDK_PACKAGER=void -DENABLE_STRICT=OFF
 -DENABLE_GPL_THIRD_PARTIES=ON -DENABLE_CONSOLE_UI=ON -DENABLE_QT_GL=ON
 -DENABLE_CXX_WRAPPER=ON
 -DBUILD_AOM=OFF -DBUILD_FFMPEG=OFF -DBUILD_CODEC2=OFF -DBUILD_DAV1D=OFF
 -DBUILD_JSONCPP=OFF -DBUILD_LIBJPEGTURBO=OFF -DBUILD_HIDAPI=OFF -DBUILD_LIBVPX=OFF
 -DBUILD_MBEDTLS=OFF -DBUILD_GSM=OFF -DBUILD_ZXINGCPP=OFF -DBUILD_SPEEX=OFF
 -DBUILD_RNNOISE=OFF -DBUILD_OPUS=OFF -DBUILD_LIBYUV=OFF -DBUILD_XERCESC=OFF
 -DBUILD_XERCESC=OFF -DBUILD_ZLIB=OFF -DBUILD_DECAF=OFF -DBUILD_LIBXML2=OFF
 -DBUILD_LIBSRTP2=OFF -DBUILD_SQLITE3=OFF -DBUILD_SOCI=OFF -DBUILD_BV16=OFF
 -DENABLE_G729=ON"
hostmakedepends="doxygen python3-pystache python3-six yasm perl pkg-config
 qt6-base meson" # Meson is never used
makedepends="mbedtls-devel libaom-devel ffmpeg6-devel libdav1d-devel
 jsoncpp-devel libjpeg-turbo-devel hidapi-devel libvpx-devel libgsm-devel
 sqlite-devel libsrtp-devel opus-devel speex-devel speexdsp-devel zlib-devel
 rnnoise-devel alsa-lib-devel v4l-utils-devel zxing-cpp-devel libyuv-devel
 soci-devel libxerces-c-devel libxml2-devel libXinerama-devel
 qt6-base-devel qt6-declarative-devel glew-devel"
# bv16-devel
depends="bctoolbox-devel bcmatroska2-devel bcg729-devel bcunit-devel
 belcard-devel belle-sip-devel belr-devel bzrtp-devel lime-devel
 mediastreamer-devel ortp-devel linphone-devel"
short_desc="Linphone SDK"
maintainer="John <me@johnnynator.dev>"
license="AGPL-3.0-only AND GPL-3.0-only"
homepage="https://www.linphone.org/en/liblinphone-voip-sdk"
distfiles="https://github.com/BelledonneCommunications/linphone-sdk/archive/refs/tags/${version}.tar.gz
 https://github.com/BelledonneCommunications/bcg729/archive/${_bcg729_commit}.tar.gz
 https://github.com/BelledonneCommunications/bcmatroska2/archive/${_bcmatroska2_commit}.tar.gz"
checksum="c6937bd99e5384efb010ffa980f439bd213029cf743ba57e482c419ce464572a
 62812779c776620f8fa005fc7c6ae14039d7b2efce66cf9af69c426393b5d062
 a21f84c4ae736cf59d50e5f8ee34083b97ed852c51083608314f4c1e5f7d1541"
skip_extraction="${_bcmatroska2_commit}.tar.gz ${_bcg729_commit}.tar.gz"

# Test components in bctoolbox require mallinfo()
configure_args+=" -DENABLE_TESTS_COMPONENT=FALSE"
# Prevent passing char** as const to iconv in charconvert_linux.c
configure_args+=" -DCMAKE_C_FLAGS=-DICONV_CONST=\"\""

post_extract() {
	vsrcextract -C bcmatroska2 ${_bcmatroska2_commit}.tar.gz
	vsrcextract -C bcg729 ${_bcg729_commit}.tar.gz
}

post_install() {
	vlicense LICENSE.txt
	rm -rf "${DESTDIR}/usr/include/OpenGL"
	rm -f "${DESTDIR}/usr/share/linphone/rootca.pem"
	ln -sf ../../../etc/ssl/certs.pem ${DESTDIR}/usr/share/linphone/rootca.pem
}

bctoolbox_package() {
	short_desc="Library to create and run audio and video streams"
	pkg_install() {
		vmove usr/lib/libbctoolbox.so.*
	}
}
bctoolbox-devel_package() {
	depends="bctoolbox>=${version}_${revision}"
	short_desc="Library to create and run audio and video streams - development files"
	pkg_install() {
		vmove usr/include/bctoolbox
		vmove usr/lib/cmake/BCToolbox
		vmove usr/lib/libbctoolbox.so
		vmove usr/lib/pkgconfig/bctoolbox.pc
	}
}
