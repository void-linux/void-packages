linphone_package() {
	short_desc="Voice-over-IP phone library"
	pkg_install() {
		vmove usr/share/sounds/linphone
		vmove usr/share/linphone
		vmove "usr/lib/liblinphone.so.*"
		vmove "usr/lib/liblinphone++.so.*"
		vmove usr/share/belr/grammars/cpim_grammar.belr
		vmove usr/share/belr/grammars/ics_grammar.belr
		vmove usr/share/belr/grammars/identity_grammar.belr
		vmove usr/share/belr/grammars/mwi_grammar.belr
		vmkdir usr/lib/liblinphone/plugins
		touch ${PKGDESTDIR}/usr/lib/liblinphone/plugins/.dummy
	}
}
linphone-daemon_package() {
	short_desc="Voice-over-IP phone - daemon"
	pkg_install() {
		vmove usr/bin/linphone-daemon
	}
}

linphone-console_package() {
	short_desc="Voice-over-IP phone - console interface"
	pkg_install() {
		vmove usr/bin/linphonec
		vmove usr/bin/linphonecsh
	}
}

linphone-tools_package() {
	short_desc="Voice-over-IP phone - tools"
	pkg_install() {
		for i in linphone-daemon-pipetest liblinphone-auto-answer \
			liblinphone-sendmsg liblinphone-test-ecc \
			liblinphone-lpc2xml-test liblinphone-xml2lpc-test; do
				vmove "usr/bin/$i";
		done
	}
}
linphone-devel_package() {
	short_desc="Voice-over-IP phone - development files"
	depends="linphone>=${version}_${revision} libxml2-devel ortp-devel sqlite-devel"
	pkg_install() {
		vmove usr/lib/liblinphone.so
		vmove usr/include/linphone
		vmove usr/include/linphone++
		vmove usr/lib/cmake/LibLinphone
		vmove usr/lib/cmake/LinphoneCxx
		vmove "usr/share/doc/liblinphone-*"
	}

}
