# Template file for 'kf6-ki18n'
# group=kde-frameworks
pkgname=kf6-ki18n
version=6.28.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules qt6-tools qt6-base
 qt6-declarative-host-tools gettext python3"
makedepends="qt6-declarative-devel"
depends="iso-codes"
short_desc="KDE Gettext-based UI text internationalization"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/ki18n"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=820ce5858c6db732d68da53572a0e7db8353e4372d2122debcfb0f9ff10b85db

# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version}"

do_check() {
	cd build
	# disable failing tests
	ctest -E "kcountrytest|kcountrysubdivisiontest|ki18n-klocalizedstringtest|kcatalogtest"
}

kf6-ki18n-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
