# Template file for 'kconfig-frontends'
pkgname=kconfig-frontends
version=4.11.0.1
revision=1
archs="i686* x86_64*"
build_style=gnu-configure
configure_args="--enable-conf --enable-mconf --enable-nconf --enable-qconf --disable-gconf"
hostmakedepends="autoconf automake pkg-config libtool"
makedepends="flex gperf bison ncurses-devel qt5-devel"
depends="bash python3"
short_desc="Linux kernel style configuration framework for other projects"
maintainer="Max Logaev <logaevmax@gmail.com>"
license="GPL-2.0-only"
homepage="https://gitlab.com/ymorin/kconfig-frontends"
distfiles="${DEBIAN_SITE}/main/k/${pkgname}/${pkgname}_${version}+dfsg.orig.tar.bz2"
checksum=5462393596a42e6efed78e1b0a56fde75466dd50452394b841f2882a78000ca8

pre_configure() {
	mkdir -p "./scripts/.autostuff/m4"
	autoreconf -fi
}

libkconfig-parser_package() {
	short_desc+=" - parsing library"

	pkg_install() {
		vmove "usr/lib/libkconfig-parser-*.so"
	}
}

libkconfig-parser-devel_package() {
	short_desc+=" - development files"
	depends="libkconfig-parser-${version}_${revision}"

	pkg_install() {
		vmove usr/include
		vmove usr/lib/libkconfig-parser.so
		vmove usr/lib/pkgconfig
	}
}

kconfig-frontends-qt5_package() {
	short_desc+=" - Qt5"
	depends="${sourcepkg}>=${version}_${revision}"

	pkg_install() {
		vmove usr/bin/kconfig-qconf
	}
}
