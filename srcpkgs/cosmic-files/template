# Template file for 'cosmic-files'
pkgname=cosmic-files
version=1.6.0
revision=1
archs="x86_64*"
_tag=epoch-${version}
build_style=cargo
hostmakedepends="pkg-config just"
makedepends="libxkbcommon-devel libglib-devel"
depends="cosmic-icons gvfs xdg-utils"
short_desc="File manager for the COSMIC desktop environment"
maintainer="Benjamin Calderon <benj.calderon@gmail.com>"
license="GPL-3.0-only"
homepage="https://github.com/pop-os/cosmic-files"
distfiles="https://github.com/pop-os/cosmic-files/archive/refs/tags/${_tag}.tar.gz"
checksum=c43251ffb09f443aaab1ce93c1a6a655fdc4f8a26c9615324bc85b6503fea210

do_build() {
	cargo build --release --locked --target ${RUST_TARGET}
	cargo build --release --locked --target ${RUST_TARGET} --package cosmic-files-applet
}

do_install() {
	just --set cargo-target-dir "target/${RUST_TARGET}" --set rootdir ${DESTDIR} --set prefix /usr install
}
