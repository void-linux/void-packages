# Template file for 'cairo-dock'
pkgname=cairo-dock
version=3.6.2
revision=1
build_style=cmake
configure_args="-Denable-desktop-manager=ON -Denable-egl-support=ON
 -Denable-systemd-service=OFF"
hostmakedepends="pkg-config gettext extra-cmake-modules wayland-devel
 wayland-protocols"
makedepends="libcurl-devel dbus-glib-devel dbus-devel libxml2-devel gtk+3-devel
 glib-devel cairo-devel librsvg-devel glu-devel libglvnd-devel libX11-devel
 libXtst-devel libXcomposite-devel libXrandr-devel libXrender-devel
 libXinerama-devel wayland-devel gtk-layer-shell-devel json-c-devel"
depends="desktop-file-utils"
short_desc="Light eye-candy fully themable animated dock"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="http://glx-dock.org/"
distfiles="https://github.com/Cairo-Dock/cairo-dock-core/archive/refs/tags/${version}.tar.gz"
checksum=71e351d904d86f04d489e5b58c510fe2276ab129aee9ba98308508abf2dcfa87
lib32disabled=yes
CFLAGS="-D_BSD_SOURCE"
CXXFLAGS="-D_BSD_SOURCE"

cairo-dock-devel_package() {
	short_desc+=" - development files"
	depends="${makedepends} libgldi>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}

libgldi_package() {
	short_desc+=" - OpenGL Desktop Interface"
	pkg_install() {
		vmove "usr/lib/*.so.*"
	}
}
