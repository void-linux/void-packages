# Template file for 'MEGAcmd'
pkgname=MEGAcmd
version=2.6.0
revision=1
_sdk_commit="8775533fe50255723c45ab8abf4e14285a592d51"
build_style=cmake
configure_args="-DCMAKE_INSTALL_PREFIX=/ -DVCPKG_ROOT='' -DFULL_REQS=OFF
 -DUSE_FFMPEG=ON -DENABLE_MEDIA_FILE_METADATA=ON -DENABLE_MEGACMD_TESTS=ON"
hostmakedepends="pkg-config"
makedepends="libsodium-devel openssl-devel sqlite-devel libcurl-devel icu-devel
 freeimage-devel libuv-devel readline-devel pcre-devel crypto++-devel
 libmediainfo-devel ffmpeg-devel zlib-devel fuse3-devel gtest-devel"
short_desc="Command Line Interactive and Scriptable Application to access MEGA"
maintainer="otolias <p17anto2@gmail.com>"
license="BSD-2-Clause, GPL-3.0-or-later"
homepage="https://github.com/meganz/MEGAcmd"
distfiles="https://github.com/meganz/MEGAcmd/archive/${version}_Linux.tar.gz
 https://github.com/meganz/sdk/archive/${_sdk_commit}.tar.gz"
checksum="705777008ff0242b539a689aaab22eed27857eec50b2c5596d751db17bf374be
 ae942f99b9ac55d0fcd108559fded7e3dba15075e358815065b3bd2d41ec3357"
replaces="megacmd>=0"

CXXFLAGS="-fpermissive"

skip_extraction="${_sdk_commit}.tar.gz"

post_extract() {
	vsrcextract -C sdk/ "${_sdk_commit}.tar.gz"
}

do_check() {
	./build/mega-cmd-tests-unit
}

post_install() {
	# Remove test binaries
	rm ${DESTDIR}/usr/bin/mega-cmd-tests-integration
	rm ${DESTDIR}/usr/bin/mega-cmd-tests-unit

	vmkdir usr/lib/sysctl.d
	mv ${DESTDIR}/etc/sysctl.d/99-megacmd-inotify-limit.conf ${DESTDIR}/usr/lib/sysctl.d/

	vcompletion ${DESTDIR}/etc/bash_completion.d/megacmd_completion.sh bash mega-cmd
	rm -r ${DESTDIR}/etc/bash_completion.d

	vlicense LICENSE
}
