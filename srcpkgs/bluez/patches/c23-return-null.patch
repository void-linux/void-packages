Return NULL instead of false from functions returning a pointer.
With C23, false is no longer a null pointer constant and these
returns fail to compile (autoconf 2.73 makes configure pick C23).
Not fixed upstream as of bluez master 2026-11-07.

--- a/src/shared/ad.c
+++ b/src/shared/ad.c
@@ -1245,7 +1245,7 @@
 					const struct bt_ad_data *data)
 {
 	if (!ad)
-		return false;
+		return NULL;
 
 	return queue_find(ad->data, data_match, data);
 }
--- a/tools/mesh/mesh-db.c
+++ b/tools/mesh/mesh-db.c
@@ -804,7 +804,7 @@
 
 	jnode = get_node_by_unicast(cfg->jcfg, unicast);
 	if (!jnode)
-		return false;
+		return NULL;
 
 	if (!json_object_object_get_ex(jnode, "elements", &jarray))
 		return NULL;
@@ -841,7 +841,7 @@
 
 	jelement = get_element(unicast, ele_addr);
 	if (!jelement)
-		return false;
+		return NULL;
 
 	if (!json_object_object_get_ex(jelement, "models", &jarray))
 		return NULL;
@@ -2523,7 +2523,7 @@
 	json_object *export = NULL, *jarray;
 
 	if (!cfg || !cfg->jcfg)
-		return false;
+		return NULL;
 
 	if (json_object_deep_copy(cfg->jcfg, &export, NULL) != 0)
 		return NULL;
