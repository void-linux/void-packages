# Template file for 'zoom'
pkgname=zoom
version=7.2.5.6661
revision=1
archs="x86_64"
depends="fontconfig libXcomposite libXrandr libgbm libglvnd libpulseaudio
 libxkbcommon libxslt nss xcb-util-cursor xcb-util-keysyms xcb-util-wm"
short_desc="Video Conferencing and Web Conferencing Service"
maintainer="Orphaned <orphan@voidlinux.org>"
license="custom:Proprietary"
homepage="https://zoom.us/"
distfiles="https://cdn.zoom.us/prod/${version}/zoom_x86_64.rpm"
checksum=2659f4afa8eee31357aed88dcb2f5596983e3e2d19d38f25d0cde6b96474a186
repository=nonfree
restricted=yes
noshlibprovides=yes
noverifyrdeps=yes

build_options="systemqt"
desc_option_systemqt="Use system QT libraries"

if [ "$build_option_systemqt" ]; then
	depends+=" qt6-base qt6-declarative qt6-qt5compat qt6-svg"
	# CEF elements will refuse to load otherwise
	make_dirs="/opt/zoom/Qt/lib 0755 root root"
fi

pre_install() {
	if [ "$build_option_systemqt" ]; then
		rm -r opt/zoom/Qt
		rm opt/zoom/libquazip.so
		rm opt/zoom/libmpg123.so
		rm opt/zoom/libKF6GlobalAccel.so.6
		rm opt/zoom/qt.conf
	fi
}

do_install() {
	vcopy "*" /
	vlicense ${FILESDIR}/DISTRIBUTION-DETAILS
}
