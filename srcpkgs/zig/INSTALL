# When zig is updated to a metapackage, xbps removes /usr/bin/zig after zigX.Y has
# already created an alternative symlink in its place. Restore it if it's missing.
if [ "${ACTION}" = "post" ] && [ ! -e usr/bin/zig ] && [ ! -L usr/bin/zig ]; then
	ln -s "../lib/zig/${VERSION%_*}/bin/zig" usr/bin/zig
fi
