ensure a D-Bus session exists before starting niri; workaround for https://github.com/niri-wm/niri/issues/4727
--
--- /dev/null
+++ b/resources/niri-dbus-run-session-if-needed
@@ -0,0 +1,10 @@
+#!/bin/sh
+# Usage: niri-dbus-run-session-if-needed PROGRAM [ARGUMENTS]
+# If the session bus is not available it is spawned and wrapper round our program
+# Otherwise we spawn our program directly
+drs=
+if [ -z "${DBUS_SESSION_BUS_ADDRESS}" ]
+then
+    drs=dbus-run-session
+fi
+exec ${drs} "$@"
--- a/resources/niri.desktop
+++ b/resources/niri.desktop
@@ -1,6 +1,7 @@
 [Desktop Entry]
 Name=Niri
 Comment=A scrollable-tiling Wayland compositor
-Exec=/usr/bin/niri --session
+Exec=/usr/libexec/niri-dbus-run-session-if-needed /usr/bin/niri --session
+TryExec=/usr/bin/niri
 Type=Application
 DesktopNames=niri
