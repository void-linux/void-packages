# Template file for 'libXtst'
pkgname=libXtst
version=1.2.6
revision=1
build_style=gnu-configure
hostmakedepends="pkg-config"
makedepends="xorgproto libXext-devel libXi-devel"
short_desc="X Tst Library"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://gitlab.freedesktop.org/xorg/lib/libxtst"
distfiles="${XORG_SITE}/lib/$pkgname-$version.tar.xz"
checksum=f94f0b37c07d80d877f3eda2c2405cc7e62aa9842f6310354aa349e3d66a4fe5

post_install() {
	vlicense COPYING
}

libXtst-devel_package() {
	depends="${makedepends} libXtst>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
		vmove usr/share
	}
}
