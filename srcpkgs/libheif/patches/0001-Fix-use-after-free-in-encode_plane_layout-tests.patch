From 5a535b8bbbd37e54b8d8a2ee0c4cf18afa8af2db Mon Sep 17 00:00:00 2001
From: Duncan Overbruck <mail@duncano.de>
Date: Fri, 25 Sep 2026 04:46:19 +0200
Subject: [PATCH] Fix use after free in encode_plane_layout tests

---
 tests/encode_plane_layout.cc | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/tests/encode_plane_layout.cc b/tests/encode_plane_layout.cc
index 29c124ad..3a712bd4 100644
--- a/tests/encode_plane_layout.cc
+++ b/tests/encode_plane_layout.cc
@@ -78,9 +78,8 @@ void add_plane(heif_image* img, heif_channel channel, uint32_t w, uint32_t h)
   }
 }
 
-heif_error encode(heif_image* img, heif_compression_format format)
+heif_error encode(heif_context* ctx, heif_image* img, heif_compression_format format)
 {
-  heif_context* ctx = heif_context_alloc();
   heif_encoder* encoder = nullptr;
   heif_error err = heif_context_get_encoder_for_format(ctx, format, &encoder);
   REQUIRE(err.code == heif_error_Ok);
@@ -88,17 +87,18 @@ heif_error encode(heif_image* img, heif_compression_format format)
   err = heif_context_encode_image(ctx, img, encoder, nullptr, nullptr);
 
   heif_encoder_release(encoder);
-  heif_context_free(ctx);
   return err;
 }
 
 void expect_refused(heif_image* img, heif_compression_format format)
 {
-  heif_error err = encode(img, format);
+  heif_context* ctx = heif_context_alloc();
+  heif_error err = encode(ctx, img, format);
   INFO("encode error (" << err.code << "/" << err.subcode << "): " << err.message);
   REQUIRE(err.code != heif_error_Ok);
   CHECK(err.code == heif_error_Usage_error);
   heif_image_release(img);
+  heif_context_free(ctx);
 }
 
 } // namespace
@@ -116,10 +116,12 @@ TEST_CASE("encoding refuses images with a non-canonical plane layout")
     for (heif_channel ch : {heif_channel_R, heif_channel_G, heif_channel_B}) {
       add_plane(img, ch, W, H);
     }
-    heif_error err = encode(img, format);
+    heif_context* ctx = heif_context_alloc();
+    heif_error err = encode(ctx, img, format);
     INFO("encode error (" << err.code << "/" << err.subcode << "): " << err.message);
     CHECK(err.code == heif_error_Ok);
     heif_image_release(img);
+    heif_context_free(ctx);
   }
 
   SECTION("RGB without its B plane") {
@@ -171,10 +173,12 @@ TEST_CASE("encoding refuses images with a non-canonical plane layout")
                                               heif_component_datatype_unsigned_integer, 8, &id);
     REQUIRE(err.code == heif_error_Ok);
 
-    err = encode(img, format);
+    heif_context* ctx = heif_context_alloc();
+    err = encode(ctx, img, format);
     INFO("encode error (" << err.code << "/" << err.subcode << "): " << err.message);
     CHECK(err.code == heif_error_Ok);
     heif_image_release(img);
+    heif_context_free(ctx);
   }
 }
 
-- 
