# Template file for 'bup'
pkgname=bup
version=0.34
revision=1
build_style=configure
hostmakedepends="pkg-config python3 perl git pandoc"
makedepends="python3-devel readline-devel acl-devel"
depends="python3-pyxattr python3-fuse par2cmdline"
checkdepends="python3-pytest python3-pyxattr tar rsync mdocml par2cmdline"
short_desc="Backup system based on the git packfile format"
maintainer="Enno Boland <gottox@voidlinux.org>"
license="LGPL-2.0-only"
homepage="https://github.com/bup/bup"
distfiles="https://github.com/bup/bup/archive/${version}.tar.gz"
checksum=ab790f39e53bee9570f17c58d22e4bc03246f25d45e12cc1b7b5f2bef6d14611
python_version=3
nocross=yes

pre_configure() {
	vsed -e 's#^PREFIX=.*#PREFIX=/usr#' -i GNUmakefile
	# make test-install find the man pages
	vsed -e '/export PATH=/a export MANPATH="\$tmpdir/install/share/man"' -i test/ext/test-install
}

do_check() {
	# skip test-meta because user groups in chroot are mapped to 65534
	# for which there is no group name, making the test fail
	./pytest -x --ignore=test/ext/test-meta
}
