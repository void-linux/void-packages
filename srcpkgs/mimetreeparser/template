# Template file for 'mimetreeparser'
# group=kde-gear
pkgname=mimetreeparser
version=26.08.1
revision=1
build_style=cmake
configure_args="
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DECM_MKSPECS_INSTALL_DIR=/usr/lib/qt6/mkspecs/modules"
hostmakedepends="extra-cmake-modules qt6-base qt6-tools gettext
 qt6-declarative-host-tools python3 kf6-kconfig"
makedepends="kf6-kcalendarcore-devel kf6-kcodecs-devel kf6-ki18n-devel
 kf6-kwidgetsaddons-devel kmbox-devel kf6-kmime-devel libkleo-devel
 qt6-qt5compat-devel qt6-base-devel qt6-declarative-devel qt6-tools-devel
 gpgmepp-devel kf6-kcolorscheme-devel kf6-kio-devel"
short_desc="Parser for MIME trees"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://invent.kde.org/pim/mimetreeparser"
distfiles="${KDE_SITE}/release-service/${version}/src/${pkgname}-${version}.tar.xz"
checksum=b81506a5876039c0aa9969f7bd71040880b171b53014a76a8bbaed02287cc5f9

mimetreeparser-devel_package() {
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/lib/cmake
		vmove usr/include
		vmove usr/lib/qt6/mkspecs
		vmove "usr/lib/*.so"
	}
}
