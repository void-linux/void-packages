# Template file for 'libXfont2'
pkgname=libXfont2
version=2.0.9
revision=1
build_style=gnu-configure
hostmakedepends="pkg-config"
makedepends="xorgproto xtrans freetype-devel libfontenc-devel"
checkdepends="python3"
short_desc="X font 2 Library"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="http://xorg.freedesktop.org/"
distfiles="${XORG_SITE}/lib/${pkgname}-${version}.tar.xz"
checksum=f042a370666815e7b941e9b7019024755bd1c6c2954afbfa515af378251799e2

post_install() {
	vlicense COPYING
}

libXfont2-devel_package() {
	depends="${makedepends} ${sourcepkg}-${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
	}
}
