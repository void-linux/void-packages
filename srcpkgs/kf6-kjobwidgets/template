# Template file for 'kf6-kjobwidgets'
# group=kde-frameworks
pkgname=kf6-kjobwidgets
version=6.31.0
revision=1
build_style=cmake
_llvmver=21
configure_args="$(vopt_bool python BUILD_PYTHON_BINDINGS)"
hostmakedepends="extra-cmake-modules qt6-tools qt6-base
 $(vopt_if python "python3-build python3-setuptools shiboken6 llvm${_llvmver}")"
makedepends="kf6-kcoreaddons-devel kf6-knotifications-devel
 kf6-kwidgetsaddons-devel qt6-base-private-devel
 $(vopt_if python 'libshiboken6-devel libpyside6-devel python3-devel')"
short_desc="Widgets for showing progress of asynchronous jobs"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kjobwidgets"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=b734186ed41e8cc84c2a5f9ba61b46075dacf076450dcb78d37a5d01dcd8c69e

# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version%.*}"

build_options="python"
build_options_default="python"

export LLVM_INSTALL_DIR=/usr/lib/llvm/${_llvmver}

kf6-kjobwidgets-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} qt6-base-devel
	 kf6-kcoreaddons-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
