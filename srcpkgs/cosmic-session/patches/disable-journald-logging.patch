cosmic-session always attempts to connect to systemd-journald at startup
(src/main.rs), gated behind the "systemd" cargo feature -- but that
feature is unconditionally pulled in by "logind" (needed for real
session management via logind-zbus), which is enabled by default. On a
runit system there is no journald socket, so the connection always
fails and cosmic-session prints a WARN on every boot ("failed to connect
to journald") before falling back to its normal stdout/stderr logger.
Remove the journald attempt entirely instead of just accepting the
warning -- the stdout/stderr fmt_layer is the only logger that ever
actually works here anyway. Same fix already applied to cosmic-comp and
cosmic-greeter's disable-journald-logging.patch; cosmic-session was
missed in that batch.

--- a/src/main.rs
+++ b/src/main.rs
@@ -53,23 +53,6 @@
 		.with_default_directive(LevelFilter::INFO.into())
 		.from_env_lossy();

-	#[cfg(feature = "systemd")]
-	if let Ok(journald) = tracing_journald::layer() {
-		trace
-			.with(journald)
-			.with(env_filter)
-			.try_init()
-			.wrap_err("failed to initialize logger")?;
-	} else {
-		trace
-			.with(fmt::layer())
-			.with(env_filter)
-			.try_init()
-			.wrap_err("failed to initialize logger")?;
-		warn!("failed to connect to journald")
-	}
-
-	#[cfg(not(feature = "systemd"))]
 	trace
 		.with(fmt::layer())
 		.with(env_filter)
