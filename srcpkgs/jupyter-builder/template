# Template file for 'jupyter-builder'
pkgname=jupyter-builder
version=1.3.0
revision=2
build_style=python3-pep517
# The integration tests fetch a template and JS dependencies. The upstream
# warning filter imports copier even when pytest skips those tests.
make_check_args="--ignore=tests/test_tpl.py -o filterwarnings=error"
hostmakedepends="hatchling hatch-nodejs-version"
depends="nodejs python3-jupyter_core python3-traitlets"
checkdepends="${depends} python3-jsonschema python3-pytest"
short_desc="Build tools for JupyterLab extensions"
maintainer="dkwo <npiazza@disroot.org>"
license="Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND ISC AND MIT"
homepage="https://github.com/jupyterlab/jupyter-builder"
distfiles="${PYPI_SITE}/j/jupyter-builder/jupyter_builder-${version}.tar.gz"
checksum=dc0a3cdc27be674f29de2b4aecfdd55190fffa65199846bbdf4ceaf31a56b7d1
# Older JupyterLab packages own /usr/bin/jlpm.
conflicts="jupyterlab<4.6.0"

post_install() {
	local notice
	vlicense LICENSE
	for notice in THIRD_PARTY_LICENSES/*; do
		vlicense "$notice"
	done
}
