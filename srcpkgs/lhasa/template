# Template file for 'lhasa'
pkgname=lhasa
version=0.6.0
revision=1
build_style=gnu-configure
hostmakedepends="automake libtool"
short_desc="Free Software LHA implementation"
maintainer="Orphaned <orphan@voidlinux.org>"
license="ISC"
homepage="https://github.com/fragglet/lhasa"
changelog="https://raw.githubusercontent.com/fragglet/lhasa/refs/heads/master/NEWS.md"
distfiles="https://github.com/fragglet/lhasa/releases/download/v${version}/lhasa-${version}.tar.gz"
checksum=9840154367f73e9d9c3196f944a121ab4d398d84e921c8fe8fca8a931274aed7

post_install() {
	vlicense COPYING.md
}

lhasa-devel_package() {
	depends="lhasa>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
	}
}
