# Template file for 'neru'
pkgname=neru
version=1.49.0
revision=1
build_style=go
go_import_path="github.com/y3owk1n/neru"
go_ldflags="
 -X ${go_import_path}/internal/cli.Version=${version}
 -X ${go_import_path}/internal/cli.BuildDate=$(date --date "@${SOURCE_DATE_EPOCH}" "+%Y%m%d-%H:%M:%S")
"
go_package="./cmd/neru"
hostmakedepends="pkg-config"
makedepends="wayland-devel libxkbcommon-devel cairo-devel libei-devel
 libXrandr-devel libXfixes-devel libXtst-devel"
depends=""
short_desc="Navigate your entire screen without touching the mouse"
maintainer="Andrew J. Hesford <ajh@sideband.org>"
license="MIT"
homepage="https://github.com/y3owk1n/neru"
changelog="https://raw.githubusercontent.com/y3owk1n/neru/refs/heads/main/CHANGELOG.md"
distfiles="${homepage}/archive/v${version}.tar.gz"
checksum=999c897b35dfd781afad00e7dfa036c9ffef196b7bcb32f95d0c395ec8f987d3

post_build() {
	local _shell

	for _shell in bash zsh fish; do
		env GOARCH= CGO_ENABLED=0 \
		go run ./cmd/neru completion "${_shell}" > "completion.${_shell}"
	done

	env GOARCH= CGO_ENABLED=0 go run ./cmd/genman build/man
}

post_install() {
	vlicense LICENSE

	local _f
	for _f in build/man/*.1; do
		vman "${_f}"
	done

	for _f in bash zsh fish; do
		vcompletion "completion.${_f}" "${_f}"
	done
}
