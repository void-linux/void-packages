# Template file for 'hiredis'
pkgname=hiredis
version=1.5.0
revision=1
build_style=gnu-makefile
make_build_args="OPTIMIZATION= USE_WERROR=0 USE_SSL=1"
make_install_args="USE_SSL=1"
makedepends="openssl-devel"
checkdepends="redis"
short_desc="Minimalistic C client for Redis"
maintainer="Enno Boland <gottox@voidlinux.org>"
license="BSD-3-Clause"
homepage="https://github.com/redis/hiredis"
changelog="https://github.com/redis/hiredis/releases"
distfiles="https://github.com/redis/hiredis/archive/v${version}.tar.gz"
checksum=eec7ef8641d221e144a58d5ef8d733c8c75c7fd487097a233aacb4fa33981cfb

post_install() {
	vlicense COPYING
}

hiredis-ssl_package() {
	depends="${sourcepkg}-${version}_${revision}"
	short_desc+=" - ssl support"
	pkg_install() {
		vmove "usr/lib/*_ssl.so.*"
	}
}

hiredis-devel_package() {
	depends="${sourcepkg}-${version}_${revision} ${sourcepkg}-ssl-${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
	}
}
