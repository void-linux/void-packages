# Template file for 'dwarffortress'
pkgname=dwarffortress
version=53.16
revision=1
_urlver=${version//./_}
archs="x86_64"
hostmakedepends="patchelf"
depends="virtual?libGL"
short_desc="Control a dwarven outpost in a randomly generated world"
maintainer="Rutpiv <roger_freitas@live.com>"
license="custom:Proprietary"
homepage="https://www.bay12games.com/dwarves/"
distfiles="https://www.bay12games.com/dwarves/df_${_urlver}_linux.tar.bz2"
checksum=2f9c0134b2465cccb705b8d3e322cdff07df7374ffbfafffe8f982f2ef7e7e7d
nopie="distfiles are precompiled as PIE"
repository=nonfree
noshlibprovides=yes
nostrip=yes

do_install() {
	vmkdir /opt/dwarffortress
	vcopy "*" /opt/dwarffortress

	# unused audio plugins, only loaded with CUSTOM_SOUND_PLUGINS
	rm "${DESTDIR}"/opt/dwarffortress/lib{fmod,sdl_mixer}_plugin.so

	# drop RUNPATH pointing at upstream's build dir
	patchelf --set-rpath /opt/dwarffortress \
		"${DESTDIR}"/opt/dwarffortress/{dwarfort,*.so*}

	chmod 755 "${DESTDIR}"/opt/dwarffortress/{dwarfort,run_df,*.so*}

	vbin ${FILESDIR}/dwarffortress
	vlicense readme.txt dwarffortress.txt
}
