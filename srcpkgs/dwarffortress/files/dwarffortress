#!/bin/sh
# Dwarf Fortress wrapper for Void Linux
DF_DIR="/opt/dwarffortress"
DIRECTORY="${XDG_DATA_HOME:-$HOME/.local/share}/dwarffortress"

mkdir -p "$DIRECTORY" || exit 1
[ -e "$DIRECTORY/data" ] || ln -s "$DF_DIR/data" "$DIRECTORY/data"

cd "$DIRECTORY" || exit 1
# keep prefs/saves apart from the Steam release
XDG_DATA_HOME="$DIRECTORY" exec "$DF_DIR/dwarfort" "$@"
