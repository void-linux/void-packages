pkgname=kmbox
version=26.08.1
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="extra-cmake-modules qt6-base qt6-tools python3
 gettext"
makedepends="kf6-kmime-devel qt6-base-devel kf6-kcodecs-devel"
short_desc="Library for accessing mail storages in MBox format"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://community.kde.org/KDE_PIM"
distfiles="${KDE_SITE}/release-service/${version}/src/kmbox-${version}.tar.xz"
checksum=4bda0a789e010d383db7a56294941853cc2d878ddd57b33f1e08daeb2714a75b

kmbox-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
