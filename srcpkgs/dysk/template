# Template file for 'dysk'
pkgname=dysk
version=3.7.1
revision=1
build_style=cargo
short_desc="Utility to get information on filesystems, like df but better"
maintainer="yabobay <yabobay@yahoo.com>"
license="MIT"
homepage="https://dystroy.org/dysk/"
changelog="https://raw.githubusercontent.com/Canop/dysk/refs/heads/main/CHANGELOG.md"
distfiles="https://github.com/Canop/dysk/archive/refs/tags/v${version}.tar.gz"
checksum=7ac25f80eb4e35fccf60d7c783692595b75c82026e37321ebe749c5a080e740a

post_install() {
	vlicense LICENSE
	local _out_dir=$(echo "target/${RUST_TARGET}/release/build/dysk-"*/out)
	vcompletion "${_out_dir}/dysk.bash" bash
	vcompletion "${_out_dir}/dysk.fish" fish
	vcompletion "${_out_dir}/_dysk" zsh
	vman "${_out_dir}/dysk.1"
}
