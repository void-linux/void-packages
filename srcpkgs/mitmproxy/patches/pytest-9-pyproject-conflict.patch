pytest 9 rejects a pyproject.toml that has both [tool.pytest.ini_options]
and any other key directly under [tool.pytest] ("Cannot use both
[tool.pytest] (native TOML types) and [tool.pytest.ini_options]").
The individual_coverage exclude list is only read by
test/individual_coverage.py in upstream's dedicated tox environment,
never by pytest itself, so move it out of the tool.pytest table.

--- a/pyproject.toml
+++ b/pyproject.toml
@@ -152,7 +152,7 @@
     "error::RuntimeWarning",
     "error::pytest.PytestUnraisableExceptionWarning",
 ]
 
-[tool.pytest.individual_coverage]
+[tool.individual_coverage]
 exclude = [
   "mitmproxy/addons/__init__.py",
   "mitmproxy/addons/onboarding.py",
