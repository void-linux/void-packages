# Template file for 'libpisp'
pkgname=libpisp
version=1.7.0
revision=1
archs="aarch64* armv*"
build_style=meson
hostmakedepends="pkg-config"
makedepends="json-c++"
short_desc="Helper library for Raspberry Pi ISP (PiSP) configuration"
maintainer="Rutpiv <roger_freitas@live.com>"
license="BSD-2-Clause AND GPL-2.0-only WITH Linux-syscall-note"
homepage="https://github.com/raspberrypi/libpisp"
distfiles="https://github.com/raspberrypi/libpisp/archive/v${version}.tar.gz"
checksum=45e3e0fa21f893d9edb6dae8118c5af6aaf74a9c9d5b8ed120a95531e0b13f2b

post_install() {
	vlicense LICENSE
}

libpisp-devel_package() {
	depends="libpisp-${version}_${revision} json-c++"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
