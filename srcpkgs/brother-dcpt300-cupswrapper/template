# Template file for 'brother-dcpt300-cupswrapper'
pkgname=brother-dcpt300-cupswrapper
version=3.0.2
revision=1
archs="i686 x86_64"
create_wrksrc=yes
depends="brother-dcpt300-lpr cups psutils"
short_desc="CUPS wrapper driver for the Brother DCP-T300 inkjet printer"
maintainer="Suyono Sukorame <suyonosukorame@ymail.com>"
license="custom:Brother"
homepage="https://support.brother.com/g/b/downloadtop.aspx?c=in&lang=en&prod=dcpt300_all"
distfiles="https://download.brother.com/welcome/dlf101961/dcpt300cupswrapper-${version}-0.i386.deb"
checksum=e356f4a0446e1a1362221b88903bb29061c4d051ac426c2c2bc2e896ca203960
repository="nonfree"
nopie=yes

if [ "$XBPS_TARGET_MACHINE" = "x86_64" ]; then
	depends+=" glibc-32bit"
fi

do_install() {
	# Keep the wrapper pieces that are used at runtime: brcupsconfpt1
	# (option -> rc converter, executed by the CUPS filter) and the PPD.
	# The upstream 'cupswrapperdcpt300' installer is init.d/lpadmin based
	# and must not run on Void, so it is removed from the package.
	vcopy opt /
	rm -f ${DESTDIR}/opt/brother/Printers/dcpt300/cupswrapper/cupswrapperdcpt300

	# Static CUPS filter (generated by upstream installer otherwise).
	vinstall ${FILESDIR}/brother_lpdwrapper_dcpt300 755 usr/lib/cups/filter

	# Static PPD in the standard Void PPD directory.
	vinstall opt/brother/Printers/dcpt300/cupswrapper/brother_dcpt300_printer_en.ppd 644 usr/share/ppd/Brother

	# Give the CUPS service (lp group) access to the printer over USB.
	vinstall ${FILESDIR}/43-cups-usb.rules 644 /usr/lib/udev/rules.d/

	# Ship the Brother EULA with the binary package
	# (license="custom:Brother").
	vlicense ${FILESDIR}/agree.html
}
