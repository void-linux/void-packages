# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version%.*}"

kf6-kirigami-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} qt6-base-devel
	 qt6-declarative-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
