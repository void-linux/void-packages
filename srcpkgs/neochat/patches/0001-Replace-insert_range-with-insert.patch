From cd1ed94947d60988a013d43d2837610630c9c927 Mon Sep 17 00:00:00 2001
From: John Zimmermann <me@johnnynator.dev>
Date: Mon, 24 Aug 2026 21:38:56 +0200
Subject: [PATCH] Replace insert_range with insert

---
 src/libneochat/eventhandler.cpp                        | 9 +++++----
 src/messagecontent/models/eventmessagecontentmodel.cpp | 3 ++-
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/src/libneochat/eventhandler.cpp b/src/libneochat/eventhandler.cpp
index 466f28c45..1a95847c0 100644
--- a/src/libneochat/eventhandler.cpp
+++ b/src/libneochat/eventhandler.cpp
@@ -719,7 +719,8 @@ Blocks::BlockPtrs EventHandler::blocksForEvent(NeoChatRoom *room, const Quotient
         return {};
     }
     Blocks::BlockPtrs blocks;
-    blocks.insert_range(blocks.end(), blocksForEventType(room, event, parent));
+    auto range = blocksForEventType(room, event, parent);
+    blocks.insert(blocks.end(), range.begin(), range.end());
 
     const auto roomMessageEvent = eventCast<const Quotient::RoomMessageEvent>(event);
     if (roomMessageEvent
@@ -765,8 +766,7 @@ Blocks::BlockPtrs EventHandler::blocksForEventType(NeoChatRoom *room, const Quot
         components.push_back(EventHandler::blockForMediaEvent(room, event, parent));
         auto body = EventHandler::rawMessageBody(*event);
         if (!event->is<StickerEvent>() && !body.isEmpty()) {
-            components.insert_range(components.end(),
-                                    TextHandler().textComponents(body,
+                       auto range = TextHandler().textComponents(body,
                                                                  EventHandler::messageBodyInputFormat(*event),
                                                                  room,
                                                                  event,
@@ -776,7 +776,8 @@ Blocks::BlockPtrs EventHandler::blocksForEventType(NeoChatRoom *room, const Quot
                                                                  roomMessageEvent->isReplaced(),
 #endif
                                                                  false,
-                                                                 parent));
+                                                                 parent);
+            components.insert(components.end(), range.begin(), range.end());
         }
         return components;
     }
diff --git a/src/messagecontent/models/eventmessagecontentmodel.cpp b/src/messagecontent/models/eventmessagecontentmodel.cpp
index d75b33bc1..8d1c91ff8 100644
--- a/src/messagecontent/models/eventmessagecontentmodel.cpp
+++ b/src/messagecontent/models/eventmessagecontentmodel.cpp
@@ -324,7 +324,8 @@ Blocks::BlockPtrs EventMessageContentModel::messageContentComponents(bool isEdit
     if (isEditing) {
         blocks.push_back(new Blocks::ChatBarBlock(Blocks::ChatBar, true, {}, this));
     } else {
-        blocks.insert_range(blocks.end(), EventHandler::blocksForEvent(m_room, event, this));
+        auto range = EventHandler::blocksForEvent(m_room, event, this);
+        blocks.insert(blocks.end(), range.begin(), range.end());
     }
 
 #if Quotient_VERSION_MINOR > 9
-- 
2.55.0

