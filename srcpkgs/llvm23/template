libomp23_package() {
	short_desc+=" - Clang OpenMP support library"
	conflicts="libomp18>=0 libomp17>=0"
	homepage="https://openmp.llvm.org/"
	_bins=(
		$(vopt_if offload 'llvm-offload-device-info llvm-omp-kernel-replay')
	)
	_files=(
		lib/libomp.so
