# These binaries are ONLY used when building llvm, they aren't normally installed
llvm23-cross-tools_package() {
	conflicts="llvm18-cross-tools>=0 llvm17-cross-tools>=0"
	short_desc+=" - build tools for cross compiling LLVM"
	depends="llvm${_major}-devel>=${version}_${revision}
	 $(vopt_if lldb "lldb${_major}-devel>=${version}_${revision}")
	 $(vopt_if lld "lld${_major}-devel>=${version}_${revision}")
	 $(vopt_if flang "flang${_major}-devel>=${version}_${revision}")
	"
	pkg_install() {
		# Binaries ONLY used during the process of building llvm, and aren't usually installed
		vmkdir "${_llvm_prefix}/bin"
		vcopy build/bin/clang-tidy-confusable-chars-gen "${_llvm_prefix}/bin"
		if [ "$build_option_offload" ]; then
			vcopy build/bin/offload-tblgen "${_llvm_prefix}/bin"
		fi
		if [ "$build_option_mlir" ]; then
			vmove "${_llvm_prefix}/bin/mlir-src-sharder"
			vmove "${_llvm_prefix}/bin/mlir-src-sharder-${_major}"
			vmove "usr/bin/mlir-src-sharder-${_major}"
		fi
	}
}

libclc23_package() {
	short_desc+=" - Open implementation of the OpenCL C programming language"
	replaces="libclc-git>=0"
	pkg_install() {
		for _target in amdgcn-amd-amdhsa-llvm nvptx64-nvidia-cuda \
			spirv32-unknown-unknown spirv64-unknown-unknown \
			spirv32-unknown-vulkan spirv64-unknown-vulkan; do
			vmove "${_clang_prefix}/lib/${_target}/libclc.*"
		done
	}
}
