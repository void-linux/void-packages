			_vlink_libs "${_llvm_prefix}/lib/libomp*.so*"
			vmove "${_llvm_prefix}/lib/libLLVMOffload.so.*"
		fi
	}
}

libomp23-devel_package() {
	short_desc+=" - Clang OpenMP support library - development files"
	depends="libomp${_major}>=${version}_${revision}"
	conflicts="libomp18-devel>=0 libomp17-devel>=0"
	nostrip_files="
	 /${_llvm_prefix}/lib/amdgcn-amd-amdhsa/libompdevice.a
	 /${_llvm_prefix}/lib/nvptx64-nvidia-cuda/libompdevice.a"
	pkg_install() {
		vmove "${_llvm_prefix}/lib/libarcher.so"
		vmove "${_llvm_prefix}/lib/libarcher_static.a"
		vmove "${_llvm_prefix}/lib/cmake/openmp"
		if [ "$build_option_offload" ]; then
			vmove "${_llvm_prefix}/include/offload"
			vmove "${_llvm_prefix}/lib/amdgcn-amd-amdhsa/libompdevice.a"
			vmove "${_llvm_prefix}/lib/amdgcn-amd-amdhsa/libomptarget-amdgpu.bc"
			vmove "${_llvm_prefix}/lib/libLLVMOffload.so"
			vmove "${_llvm_prefix}/lib/nvptx64-nvidia-cuda/libompdevice.a"
			vmove "${_llvm_prefix}/lib/nvptx64-nvidia-cuda/libomptarget-nvptx.bc"
			vmove "${_llvm_prefix}/share/gdb/python/ompd"
		fi
	}
}

compiler-rt23_package() {
	short_desc+=" - runtime libraries"
	depends="clang${_major}-headers>=${version}_${revision}"
	noshlibprovides=yes
	noverifyrdeps=yes
	homepage="https://compiler-rt.llvm.org/"
	pkg_install() {
		vmove "${_clang_prefix}/lib/linux"
		if [ "$build_option_flang" ]; then
			vmove "${_clang_prefix}/lib/${_triplet}/libflang_rt.runtime.a"
		fi
		case "$XBPS_TARGET_MACHINE" in
		x86_64*|aarch64*|riscv64*)
			# the following files are only available for architectures that
			# support sanitizers.
			vmove "${_clang_prefix}/bin"
			vmove "${_clang_prefix}/share"
			;;
		*)
			[ ! -d "${_clang_prefix}/bin" ]
			[ ! -d "${_clang_prefix}/share" ]
		esac
	}
}

