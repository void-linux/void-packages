alternatives=$(:)
for _alt in "${_llvm_alts[@]}"; do
	alternatives+=" llvm:/usr/${_alt}:/${_llvm_prefix}/${_alt}"
done

_generic_alternatives() {
	# XXX: pkgname is set after $pkganme_package is called...
	# local _group=${pkgname%${_major}}
	local _group="$1"
	for _bin in "${_bins[@]}"; do
		alternatives+=" ${_group}:/usr/bin/${_bin}:/${_llvm_prefix}/bin/${_bin}"
		if [ -f "${PKGDESTDIR}/usr/share/man/man1/${_bin}-${_major}.1" ]; then
			alternatives+=" ${_group}:${_bin}.1:/usr/share/man/man1/${_bin}-${_major}.1"
		fi
	done
	for _file in "${_files[@]}"; do
		alternatives+=" ${_group}:/usr/${_file}:/${_llvm_prefix}/${_file}"
	done
}

_generic_move() {
	for _bin in "${_bins[@]}"; do
		vmove "${_llvm_prefix}/bin/${_bin}"
		vmove "${_llvm_prefix}/bin/${_bin}-${_major}"
		vmove "usr/bin/${_bin}-${_major}"
		if [ -f "${PKGDESTDIR}/usr/share/man/man1/${_bin}-${_major}.1" ]; then
			vmove "usr/share/man/man1/${_bin}-${_major}.1"
		fi
	done
	for _file in "${_files[@]}"; do
		vmove "${_llvm_prefix}/${_file}"
	done
}

clang23_package() {
	lib32disabled=yes
	depends="libstdc++-devel libgcc-devel binutils
	 compiler-rt${_major}>=${version}_${revision}"
	case "${XBPS_TARGET_MACHINE}" in
	armv[67]l-musl) depends+=" musl1.1-devel" ;;
	*) depends+=" ${XBPS_TARGET_LIBC}-devel" ;;
	esac
	conflicts="clang18>=0 clang17>=0 clang15>=0"
	short_desc+=" - C language family frontend"
	homepage="https://clang.llvm.org/"
	_bins=(
		amdgpu-arch
		c-index-test
		clang
		clang++
		clang-check
		clang-cl
		clang-cpp
		clang-extdef-mapping
		clang-format
		clang-linker-wrapper
		clang-offload-bundler
		clang-offload-packager
		clang-refactor
		clang-repl
		clang-scan-deps
		clang-sycl-linker
		clang-tblgen
		diagtool
		git-clang-format
		hmaptool
		nvptx-arch
		offload-arch
	)
	# XXX: are LLVMgold.so and LLVMPolly.so alternatives necessary?
	_files=(
		lib/LLVMgold.so
		$(vopt_if polly lib/LLVMPolly.so)
	)
	alternatives="
	 clang:polly.1:usr/share/man/man1/polly-${_major}.1"
	_generic_alternatives "clang"
	pkg_install() {
		_generic_move
		vlicense "${wrksrc}/clang/LICENSE.TXT"
		if [ "$build_option_polly" ]; then
			vmove "usr/share/man/man1/polly-${_major}.1"
		fi
	}
}

clang23-headers_package() {
	lib32disabled=yes
	short_desc+=" - C language family frontend - Headers"
	homepage="https://clang.llvm.org/"
	pkg_install() {
		vmove "${_clang_prefix}/include"
	}
}

clang23-devel_package() {
	lib32disabled=yes
	depends="libstdc++-devel libgcc-devel binutils
	 clang${_major}>=${version}_${revision}
	 clang-analyzer${_major}>=${version}_${revision}
	 llvm${_major}>=${version}_${revision}
	 $(vopt_if clang_tools_extra "clang-tools-extra${_major}>=${version}_${revision}")"
	case "${XBPS_TARGET_MACHINE}" in
	armv[67]l-musl) depends+=" musl1.1-devel" ;;
	*) depends+=" ${XBPS_TARGET_LIBC}-devel" ;;
	esac
	conflicts="clang18-devel clang17-devel clang15-devel"
	short_desc+=" - C language family frontend - development Files"
	homepage="https://clang.llvm.org/"
	pkg_install() {
		vmove "${_llvm_prefix}/include/clang"
		vmove "${_llvm_prefix}/include/clang-c"
		vmove "${_llvm_prefix}/lib/cmake/clang"
		vmove "${_llvm_prefix}/lib/libclang*.a"
		vmove "${_llvm_prefix}/lib/libclang*.so"
		vmove "${_llvm_prefix}/share/clang"
		if [ "$build_option_clang_tools_extra" ]; then
			vmove "${_llvm_prefix}/include/clang-tidy"
			vmove "${_llvm_prefix}/lib/libfindAllSymbols.a"
		fi
		if [ "$build_option_polly" ]; then
			vmove "${_llvm_prefix}/include/polly"
			vmove "${_llvm_prefix}/lib/cmake/polly"
			vmove "${_llvm_prefix}/lib/libPolly*.a"
		fi
	}
}

