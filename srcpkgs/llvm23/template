_join() {
	_OLDIFS=$IFS; IFS=';'
	echo "$*"
	IFS=$_OLDIFS
}

_enabled_projects=(
	$(vopt_if clang 'clang')
	$(vopt_if clang_tools_extra 'clang-tools-extra')
	$(vopt_if bolt 'bolt')
	$(vopt_if polly 'polly')
	$(vopt_if lldb 'lldb')
	$(vopt_if lld 'lld')
	$(vopt_if mlir 'mlir')
	$(vopt_if flang 'flang')
)

