#
# Workaround xbps not being able to replace the directory
# with a symlink due to installation/update ordering of other
# llvm packages owning files deep in the directory tree.
#
case "${ACTION}" in
post)
	mkdir -p usr/lib/clang
	rmdir usr/lib/clang/23
	ln -s ../llvm/23/lib/clang/23 usr/lib/clang/23
	;;
esac
