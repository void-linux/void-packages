do_install() {
    vmkdir usr/lib/losslesscut
    vcopy * usr/lib/losslesscut

    cat > lossless-cut << EOF
#!/bin/sh
exec /usr/lib/losslesscut/losslesscut "\$@"
EOF

    chmod 755 lossless-cut

    vbin lossless-cut
}
