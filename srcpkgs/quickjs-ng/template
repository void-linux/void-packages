# Template file for 'quickjs-ng'
pkgname=quickjs-ng
version=0.18.0
revision=1
build_style=meson
build_helper=qemu
short_desc="Next Generation Mighty JavaScript engine"
maintainer="Đoàn Trần Công Danh <congdanhqx@gmail.com>"
license="MIT"
homepage="https://quickjs-ng.github.io/quickjs/"
distfiles="https://github.com/quickjs-ng/quickjs/archive/refs/tags/v${version}.tar.gz"
checksum=28bcd89aa3683fd2a946537e5ce3f11cc46b5cbf3383c7561aaef3df5ff9f1dd
provides="quickjs-2026.10_1"
alternatives="
 quickjs:qjs:/usr/bin/ng-qjs
 quickjs:qjsc:/usr/bin/ng-qjsc
"

post_install() {
	mv $DESTDIR/usr/bin/qjs $DESTDIR/usr/bin/ng-qjs
	mv $DESTDIR/usr/bin/qjsc $DESTDIR/usr/bin/ng-qjsc
}

libquickjs-ng_package() {
	short_desc+=" - libraries"
	pkg_install() {
		vmove "usr/lib/*.so.*"
		vlicense LICENSE
	}
}

quickjs-ng-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/share/doc
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
