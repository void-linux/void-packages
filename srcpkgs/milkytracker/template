# Template file for 'milkytracker'
pkgname=milkytracker
version=1.06
revision=1
build_style=cmake
configure_args="-DCMAKE_INSTALL_DOCDIR=share/doc/${pkgname}"
hostmakedepends="pkg-config"
makedepends="SDL2-devel zlib-devel jack-devel alsa-lib-devel rtmidi-devel
 lhasa-devel zziplib-devel"
depends="libjack"
short_desc="Fast Tracker II inspired music tracker"
maintainer="Rutpiv <roger_freitas@live.com>"
license="GPL-3.0-or-later, BSD-3-Clause"
homepage="https://milkytracker.org/"
changelog="https://raw.githubusercontent.com/milkytracker/MilkyTracker/master/ChangeLog.md"
distfiles="https://github.com/milkytracker/MilkyTracker/archive/v${version}.tar.gz"
checksum=6e70590dfed324e6d6ac813e33d9f9dcfaa13b2f57fdec9e178e9dda05538cb0

post_install() {
	vinstall resources/milkytracker.desktop 644 usr/share/applications
	vinstall resources/pictures/carton.png 644 \
		usr/share/icons/hicolor/128x128/apps milkytracker.png
	vinstall build/resources/org.milkytracker.MilkyTracker.metainfo.xml 644 \
		usr/share/metainfo

	# BSD-3-Clause text is only in source headers
	sed -n '1,/^ \*\/$/p' src/milkyplay/MilkyPlay.h >LICENSE.BSD
	vlicense LICENSE.BSD
}

milkytracker-doc_package() {
	short_desc+=" - documentation"
	pkg_install() {
		vmove usr/share/doc
	}
}
