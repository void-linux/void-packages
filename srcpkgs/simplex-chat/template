# Template file for 'simplex-chat'
pkgname=simplex-chat
version=7.0.3
revision=1
archs="~i686"
build_style=cabal
build_helper="haskell"
cabal_index_state="2023-12-12T00:00:00Z"
hostmakedepends="ghc cabal-install cmake patchelf pkg-config xz openjdk17 openjdk17-jmods gradle"
makedepends="libffi-devel openssl-devel zlib-devel gmp-devel ncurses-devel"
short_desc="Private and secure messaging application (CLI)"
maintainer="rayfadh <rayfadh@duck.com>"
license="AGPL-3.0-only"
homepage="https://simplex.chat"
_nanohttpd_commit=efb2ebf85a2b06f7c508aba9eaad5377e3a01e81
distfiles="https://github.com/simplex-chat/simplex-chat/archive/refs/tags/v${version}.tar.gz
 https://github.com/NanoHttpd/nanohttpd/archive/${_nanohttpd_commit}.tar.gz>nanohttpd-${_nanohttpd_commit}.tar.gz"
checksum="c18564539d89d66bde13cc6427905fa66a05c77d629367691d0ee029220bd592
 8bde764f2d17e6d6ee3f24b07a048dff0dd1fb1547e7910665fdd0bbce0fa039"
skip_extraction="nanohttpd-${_nanohttpd_commit}.tar.gz"
case "$XBPS_TARGET_MACHINE" in *-musl) hostmakedepends+=" gcompat" ;; esac

nocross="cabal does not support cross compilation"
nopie_files="/usr/bin/simplex-chat"
make_check=no # testing hangs

_allow_newer="base,template-haskell,text,bytestring,process,deepseq,time,unix,containers,filepath,directory"

post_extract() {
	# nanohttpd is a git submodule, absent from the tag tarball
	vsrcextract -C apps/multiplatform/external/nanohttpd/upstream \
		"nanohttpd-${_nanohttpd_commit}.tar.gz"
}

post_configure() {
	printf 'allow-newer: %s\n' "${_allow_newer}" >> cabal.project.local
	printf 'package cryptostore\n    flags: +use_crypton\n' >> cabal.project.local
	printf 'constraints: zip +disable-bzip2 +disable-zstd\n' >> cabal.project.local
	printf 'package direct-sqlcipher\n    flags: +openssl\n' >> cabal.project.local
}

do_build() {
	cabal build -O1 exe:simplex-chat

	_ghc_ver=$(ghc --numeric-version)
	sed -i "s/GHC_VERSION=9.6.3/GHC_VERSION=${_ghc_ver}/" scripts/desktop/build-lib-linux.sh
	sed -i 's/patchelf --replace-needed "libffi.so.7"/# patchelf --replace-needed "libffi.so.7"/' \
		scripts/desktop/build-lib-linux.sh
	# use system vlc via jna.library.path
	sed -i 's|scripts/desktop/prepare-vlc-linux.sh|# skipped: using system libvlc|' \
		scripts/desktop/build-lib-linux.sh
	./scripts/desktop/build-lib-linux.sh

	# disable upstream auto-update
	sed -i 's/setupUpdateChecker()/\/\/setupUpdateChecker()/' \
		apps/multiplatform/desktop/src/jvmMain/kotlin/chat/simplex/desktop/Main.kt
	sed -i 's/showAppUpdateNotice()/\/\/showAppUpdateNotice()/' \
		apps/multiplatform/desktop/src/jvmMain/kotlin/chat/simplex/desktop/Main.kt

	# build desktop, exclude :android
	cd apps/multiplatform
	sed -i 's/include(":android", ":desktop", ":common", ":external:nanohttpd")/include(":desktop", ":common", ":external:nanohttpd")/' \
		settings.gradle.kts
	export JAVA_HOME=/usr/lib/jvm/openjdk17
	gradle --no-daemon -Dorg.gradle.vfs.watch=false :desktop:createDistributable

	# fix RPATH: haskell .so files must find each other via $ORIGIN, not build paths
	_res_dir="${wrksrc}/apps/multiplatform/release/main/app/simplex/lib/app/resources"
	find "${_res_dir}" -name "lib*.so" -exec patchelf --set-rpath '$ORIGIN' {} \;
}

do_install() {
	vbin "$(cabal list-bin exe:simplex-chat)"
	vlicense LICENSE
}

simplex-chat-desktop_package() {
	archs="~i686"
	short_desc="Private and secure messaging application (GUI)"
	# vlcj NativeDiscovery finds libvlc.so.5 at runtime via jna.library.path=/usr/lib
	# set in the launcher script; system vlc replaces the bundled AppImage entirely
	depends="simplex-chat libvlc libX11 libXext libXrender libXtst libnotify
	 libcanberra libXcursor libXi fontconfig freetype libGL dbus libpng brotli bzip2
	 alsa-lib giflib libjpeg-turbo lcms2 libnuma dejavu-fonts-ttf"
	pkg_install() {
		vmkdir usr/lib/simplex-chat
		vcopy apps/multiplatform/release/main/app/simplex usr/lib/simplex-chat
		case "$XBPS_TARGET_MACHINE" in
			x86_64) _interp=/usr/lib64/ld-linux-x86-64.so.2 ;;
			x86_64-musl) _interp=/usr/lib/ld-musl-x86_64.so.1 ;;
			aarch64) _interp=/usr/lib/ld-linux-aarch64.so.1 ;;
			aarch64-musl) _interp=/usr/lib/ld-musl-aarch64.so.1 ;;
			*) _interp=/usr/lib64/ld-linux-x86-64.so.2 ;;
		esac
		patchelf --set-interpreter "${_interp}" \
			"${PKGDESTDIR}/usr/lib/simplex-chat/simplex/bin/simplex"

		# remove bundled vlc. system libvlc is used
		# instead via jna.library.path in the launcher. vlcj uses default NativeDiscovery
		# with no custom path logic (VLC_PLUGIN_PATH setenv is commented out upstream).
		rm -rf "${PKGDESTDIR}/usr/lib/simplex-chat/simplex/lib/app/resources/vlc"

		# remove forbidden lib64 symlink generated by gradle
		rm -rf "${PKGDESTDIR}/usr/lib64"

		vbin "${FILESDIR}/simplex-chat.sh" simplex-chat-gui
		vinstall "${FILESDIR}/simplex-chat.desktop" 644 usr/share/applications
		vinstall apps/multiplatform/desktop/src/jvmMain/resources/distribute/simplex.png \
			644 usr/share/icons/hicolor/256x256/apps simplex.png
		# vcopy preserves Gradle's 644 on .so files; the linker
		# requires execute permission to dlopen them
		find "${PKGDESTDIR}/usr/lib/simplex-chat" -name "*.so" -exec chmod 755 {} \;
		find "${PKGDESTDIR}/usr/lib/simplex-chat" -name "*.so.*" -exec chmod 755 {} \;
	}
}
