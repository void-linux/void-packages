# Template file for 'toshiba-estudio-cups'
pkgname=toshiba-estudio-cups
version=7.119.4.0
revision=1
depends="cups cups-filters perl"
short_desc="CUPS PPDs and filter for Toshiba e-STUDIO multifunction printers"
maintainer="Gonzalo Tornaría <tornaria@cmat.edu.uy>"
license="GPL-2.0-or-later AND custom:Proprietary"
homepage="https://www.toshibatec.eu/support/drivers/"
distfiles="https://downloads.toshibatec.eu/publicsite-service/resource/download/pseu/en/c47a2f8b-f1fb-47cb-8a6b-6a758250916c/f44b2902712bb59bad54b674cf52ad96/TOSHIBA%20e-STUDIO%20CUPS%20PPD%20%5BV.${version}%5D.zip>${pkgname}-${version}.zip"
checksum=6cdc57fc25522799420aff01b2e09848a45eed32726d8cbdaa6b2113962ff30d
repository=nonfree

do_install() {
	local tarball
	# Each tarball holds one PPD plus the perl filter it references
	# (est856_Authentication for mono, est6550_Authentication for colour).
	# The "2-sided_default" variants only differ in *DefaultDuplex.
	for tarball in BW/normal/TOSHIBA_MonoMFP_CUPS.tar \
		Colour/normal/TOSHIBA_ColorMFP_CUPS.tar; do
		vextract --no-strip-components -C extracted "$tarball"
	done
	# The filter shells out to domainname(1) (NIS), which Void does not
	# ship; drop the call so every job isn't logged with perl warnings.
	vsed -i extracted/usr/lib/cups/filter/est*_Authentication \
		-e 's/\x60domainname\x60/""/'
	vinstall extracted/usr/share/cups/model/Toshiba/TOSHIBA_MonoMFP_CUPS.gz \
		644 usr/share/cups/model/Toshiba
	vinstall extracted/usr/share/cups/model/Toshiba/TOSHIBA_ColorMFP_CUPS.gz \
		644 usr/share/cups/model/Toshiba
	vinstall extracted/usr/lib/cups/filter/est856_Authentication \
		755 usr/lib/cups/filter
	vinstall extracted/usr/lib/cups/filter/est6550_Authentication \
		755 usr/lib/cups/filter
	# The PPDs are GPL-2.0-or-later; the filter and ReadMe are not.
	vlicense ReadMe.txt
}
