# Template file for 'ampache'
pkgname=ampache
version=8.0.1
revision=1
create_wrksrc=yes
hostmakedepends="unzip"
depends="php8.5"
short_desc="Web-based tool for managing your audio/video files"
maintainer="Orphaned <orphan@voidlinux.org>"
license="AGPL-3.0-or-later"
homepage="https://ampache.org"
distfiles="https://github.com/ampache/ampache/releases/download/${version}/${pkgname}-${version}_php8.5.zip"
checksum=a5b28001e6d100e079ccdbcd5600d4374743e111a0a0eb386e9aba58d02fa54f

do_install() {
	vmkdir usr/share/webapps/${pkgname}
	cp -rT ${wrksrc} ${DESTDIR}/usr/share/webapps/${pkgname}
	vlicense LICENSE.md
	# vendored python2, unused
	rm -f ${DESTDIR}/usr/share/webapps/${pkgname}/vendor/sabre/dav/bin/naturalselection
	rm -f ${DESTDIR}/usr/share/webapps/${pkgname}/vendor/bin/naturalselection
}
