# Template file for 'kisslock'
pkgname=kisslock
version=0.1
revision=1
build_style=gnu-makefile
make_use_env=yes
make_build_args="VERSION=${version}"
conf_files="/etc/pam.d/kisslock"
hostmakedepends="pkg-config wayland-devel"
makedepends="libxkbcommon-devel pam-devel wayland-devel wayland-protocols"
short_desc="Simple screen locker for Wayland"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://github.com/Greenstorm5417/kisslock"
changelog="https://github.com/Greenstorm5417/kisslock/releases"
distfiles="https://github.com/Greenstorm5417/kisslock/archive/refs/tags/v${version}.tar.gz"
checksum=3763518adbd54e98205fd56c340fd694388ea60dddc96499797de4071eb3276c

pre_build() {
	vsed -e 's/^CC = cc/CC ?= cc/' \
		-e 's/^PKG_CONFIG = pkg-config/PKG_CONFIG ?= pkg-config/' \
		-e 's|^WAYLAND_SCANNER = .*|WAYLAND_SCANNER = wayland-scanner|' \
		-i Makefile
}

post_install() {
	vlicense LICENSE
}
