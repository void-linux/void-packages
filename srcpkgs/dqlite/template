# Template file for 'dqlite'
pkgname=dqlite
version=1.18.7
revision=1
build_style=gnu-configure
hostmakedepends="pkg-config automake libtool"
makedepends="sqlite-devel raft-devel"
short_desc="Distributed SQLite database using the Raft algorithm"
maintainer="Orphaned <orphan@voidlinux.org>"
license="LGPL-3.0-only, LGPL-3.0-linking-exception"
homepage="https://github.com/canonical/dqlite"
distfiles="https://github.com/canonical/dqlite/archive/refs/tags/v${version}.tar.gz"
checksum=7a9087460f3296313379e95a25761c88081c508ae0742bec6fb63e895eb807a9

if [ "$XBPS_TARGET_LIBC" = musl ]; then
	configure_args+=" --disable-backtrace"
fi

pre_configure() {
	autoreconf -i
}

dqlite-devel_package() {
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
	}
}
