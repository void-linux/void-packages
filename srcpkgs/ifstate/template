# Template file for 'ifstate'
pkgname=ifstate
version=2.5.1
revision=1
build_style=python3-pep517
depends="python3 python3-jsonschema python3-pyroute2 python3-setproctitle python3-shtab python3-yaml"
hostmakedepends="python3-setuptools uv-build ${depends}"
short_desc="Manage host interface settings in a declarative manner"
maintainer="Leah Neukirchen <leah@vuxu.org>"
license="GPL-3.0-or-later"
homepage="https://ifstate.net/"
changelog="https://codeberg.org/liske/ifstate/raw/branch/master/CHANGELOG.md"
distfiles="https://codeberg.org/liske/ifstate/archive/${version}.tar.gz"
checksum=c113e7fe66b2d905aec0a01e4a168191d44374b3d88fe998863761f11f1618d8

post_install() {
	vsv ifstate
	for _shell in bash zsh; do
		./scripts/package-completion-gen.sh ${_shell} > ifstate.${_shell}
		vcompletion ifstate.${_shell} ${_shell}
	done
}
