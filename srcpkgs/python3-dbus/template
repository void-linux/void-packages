# Template file for 'python3-dbus'
pkgname=python3-dbus
version=1.5.1
revision=1
build_style=meson
configure_args="-Dpython=python${py3_ver}"
hostmakedepends="pkg-config python3-packaging-bootstrap"
makedepends="dbus-devel libglib-devel python3-devel"
depends="python3 dbus"
checkdepends="${depends} python3-gobject"
short_desc="D-Bus Python3 bindings"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT AND (GPL-2.0-or-later OR AFL-2.1)"
homepage="https://www.freedesktop.org/wiki/Software/DBusBindings"
changelog="https://gitlab.freedesktop.org/dbus/dbus-python/-/raw/master/NEWS"
distfiles="${PYPI_SITE}/d/dbus-python/dbus_python-${version}.tar.gz"
checksum=57423cf87d09b7d084f420b55b737fe654c33339b06df77945620d97795c6ac4
lib32disabled=yes

if [ "$XBPS_CHECK_PKGS" ]; then
	configure_args+=" -Dtests=enabled"
else
	configure_args+=" -Dtests=disabled"
fi

post_install() {
	vinstall PKG-INFO 644 ${py3_sitelib} dbus_python-${version}-py${py3_ver}.egg-info
	vlicense COPYING
}

python3-dbus-devel_package() {
	depends="python3-devel python3-dbus>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
	}
}
