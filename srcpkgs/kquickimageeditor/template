# Template file for 'kquickimageeditor'
pkgname=kquickimageeditor
version=0.7.0.1
revision=1
build_style=cmake
hostmakedepends="extra-cmake-modules kf6-kconfig qt6-base qt6-tools
 qt6-declarative-host-tools qt6-shadertools"
makedepends="kf6-kconfig-devel qt6-base-devel qt6-declarative-devel
 qt6-shadertools-devel highway-devel"
short_desc="QML image editing components"
maintainer="Orphaned <orphan@voidlinux.org>"
license="LGPL-2.1-or-later, BSD-2-Clause, CC0-1.0"
homepage="https://invent.kde.org/libraries/kquickimageeditor"
distfiles="${KDE_SITE}/kquickimageeditor/kquickimageeditor-${version}.tar.xz"
checksum=b65f32c44bd126cea5e1b5a6eb7cb0eb517277cb8de06675fa6be624b7da381a

# Highway disables Scalar EMU128 Fallback with gcc <16
# Force it for armv6 and use neon for armv7l and SSE2 for i686
case "$XBPS_TARGET_MACHINE" in
	armv7l*) CXXFLAGS="-mfpu=neon-vfpv4";;
	armv6l*) CXXFLAGS="-DHWY_BROKEN_EMU128=0";;
	i686*) CXXFLAGS="-msse2 -mfpmath=sse";;
esac

post_install() {
	vlicense LICENSES/BSD-2-Clause.txt
}

kquickimageeditor-devel_package() {
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/qt6/mkspecs
	}
}
