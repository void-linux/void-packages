# Template file for 'portablemc-cli'
pkgname=portablemc-cli
version=5.0.6
revision=1
build_style=cargo
hostmakedepends="cargo rust"
makedepends="openssl-devel"

short_desc="Minecraft launcher with Mojang and mod loader support"
maintainer="kpnc0 <xpz4yx@gmail.com>"
license="Apache-2.0"
homepage="https://github.com/theorzr/portablemc"
changelog="https://github.com/theorzr/portablemc/releases"
distfiles="${homepage}/archive/refs/tags/v${version}.tar.gz"
checksum=421b9c95ccc8902050756fb31a43a63aa340eab871cb9d18c2a905b043f9cb3c

do_build() {
    cd "${wrksrc}"
    export PMC_VERSION_LONG="pkgbuild: ${version}-${revision}"
    export PMC_NO_ARCHIVE=y
    cargo xtask dist
}

do_check() {
    cd "${wrksrc}"
    export PMC_VERSION_LONG="pkgbuild: ${version}-${revision}"
    cargo test --release --locked
}

do_install() {
    cd "${wrksrc}/dist/portablemc-${version}"

    vbin portablemc
    vdoc README
    vlicense LICENSE

    vmkdir usr/share/man/man1
    ./portablemc gen man "${DESTDIR}/usr/share/man/man1"
}
