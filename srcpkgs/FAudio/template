# Template file for 'FAudio'
pkgname=FAudio
version=26.11
revision=1
build_style=cmake
configure_args="-DSDL3_INCLUDE_DIRS=${XBPS_CROSS_BASE}/usr/include/SDL3
 -DSDL3_LIBRARIES=${XBPS_CROSS_BASE}/usr/lib/libSDL3.so"
hostmakedepends="pkg-config"
makedepends="SDL3-devel"
short_desc="Accuracy-focused XAudio reimplementation for open platforms"
maintainer="Orphaned <orphan@voidlinux.org>"
license="Zlib"
homepage="https://github.com/FNA-XNA/FAudio"
distfiles="https://github.com/FNA-XNA/FAudio/archive/refs/tags/${version}.tar.gz"
checksum=8fcd197678ad1ab5c95f0901c3770d8d76c1d8b1da819f6873db599807ad7d03

post_install() {
	vlicense LICENSE
}

FAudio-devel_package() {
	short_desc+=" - development files"
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/cmake
		vmove usr/share
		vmove usr/lib/pkgconfig
	}
}
