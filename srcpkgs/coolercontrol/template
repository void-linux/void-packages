# Template file for 'coolercontrol'
pkgname=coolercontrol
version=5.0.1
revision=1
build_style=cmake
build_wrksrc=coolercontrol
build_helper="rust"
hostmakedepends="cargo cmake nodejs qt6-base qt6-declarative-host-tools"
makedepends="libdrm-devel qt6-base-devel qt6-webengine-devel MesaLib-devel rust-std"
depends="coolercontrold>=${version}_${revision} hicolor-icon-theme"
short_desc="Application for monitoring and controlling supported cooling devices"
maintainer="Joshua Kloepfer <joshua.kloepfer@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://gitlab.com/coolercontrol/coolercontrol"
changelog="https://gitlab.com/coolercontrol/coolercontrol/-/releases"
distfiles="https://gitlab.com/coolercontrol/coolercontrol/-/archive/${version}/coolercontrol-${version}.tar.gz"
checksum=4a501b379ff1d26458473747bd8cd9a090ba62937d0bf8765b948bd251b20dbe
if [ "$XBPS_TARGET_WORDSIZE" = 32 ]; then
	broken="qt6-webengine-devel not supported"
fi

post_build() {
	cd ..
	make CARGO_BUILD_TARGET="$RUST_TARGET" build-daemon
}

post_install() {
	cd ..
	vbin coolercontrold/target/$RUST_TARGET/release/coolercontrold
	make DESTDIR="$DESTDIR" install-data
}

coolercontrold_package() {
	short_desc="Background daemon for coolercontrol"
	pkg_install() {
		vsv coolercontrold
		vman ../packaging/man/coolercontrold.8
		vmove usr/bin/coolercontrold
	}
}
