# Template file for 'smartdns'
pkgname=smartdns
version=48.4
revision=1
build_style=gnu-makefile
make_build_args="WITH_UI=1 VER=${version} OPTIMIZE_SIZE=1"
make_install_args="PREFIX=/usr SBINDIR=/usr/bin"
hostmakedepends="pkg-config rust cargo clang"
makedepends="libuv-devel openssl-devel"
conf_files="/etc/smartdns/smartdns.conf"
short_desc="Local DNS server to obtain the fastest website IP"
maintainer="tomcup <jiligulu7755@outlook.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pymumu/smartdns"
changelog="https://github.com/pymumu/smartdns/releases"
# UI version is independent of the main program; check upstream for
# a matching UI release when bumping smartdns.
_ui_version="1.0.0"
distfiles="https://github.com/pymumu/smartdns/archive/refs/tags/Release${version}.tar.gz
 https://github.com/pymumu/smartdns-webui/releases/download/v${_ui_version}/smartdns-ui-v${_ui_version}.tar.gz"
checksum="b07abba99e921f262ba47588e12f5b36dd849f79c0145542440eb6b7eed80553
 48bfe90bf6267f77a4a1a828d8c570e3155bf61b7cb914f644b799adb3a7ed47"
skip_extraction="smartdns-ui-v${_ui_version}.tar.gz"

post_extract() {
	mkdir -p "${wrksrc}/ui"
	vsrcextract -C "${wrksrc}/ui" --no-strip-components "smartdns-ui-v${_ui_version}.tar.gz"
}

post_install() {
	cd "${wrksrc}"

	rm -f "${DESTDIR}/smartdns.service"
	rm -rf "${DESTDIR}/etc/init.d"
	rm -f "${DESTDIR}/etc/default/smartdns"
	rmdir "${DESTDIR}/etc/default" 2>/dev/null || true

	chmod 0644 "${DESTDIR}/etc/smartdns/smartdns.conf"

	vinstall "${wrksrc}/plugin/smartdns-ui/target/smartdns_ui.so" 755 usr/lib/smartdns

	vmkdir usr/share/smartdns/wwwroot
	cp -a "${wrksrc}/ui/." "${DESTDIR}/usr/share/smartdns/wwwroot/"

	vlicense LICENSE
	vsv smartdns
}

smartdns-ui_package() {
	cd "${wrksrc}"
	license="MIT AND GPL-3.0-or-later"
	short_desc+=" - Web dashboard"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/lib/smartdns
		vmove usr/share/smartdns/wwwroot
		vlicense LICENSE
	}
}
