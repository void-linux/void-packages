pkgname=vscodium
version=1.116.02821
revision=1
archs="x86_64"
wrksrc="VSCodium-linux-x64-${version}"
hostmakedepends="tar"
depends="libX11 libxkbfile libsecret libxkbcommon libxkbcommon-x11"
short_desc="Open-source distribution of Microsoft Visual Studio Code"
maintainer="metw0 <opensource@example.com>"
license="MIT"
homepage="https://vscodium.com"
distfiles="https://github.com/VSCodium/vscodium/releases/download/${version}/VSCodium-linux-x64-${version}.tar.gz"
checksum=82c7173d6aa7415f6777d5d66cbe58902772c719c30c46385a9140831e46edad

do_install() {
    vmkdir usr/lib/${pkgname}
    cp -a . ${DESTDIR}/usr/lib/${pkgname}
    vmkdir usr/bin
    ln -s /usr/lib/${pkgname}/bin/codium ${DESTDIR}/usr/bin/vscodium
}

