# Template file for 'bees'
pkgname=bees
version=0.11
revision=1
archs="x86_64* i686* aarch64* armv[67]l*"
build_style=gnu-makefile
_make_args="BEES_VERSION=${version} LIBEXEC_PREFIX=usr/bin SYSTEMD_SYSTEM_UNIT_DIR="
make_build_args="${_make_args} DEFAULT_MAKE_TARGET=all"
make_check_args="${_make_args}"
make_check_target="test"
depends="bash btrfs-progs util-linux"
short_desc="Best-Effort Extent-Same, a btrfs deduplication agent"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://github.com/Zygo/bees"
distfiles="https://github.com/Zygo/bees/archive/refs/tags/v${version}.tar.gz"
checksum=191caa0d6557f346fec1585743c8b76ca4a40bd6462660a45ec7888753a5cd41
conf_files="/etc/bees.conf"

if [ "$XBPS_TARGET_NO_ATOMIC8" ]; then
	CXXFLAGS+=" -latomic"
fi

do_install() {
	vbin bin/bees
	vbin scripts/beesd
	vconf scripts/beesd.conf.sample bees.conf
	vsconf scripts/beesd.conf.sample
	vmkdir etc/bees
	ln -s ../bees.conf "${DESTDIR}/etc/bees/bees.conf"
	vsv beesd
}
