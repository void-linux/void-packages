# Template file for 'lxd'
pkgname=lxd
version=6.9
revision=1
build_style=go
go_import_path=github.com/canonical/lxd
go_build_tags=libsqlite3
go_package="${go_import_path}/lxd
 ${go_import_path}/lxc
 ${go_import_path}/lxd-convert
 ${go_import_path}/fuidshift
 ${go_import_path}/lxd-benchmark
 ${go_import_path}/lxd-user"
hostmakedepends="pkg-config git"
makedepends="lxc-devel acl-devel dqlite-devel eudev-libudev-devel"
depends="lxc acl acl-progs rsync squashfs-tools xz dnsmasq iptables attr-progs dqlite>=1.18.7"
short_desc="Next generation system container manager"
maintainer="Orphaned <orphan@voidlinux.org>"
license="Apache-2.0"
homepage="https://linuxcontainers.org/lxd"
changelog="https://github.com/canonical/lxd/releases"
distfiles="https://github.com/canonical/lxd/archive/refs/tags/lxd-${version}.tar.gz"
checksum=569f135a74652203fe9cd2cd713c7eb1b692b845d78c0c25c742efd49e3ec49d
system_groups="lxd"

# whitelist dqlite LDFLAGS
export CGO_LDFLAGS_ALLOW='-Wl,-z,now'

post_build() {
	CGO_ENABLED=0 go install -p "$XBPS_MAKEJOBS" -mod=readonly -tags "agent,netgo" -ldflags "${go_ldflags}" "${go_import_path}/lxd-agent"
	CGO_ENABLED=0 go install -p "$XBPS_MAKEJOBS" -mod=readonly -tags "netgo" -ldflags "${go_ldflags}" "${go_import_path}/lxd-convert"
}

post_install() {
	if [ -z "$CROSS_BUILD" ]; then
		"${GOPATH}/bin/lxc" completion bash > "${wrksrc}/lxc.bash"
		vcompletion "${wrksrc}/lxc.bash" bash lxc
	fi
	vsv lxd
	vdoc "${FILESDIR}/README.voidlinux"
}
