# Template file for 'brave-origin'
pkgname=brave-origin
version=1.94.117
revision=1
archs="x86_64"

build_style=fetch

hostmakedepends="unzip"

short_desc="Brave Origin web browser"
maintainer="DankDown10256 <lucasp.linux@gmail.com>"
license="MPL-2.0"
homepage="https://brave.com/"

distfiles="https://github.com/brave/brave-browser/releases/download/v${version}/brave-origin-${version}-linux-amd64.zip"
checksum="c821c649fc17d451764a771d2b5da5e00515c4d531fdf4896548ca86da3b531e"

do_install() {
	vmkdir opt/brave-origin

	unzip "brave-origin-${version}-linux-amd64.zip" \
		-d "${DESTDIR}/opt/brave-origin"

	chmod +x "${DESTDIR}/opt/brave-origin/brave"

	vbin "${FILESDIR}/brave-origin"
}
