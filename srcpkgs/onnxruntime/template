# Template file for 'onnxruntime'
pkgname=onnxruntime
version=1.29.0
revision=1
_GSL_ver=4.2.1
build_style=cmake
build_wrksrc=cmake
configure_args="
 --compile-no-warning-as-error
 -Donnxruntime_USE_FULL_PROTOBUF=ON
 -Donnxruntime_BUILD_SHARED_LIB=ON
 -Donnxruntime_ENABLE_PYTHON=ON
 -Donnxruntime_ENABLE_TRAINING=OFF
 -Donnxruntime_USE_TELEMETRY=OFF
 -DONNX_CUSTOM_PROTOC_EXECUTABLE=/usr/bin/protoc
 -DFETCHCONTENT_FULLY_DISCONNECTED=ON
 -DFETCHCONTENT_TRY_FIND_PACKAGE_MODE=ALWAYS"
hostmakedepends="pkg-config protobuf flatbuffers python3-setuptools python3-packaging python3-installer python3-numpy"
makedepends="abseil-cpp-devel protobuf-devel re2-devel json-c++ gtest-devel
 chrono-date-devel boost-devel libcpuinfo-devel gsl-devel flatbuffers-devel
 onnx-devel eigen SafeInt python3-pybind11 dlpack python3-numpy"
short_desc="High performance ML inferencing and training accelerator"
maintainer="Duncaen <duncaen@voidlinux.org>"
license="MIT"
homepage="https://onnxruntime.ai/"
changelog="https://github.com/microsoft/onnxruntime/releases"
distfiles="https://github.com/microsoft/onnxruntime/archive/refs/tags/v${version}.tar.gz
 https://github.com/microsoft/GSL/archive/refs/tags/v${_GSL_ver}.tar.gz>GSL-v${_GSL_ver}.tar.gz"
checksum="0f065cfd3816eaa4b709a057ea0e237ebc6463843af44a439e0d81af76d6620e
 d959f1cb8bbb9c94f033ae5db60eaf5f416be1baa744493c32585adca066fe1f"

# currently broken with -Donnxruntime_BUILD_SHARED_LIB=ON
configure_args+=" -Donnxruntime_BUILD_UNIT_TESTS=OFF"

skip_extraction="GSL-v${_GSL_ver}.tar.gz"

LDFLAGS="-Wl,-z,noexecstack"
case $XBPS_TARGET_MACHINE in
i686*) CXXFLAGS="-mfpmath=sse -msse2" ;;
esac

post_extract() {
	vsrcextract -C cmake/build/_deps/gsl-src "GSL-v${_GSL_ver}.tar.gz"
	vsed -e 's/-Werror//g' -i cmake/build/_deps/gsl-src/tests/CMakeLists.txt
}

pre_build() {
	# generated headers need to match the flatbuffers version, since we use the system one, regen
	python3 "${wrksrc}/onnxruntime/lora/adapter_format/compile_schema.py" --flatc /usr/bin/flatc
	python3 "${wrksrc}/onnxruntime/core/flatbuffers/schema/compile_schema.py" --flatc /usr/bin/flatc
}

post_build() {
	(
		cd build
		# python -m build --wheel --no-isolation
		python "${wrksrc}/setup.py" bdist_wheel
	)
}

post_install() {
	vlicense "${wrksrc}/LICENSE"
	python3 -m installer --destdir "${DESTDIR}" \
		--no-compile-bytecode build/dist/*.whl
}

onnxruntime-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/lib/libonnxruntime.so
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/pkgconfig
	}
}

python3-onnxruntime_package() {
	depends="python3-flatbuffers python3-numpy python3-packaging python3-protobuf"
	short_desc+=" - Python3 bindings"
	pkg_install() {
		vlicense "${wrksrc}/LICENSE"
		vmove "usr/lib/python${py3_ver}"
		vmove usr/bin/onnxruntime_test
	}
}
