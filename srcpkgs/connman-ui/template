# Template file for 'connman-ui'
pkgname=connman-ui
version=0.0.20150623
revision=1
build_style=gnu-configure
hostmakedepends="automake libtool glib-devel pkg-config gettext-devel"
makedepends="dbus-devel glib-devel gtk+3-devel"
short_desc="Full-featured GTK based trayicon UI for ConnMan"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-only"
homepage="https://github.com/tbursztyka/connman-ui"
distfiles="${homepage}/archive/${_gitrev}.tar.gz>${pkgname}-${version}.tar.gz"
distfiles="${DEBIAN_SITE}/main/c/connman-ui/connman-ui_0~${version##*.}.orig.tar.gz"
checksum=29c3f7c78dd4881e31fa7823dbfb9316274ad45bb6e56b1a7f6d60ee93ee7ba3
replaces="connman-ui-git>=0"

pre_configure() {
	cp /usr/bin/gettextize .
	sed -i '/read dummy/d' gettextize
	./gettextize -f
	sed '/PO_DEP/s/yes/no/' po/Makevars.template >po/Makevars
	autoreconf -fi
}
