# Template file for 'hyprland'
pkgname=hyprland
version=0.54.3
revision=3
build_style=cmake
hostmakedepends="
	hyprwayland-scanner
	pkgconf
	wayland-devel
"
makedepends="
	aquamarine
	cairo-devel
	glib-devel
	glaze
	hyprcursor
	hyprgraphics
	hyprlang
	hyprutils
	hyprwire-devel
	libdrm-devel
	libgbm-devel
	libglvnd-devel
	libinput-devel
	libXcursor-devel
	libxcb-devel
	libxkbcommon-devel
	libuuid-devel
	muparser-devel
	pango-devel
	pixman-devel
	re2-devel
	tomlplusplus-devel
	udis86-devel
	wayland-devel
	wayland-protocols
	xcb-util-errors-devel
	xcb-util-wm-devel
"
depends="xorg-server-xwayland"
short_desc="Dynamic tiling Wayland compositor that doesn't sacrifice on its looks"
maintainer="notnull <notnull@anarchyplanet.org>"
license="BSD-3-Clause"
homepage="https://hyprland.org/"
changelog="https://github.com/hyprwm/${pkgname}/releases"
distfiles="https://github.com/hyprwm/${pkgname}/releases/download/v${version}/source-v${version}.tar.gz"
checksum=3c20a191a6f23af75f9a8db636d690c6adc95931447f9d69fb20884ec04c63ee

subpackages="${pkgname}-devel hyprctl"

configure_args+=" --no-warn-unused-cli"
configure_args+=" -DNO_SYSTEMD:BOOL=true"

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
	configure_args+=" -DCMAKE_CXX_FLAGS=\"-lexecinfo\""
	makedepends+=" libexecinfo-devel"
	depends+=" libexecinfo"
fi

post_install() {
	vlicense LICENSE
}

pre_configure() {
	# GCC 14 does not support C23/C++26 #embed yet, so generate the byte include
	# from the example config at build time.
	od -An -v -t u1 "${wrksrc}/example/hyprland.conf" | awk '
		{
			for (i = 1; i <= NF; ++i)
				printf "    %s,\n", $i;
		}
	' >"${wrksrc}/src/config/defaultConfig.inc"
}

hyprland-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} ${makedepends}"
	short_desc="Dynamic tiling Wayland compositor - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/share/pkgconfig
	}
}

hyprctl_package() {
	short_desc="Control utility for Hyprland"
	pkg_install() {
		vmove usr/bin/hyprctl
		vmove usr/share/man/man1/hyprctl.1
		vmove usr/share/bash-completion/completions/hyprctl
		vmove usr/share/fish/vendor_completions.d/hyprctl.fish
		vmove usr/share/zsh/site-functions/_hyprctl
	}
}
