# Template file for 'libxkbfile'
pkgname=libxkbfile
version=1.2.0
revision=1
build_style=meson
configure_args="-Ddefault_library=both"
hostmakedepends="pkg-config"
makedepends="xorgproto libX11-devel"
short_desc="Xkbfile Library from X.org"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://www.x.org/"
distfiles="${XORG_SITE}/lib/libxkbfile-${version}.tar.xz"
checksum=7f71884e5faf56fb0e823f3848599cf9b5a9afce51c90982baeb64f635233ebf

post_install() {
	vlicense COPYING
}

libxkbfile-devel_package() {
	depends="xorgproto libX11-devel ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
