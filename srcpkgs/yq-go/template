checksum=fadf86d0ae3988bb40fa8aad424d0c71658493f6377285e711c7e7e313b3b238

post_install() {
	# this came after yq 'the jq wrapper for yaml' so yq has the right to
	# /usr/bin/yq, rename it to yq-go
	mv -v "${DESTDIR}"/usr/bin/{yq,yq-go}

	vlicense LICENSE
}
