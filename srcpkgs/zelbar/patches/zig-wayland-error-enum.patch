Backport of zig-wayland commit f8ff8c7a79 ("scanner: fix possible reference
to undefined Error enum") to zig-wayland 0.2.0.

wayland 1.26 added since="3" to the wl_shm::error and wl_shm_pool::error
enums. When generating those interfaces at a lower version, the scanner
skips the enum but still emits postError() referencing it.

https://codeberg.org/ifreund/zig-wayland/commit/f8ff8c7a79

--- a/deps/zig-wayland/src/scanner.zig
+++ b/deps/zig-wayland/src/scanner.zig
@@ -697,7 +697,9 @@
                 });
 
             const has_error = for (interface.enums) |e| {
-                if (mem.eql(u8, e.name, "error")) break true;
+                if (mem.eql(u8, e.name, "error") and e.since <= target_version) {
+                    break true;
+                }
             } else false;
             if (has_error) {
                 try writer.print(
