# Template file for 'openmsx'
pkgname=openmsx
version=22.0
revision=1
hostmakedepends="pkg-config python3"
makedepends="SDL2-devel glew-devel libao-devel libtheora-devel libvorbis-devel
 libpng-devel libxml2-devel SDL2_ttf-devel tcl-devel"
short_desc="MSX emulator that aims for perfection"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-only"
homepage="https://openmsx.org"
changelog="https://raw.githubusercontent.com/openMSX/openMSX/master/doc/release-history.txt"
distfiles="https://github.com/openMSX/openMSX/releases/download/RELEASE_${version//\./_}/openmsx-${version}.tar.gz"
checksum=f6d5ff89c62d32447dd5f731ff653d26a2a3c4ac6e86ea4f1bda3c4f8ad98c5d

# nocross="can't use CXX prefixed with triplet"

CXXFLAGS="-Wno-narrowing -O3"

# case "$XBPS_TARGET_MACHINE" in
# 	i686*) broken="can't find C++ compiler despite being given it"
# esac

# do_configure() {
# 	make -f build/main.mk probe
# }

export OPENMSX_FLAVOUR=void
export OPENMSX_TARGET_OS=linux
case "$XBPS_TARGET_MACHINE" in
	x86_64*) export OPENMSX_TARGET_CPU=x86_64 ;;
	i686*) export OPENMSX_TARGET_CPU=x86 ;;
	aarch64*) export OPENMSX_TARGET_CPU=aarch64 ;;
	armv[67]*) export OPENMSX_TARGET_CPU=arm ;;
esac
export TCL_CONFIG=${XBPS_CROSS_BASE}/usr/lib

do_configure() {
	cat <<-EOF >build/flavour-void.mk
	CXXFLAGS += ${CXXFLAGS}
	LDFLAGS += ${LDFLAGS//-Wl,/}
	OPENMSX_STRIP := false
	EOF
	cat <<-EOF >build/custom.mk
	INSTALL_BASE := /usr/share/openmsx
	INSTALL_SHARE_DIR := /usr/share/openmsx
	INSTALL_BINARY_DIR := /usr/bin
	VERSION_EXEC := false
	SYMLINK_FOR_BINARY := false
	INSTALL_CONTRIB := true
	EOF
	make -f build/main.mk probe
}

do_build() {
	make ${makejobs}
}

do_install() {
	make DESTDIR=${DESTDIR} install
}
