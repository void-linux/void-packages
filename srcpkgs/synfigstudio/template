# Template file for 'synfigstudio'
# Should be kept in sync with 'synfig' and 'ETL'
pkgname=synfigstudio
version=1.4.5
revision=3
build_style=gnu-configure
configure_args="--disable-update-mimedb
 ac_cv_path_INTLTOOL_UPDATE=/usr/bin/false
 ac_cv_path_INTLTOOL_MERGE=/usr/bin/false
 ac_cv_path_INTLTOOL_EXTRACT=/usr/bin/false
 ac_cv_path_INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="pkg-config gettext synfig"
makedepends="ETL synfig-devel boost-headers gtkmm-devel libltdl-devel
 libmagick-devel"
short_desc="Vector based 2D animation studio"
maintainer="newbluemoon <blaumolch@mailbox.org>"
license="GPL-2.0-or-later"
homepage="https://www.synfig.org/"
distfiles="https://github.com/synfig/synfig/releases/download/v${version}/synfigstudio-${version}.tar.gz"
checksum=82a2d8a6d03f72443f8ddeb9d7ea38214313c1ac56f4ddba3e872464e8f91568
python_version=3
CXXFLAGS="-Wno-deprecated-copy -DHAVE_LOCALE_H=1"

post_patch() {
	vsed -i configure -e '
		/DATADIRNAME=/s/=.*/=share/
		/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.35.1/
	'
	vsed -i 's/^_//' org.synfig.SynfigStudio.desktop.in
	vsed -i 's/[<]_/</;s;[<][/]_;</;' org.synfig.SynfigStudio.appdata.xml.in
}

post_configure() {
	local file output
	msgfmt --desktop -d po \
		--template org.synfig.SynfigStudio.desktop.in \
		-o org.synfig.SynfigStudio.desktop
	msgfmt --xml -d po \
		--template org.synfig.SynfigStudio.appdata.xml.in \
		-o org.synfig.SynfigStudio.appdata.xml
	mkdir -p its
	cat <<-EOF >its/synfig.its
	<?xml version="1.0"?>
	<its:rules xmlns:its="http://www.w3.org/2005/11/its" version="2.0">
	  <its:translateRule selector="//*" translate="no"/>
	  <its:translateRule selector="//plugin/name" translate="yes"/>
	</its:rules>
	EOF
	cat <<-EOF >its/synfig.loc
	<?xml version="1.0"?>
	<locatingRules>
	  <locatingRule name="synfig" pattern="plugin.xml" target="synfig.its" />
	</locatingRules>
	EOF
	for file in plugins/*/plugin.xml.in; do
		output=${file%.in}
		vsed -i 's/[<]_/</;s;[<][/]_;</;' $file
		GETTEXTDATADIRS=$PWD \
		msgfmt --xml -d po --template $file -o $output
	done
}

synfigstudio-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
	}
}
