# Template file for 'privoxy'
pkgname=privoxy
version=4.1.0
revision=1
build_style=gnu-configure
configure_args="
 --sysconfdir=/etc/privoxy
 --enable-compression
 --enable-dynamic-pcre
 --sbindir=/usr/bin"
make_install_args="STRIP="
conf_files="
 /etc/privoxy/config
 /etc/privoxy/default.action
 /etc/privoxy/match-all.action
 /etc/privoxy/user.filter
 /etc/privoxy/trust
 /etc/privoxy/default.filter
 /etc/privoxy/user.action"
hostmakedepends="autoconf"
makedepends="pcre2-devel zlib-devel"
short_desc="Non-caching web proxy with advanced filtering capabilities"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="http://www.privoxy.org/"
distfiles="${SOURCEFORGE_SITE}/ijbswa/privoxy-${version}-stable-src.tar.gz"
checksum=23e4686e5848c74cb680c09c2811f0357739ecfe641f9c4072ee42399092c97b
system_accounts="privoxy"
privoxy_homedir="/etc/privoxy"

pre_configure() {
	autoheader && autoconf

	vsed -e 's|^confdir .*|confdir /etc/privoxy|' \
		-e 's|^logdir .*|logdir /var/log/privoxy|' \
		-e 's|^\(logfile .*\)|# \1|' \
		-i config
}

post_install() {
	vsv privoxy

	# privoxy writes logs to stdout with --no-daemon
	rm -r ${DESTDIR}/var/log/privoxy
}
