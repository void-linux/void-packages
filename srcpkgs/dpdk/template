# Template file for 'dpdk'
pkgname=dpdk
version=25.11.3
revision=1
# no armv6 support
archs="~armv6l ~armv6l-musl *"
build_style=meson
configure_args="-Db_lto=false"
hostmakedepends="pkg-config python3-pyelftools"
makedepends="libnuma-devel jansson-devel libpcap-devel
 zlib-devel openssl-devel libbsd-devel elfutils-devel"
depends="python3-pyelftools"
short_desc="Data Plane Development Kit"
maintainer="Orphaned <orphan@voidlinux.org>"
license="BSD-3-Clause, GPL-2.0-only"
homepage="https://www.dpdk.org/"
distfiles="https://github.com/DPDK/${pkgname}/archive/v${version}.tar.gz"
checksum=92e6114778f99f6c53bf7c2d3b979407fe4461f1b83fb53262d47a43f828957c
# tests require hugepages
make_check=no

if [ "$XBPS_TARGET_LIBC" = musl ]; then
	makedepends+=" libexecinfo-devel musl-legacy-compat"
fi

_dpdk_platform=generic
case "${XBPS_TARGET_MACHINE}" in
	armv7l*) _cpu_instruction_set=armv8-a; _dpdk_platform=generic_aarch32;;
	aarch64*) _cpu_instruction_set=armv8-a;;
	*) _cpu_instruction_set=generic;;
esac

if [ "$CROSS_BUILD" ]; then
	meson_crossfile="${XBPS_WRAPPERDIR}/meson/xbps_dpdk.cross"
else
	configure_args+=" -Dcpu_instruction_set=${_cpu_instruction_set}"
fi

post_patch() {
	if [ "$CROSS_BUILD" ]; then
		sed -e "s/^cpu = .*/cpu = '${_cpu_instruction_set}'/" \
			-e "/^\[properties\]/a platform = '${_dpdk_platform}'" \
			"${XBPS_WRAPPERDIR}/meson/xbps_meson.cross" > "${meson_crossfile}"
	fi
}

post_install() {
	vlicense license/bsd-3-clause.txt
}

dpdk-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} jansson-devel zlib-devel libbsd-devel openssl-devel"
	short_desc+=" - development files"
	pkg_install() {
		if [ -e "${DESTDIR}/usr/bin/dpdk-pdump" ]; then
			vmove usr/bin/dpdk-pdump
		fi
		vmove usr/bin/dpdk-proc-info
		vmove usr/bin/dpdk-test*
		vmove usr/include
		vmove usr/lib/*.so
		vmove usr/lib/*.a
		vmove usr/lib/dpdk/pmds-*/*.so
		vmove usr/lib/pkgconfig
		vmove usr/share/dpdk/examples
	}
}
