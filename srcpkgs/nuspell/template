# Template file for 'nuspell'
pkgname=nuspell
version=5.1.8
revision=1
build_style=cmake
configure_args="-DBUILD_SHARED_LIBS=ON"
hostmakedepends="doxygen pandoc"
makedepends="icu-devel catch2"
short_desc="C++ spell checking library"
maintainer="John <me@johnnynator.dev>"
license="LGPL-3.0-or-later"
homepage="https://nuspell.github.io/"
distfiles="https://github.com/nuspell/nuspell/archive/v${version}.tar.gz"
checksum=4221df51003a4406717440f617044e03f916dfcb900e2d1f13902c533b0969f8

libnuspell_package() {
	pkg_install() {
		vmove "usr/lib/*.so.*"
	}
}

libnuspell-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} icu-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
