# Template file for 'mise'
pkgname=mise
version=2026.11.8
revision=1
build_style=cargo
configure_args="--no-default-features --features native-tls"
hostmakedepends="pkg-config cmake libzstd-devel"
makedepends="openssl-devel libzstd-devel bzip2-devel lua51-devel"
checkdepends="git"
short_desc="Polyglot runtime manager (asdf rust clone)"
maintainer="Daniel Lewan <daniel@teddydd.me>"
license="MIT"
homepage="https://mise.jdx.dev/"
changelog="https://github.com/jdx/mise/releases"
distfiles="https://github.com/jdx/mise/archive/v${version}.tar.gz>${pkgname}-${version}.tar.gz"
checksum=3192f568f3897dbd0dde4e47d1b8ac8f858459bc7d8ae1b061d5c12f2a8841ba

case "$XBPS_TARGET_MACHINE" in
	i686*) broken="runs out of memory" ;;
	# tests assume they never run on x86_64-unknown-linux-musl / a musl host
	x86_64-musl) make_check_args="-- --skip plugins::core::rust::tests::rustup_check_names_follow_the_configured_host
	 --skip backend::spm::tests::test_spm_requires_lockfile_urls_only_for_bundled_releases" ;;
esac

if [ "$CROSS_BUILD" ]; then
	# those also run out of memory linking now.
	XBPS_CROSS_RUSTFLAGS+=" -Clto=off"
fi

pre_build() {
	# workaround the cc-rs mixing CFLAGS for host and target.
	# https://github.com/rust-lang/cc-rs/issues/1469
	export CFLAGS_${RUST_BUILD//-/_}="${CFLAGS_host}" \
		   CXXFLAGS_${RUST_BUILD//-/_}="${CXXFLAGS_host}" \
		   LDFLAGS_${RUST_BUILD//-/_}="${LDFLAGS_host}" \
		   CFLAGS_${RUST_TARGET//-/_}="${CFLAGS}" \
		   CXXFLAGS_${RUST_TARGET//-/_}="${CXXFLAGS}" \
		   LDFLAGS_${RUST_TARGET//-/_}="${LDFLAGS}" \
		   CFLAGS="" CXXFLAGS="" LDFLAGS=""
}

pre_install() {
	pre_build
}

post_install() {
	vlicense LICENSE
	vman man/man1/mise.1
	vdoc README.md
	vcompletion completions/mise.bash bash mise
	vcompletion completions/mise.fish fish mise
	vcompletion completions/_mise zsh mise
	vinstall ${FILESDIR}/mise-self-update-instructions.toml 644 usr/lib/mise
}

rtx_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" (transitional dummy package)"
	metapackage=yes
}
