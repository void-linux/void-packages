# Template file for 'concord'
pkgname=concord
version=2.5.16
revision=1
build_style=cargo
build_helper=qemu
hostmakedepends="pkg-config cmake clang21 libclang21"
if [ "$build_option_stream" ]; then
	hostmakedepends+=" nasm"
fi

makedepends="wayland-devel libzstd-devel"
if [ "$build_option_voice" ] || [ "$build_option_stream" ]; then
	makedepends+=" alsa-lib-devel pulseaudio-devel"
fi
if [ "$build_option_stream" ]; then
	makedepends+=" pipewire-devel libva-devel"
fi

short_desc="TUI client for Discord"
maintainer="rayfadh <rayfadh@duck.com>"
license="GPL-3.0-only"
homepage="https://github.com/chojs23/concord"
changelog="https://raw.githubusercontent.com/chojs23/concord/refs/heads/main/CHANGELOG.md"
distfiles="https://github.com/chojs23/concord/archive/refs/tags/v${version}.tar.gz"
checksum=e5ad35f6ea14ac4b16f9c44d1119d4513b335885ffc7329c55a009d17801b9f8

build_options="voice stream"
desc_option_voice="Enable voice playback support (requires ALSA)"
desc_option_stream="Enable stream broadcasting (requires PipeWire and VA-API)"

case "$XBPS_MACHINE" in
	x86_64*|aarch64*) build_options_default="voice stream" ;;
esac

if [ "$build_option_stream" ]; then
	configure_args="--no-default-features --features stream-broadcast"
elif [ "$build_option_voice" ]; then
	configure_args="--no-default-features --features voice-playback"
else
	configure_args="--no-default-features"
fi

_setup_env() {
	# workaround the cc-rs mixing CFLAGS for host and target.
	# https://github.com/rust-lang/cc-rs/issues/1469
	export CFLAGS_${RUST_BUILD//-/_}="${CFLAGS_host}" \
			CXXFLAGS_${RUST_BUILD//-/_}="${CXXFLAGS_host}" \
			LDFLAGS_${RUST_BUILD//-/_}="${LDFLAGS_host}" \
			CFLAGS_${RUST_TARGET//-/_}="${CFLAGS}" \
			CXXFLAGS_${RUST_TARGET//-/_}="${CXXFLAGS}" \
			LDFLAGS_${RUST_TARGET//-/_}="${LDFLAGS}" \
			CFLAGS="" CXXFLAGS="" LDFLAGS="" \
			LIBCLANG_PATH="/usr/lib"
}

pre_build() {
	_setup_env
}

pre_install() {
	_setup_env
}
