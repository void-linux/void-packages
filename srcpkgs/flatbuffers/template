# Template file for 'flatbuffers'
pkgname=flatbuffers
version=25.12.19
revision=1
build_style=cmake
hostmakedepends="python3-build python3-setuptools python3-installer python3-numpy"
short_desc="Memory efficient serialization library"
maintainer="Orphaned <orphan@voidlinux.org>"
license="Apache-2.0"
homepage="https://google.github.io/flatbuffers/"
changelog="https://raw.githubusercontent.com/google/flatbuffers/refs/heads/master/CHANGELOG.md"
distfiles="https://github.com/google/flatbuffers/archive/refs/tags/v${version}.tar.gz"
checksum=f81c3162b1046fe8b84b9a0dbdd383e24fdbcf88583b9cb6028f90d04d90696a

if [ "$CROSS_BUILD" ]; then
	# Disable tests to prevent executing target binaries on host
	configure_args+=" -DFLATBUFFERS_BUILD_TESTS=OFF"
fi

post_build() {
	(
		cd python
		VERSION="$version" python -m build --wheel --no-isolation
	)
}

post_install() {
	python3 -m installer --destdir "${DESTDIR}" \
		--no-compile-bytecode python/dist/*.whl
}

flatbuffers-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/libflatbuffers.a
		vmove /usr/lib/pkgconfig
	}
}

python3-flatbuffers_package() {
	short_desc+=" - Python3"
	pkg_install() {
		vmove "usr/lib/python${py3_ver}"
	}
}
