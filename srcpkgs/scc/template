# Template file for 'scc'
pkgname=scc
version=4.1.0
revision=1
build_style=go
build_helper=qemu
go_import_path="github.com/boyter/scc/v4"
short_desc="Fast cloc replacement written in pure Go"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://github.com/boyter/scc"
changelog="https://github.com/boyter/scc/releases"
distfiles="https://github.com/boyter/scc/archive/refs/tags/v${version}.tar.gz"
checksum=4f3cf36010c542b10d5582afb91c668b26889160b184deee21b4319347030a7c
conflicts="sc-controller" # /usr/bin/scc

post_install() {
	vlicense LICENSE
	for shell in bash fish zsh; do
		vtargetrun "$DESTDIR"/usr/bin/scc completion $shell > scc.$shell
		vcompletion scc.$shell $shell
	done
}
