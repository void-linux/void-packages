--- a/build/rust/gni_impl/cpp_api_from_rust.gni
+++ b/build/rust/gni_impl/cpp_api_from_rust.gni
@@ -47,20 +47,7 @@
 #
 #
 template("cpp_api_from_rust") {
-  # `enable_rust` and `use_chromium_rust_toolchain` enforce that `rustc` and
-  # `cpp_api_from_rust` use the same version of Rust compiler sources - this is
-  # required (e.g. to see the same memory layout of repr-Rusts structs) as
-  # explained in
-  # https://github.com/google/crubit/blob/89417b58802e20a6a11db7fea7c31692fef25276/docs/design/design.md?plain=1#L599-L602
-  assert(enable_rust && use_chromium_rust_toolchain)
-
-  # TODO(https://crbug.com/549864599): `cpp_api_from_rust`-generated bindings
-  # may depend on C++ bindings of Rust standard library. Currently Chromium is
-  # only able to invoke Crubit in `.rs`-consuming mode (rather than
-  # `.rlib`-consuming mode). Together, these two constraints mean that
-  # `cpp_api_from_rust` only works for the target platform and doesn't yet work
-  # for the host platform.
-  assert(!rust_prebuilt_stdlib)
+  assert(enable_rust)
 
   # PDFium, V8 and other "2nd-party" Chromium projects don't yet have their own
   # `//build_overrides/crubit.gni` build file.  Until this is fixed, we assert
--- a/build/config/rust.gni
+++ b/build/config/rust.gni
@@ -435,8 +435,7 @@
 #
 # See the `assert` comments in `cpp_api_from_rust.gni` for explanation of
 # the conditions used here.
-enable_cpp_api_from_rust = enable_rust && use_chromium_rust_toolchain &&
-                           !rust_prebuilt_stdlib && build_with_chromium
+enable_cpp_api_from_rust = enable_rust && build_with_chromium
 
 rustc_wrapper_inputs = [
   "//build/action_helpers.py",
