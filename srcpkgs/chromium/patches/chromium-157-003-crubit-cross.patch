1. we already pass the sysroot through RUSTFLAGS.
2. we have two separate sysroots for cross compiling.
--- a/build/rust/gni_impl/cpp_api_from_rust.gni
+++ b/build/rust/gni_impl/cpp_api_from_rust.gni
@@ -186,28 +186,23 @@
         "--rustc-env-and-flags",
         rebase_path(invoker.rustc_env_and_flags, root_build_dir),
       ]
-
-      # With a prebuilt stdlib, `rustc` uses its default sysroot (and
-      # therefore `rustc_env_and_flags` don't contain `--sysroot`).  The
-      # default sysroot of Crubit may be different (e.g. when `rust_crubit_root`
-      # and `rust_sysroot` point to different directories), so it has to be
-      # passed explicitly.
-      if (rust_prebuilt_stdlib) {
-        args += [ "--extra-rustc-flag=--sysroot=" +
-                  rebase_path(rust_sysroot, root_build_dir) ]
-      }
     }
     args += [ "@" + rebase_path(_action_rsp_path, root_build_dir) ]
 
     # `cpp_api_from_rust` flags:
     args += [ "--" ]
     if (_use_rmeta_interface) {
+      _sysroot = rust_sysroot
+      if (current_cpu == target_cpu && current_cpu != host_cpu &&
+          rust_cross_sysroot_absolute != "") {
+        _sysroot = rust_cross_sysroot_absolute
+      }
       args += [
         "--enable-rmeta-interface=true",
         "--source-crate-name",
         _crate_name,
         "--sysroot",
-        rebase_path(rust_sysroot, root_build_dir),
+        rebase_path(_sysroot, root_build_dir),
         "--target",
         rust_abi_target,
       ]
