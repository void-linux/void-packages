From 929258c994d02498dddfd649c2aa61c66ddb5d8d Mon Sep 17 00:00:00 2001
From: LN Liberda <lauren@selfisekai.rocks>
Date: Sun, 11 Oct 2026 02:59:32 +0200
Subject: [PATCH] Revert rs_bindings_from_cc breakages

Ts not even going to production yet and already needs workarounds
---
 tools/rust/build_crubit.py | 2 +-
 tools/rust/host_tools.py   | 5 +----
 2 files changed, 2 insertions(+), 5 deletions(-)

diff --git a/tools/rust/build_crubit.py b/tools/rust/build_crubit.py
index d68832a05ef26..d1d2b738c174e 100755
--- a/tools/rust/build_crubit.py
+++ b/tools/rust/build_crubit.py
@@ -98,7 +98,7 @@ PROTOBUF_SRC_DIR = os.path.join(
 # (Abseil, Protobuf) if they break the toolchain build.  Nothing in Chromium
 # uses `rs_bindings_from_cc` yet.  `cc_bindings_from_rs` is always built,
 # because Chromium builds need it.
-ENABLE_BUILDING_RS_BINDINGS_FROM_CC = True
+ENABLE_BUILDING_RS_BINDINGS_FROM_CC = False
 
 # The Crubit binaries that this script builds and installs.  All are members
 # of the root cargo workspace (see Crubit's `Cargo.toml`).
diff --git a/tools/rust/host_tools.py b/tools/rust/host_tools.py
index 49ff40ba13fa4..82097dfe23e7a 100644
--- a/tools/rust/host_tools.py
+++ b/tools/rust/host_tools.py
@@ -78,8 +78,6 @@ def GetHostCcTools():
 
 def GetHostCFlags():
     """Returns the flags for all C and C++ compilations of host tools."""
-    if sys.platform.startswith('linux'):
-        return [f'--sysroot={GetHostDebianSysroot()}']
     if sys.platform == 'darwin':
         return ['-isysroot', GetMacSdkPath()]
     return []
@@ -91,6 +89,7 @@ def GetHostLinker():
     Windows uses `lld-link` for MSVC compat.  Otherwise, we use `lld` via
     `clang` (see `GetHostLinkArgs`).
     """
+    return os.environ.get('LD', 'clang')
     bin_dir = os.path.join(RUST_HOST_LLVM_INSTALL_DIR, 'bin')
     if sys.platform == 'win32':
         return os.path.join(bin_dir, 'lld-link.exe')
@@ -104,8 +103,6 @@ def GetHostLinkArgs():
         # needs no extra args.
         return []
     args = ['-fuse-ld=lld']
-    if sys.platform.startswith('linux'):
-        args.append(f'--sysroot={GetHostDebianSysroot()}')
     if sys.platform == 'darwin':
         args += ['-isysroot', GetMacSdkPath()]
         if 'x86_64' in RustTargetTriple():
