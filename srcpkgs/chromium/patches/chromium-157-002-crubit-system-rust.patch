     parser.add_argument('args', metavar='ARG', nargs='+')
     args = parser.parse_args()
 
-    (rustenv, rustflags) = LoadRustEnvAndFlags(args.rustc_env_and_flags)
-    PrepareRustEnvForExecution(rustenv)
+    rustenv = None
