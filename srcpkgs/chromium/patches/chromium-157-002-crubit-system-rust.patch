     if (enable_cpp_api_from_rust) {
       deps += [ "//build/rust/tests/test_cpp_api_from_rust" ]
+
+      # The `data_deps` below provides light test coverage for using
+      # `cpp_api_from_rust` when building for the host platform (rather than
+      # the target platform).  This is a bit of a hack that shouldn't really be
