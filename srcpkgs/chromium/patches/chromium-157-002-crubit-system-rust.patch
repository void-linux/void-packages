+      # executables that depend on this group (e.g. into `base_unittests`).
+      if (!toolchain_for_rust_host_build_tools) {
+        data_deps += [ "//build/rust/tests/test_cpp_api_from_rust:target_depending_only_on_bindings($rust_macro_toolchain)" ]
+      }
     }
     if (enable_rust_api_from_cpp) {
       deps += [ "//build/rust/tests/test_rust_api_from_cpp" ]
