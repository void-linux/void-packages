+    # `.rmeta` files (i.e. with `--enable-rmeta-interface=true`).
+    parser.add_argument('--rustc-env-and-flags', type=pathlib.Path)
     parser.add_argument(
-        '--rustc-env-and-flags', type=pathlib.Path, required=True
+        '--extra-rustc-flag',
