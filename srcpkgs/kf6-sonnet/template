# Template file for 'kf6-sonnet'
# group=kde-frameworks
pkgname=kf6-sonnet
version=6.31.0
revision=1
build_style=cmake
configure_args="-DBUILD_DESIGNERPLUGIN=ON"
hostmakedepends="extra-cmake-modules qt6-tools qt6-base qt6-declarative-host-tools"
makedepends="qt6-declarative-devel aspell-devel hunspell-devel qt6-tools-devel"
short_desc="Spelling framework for Qt"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/sonnet"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=8a0db04df7c8d9d386dddc2e5d94f1504b15c63b3dc091a4eeb2519788b5aec6

# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version%.*}"

kf6-sonnet-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
		vmove usr/lib/qt6/plugins/designer
	}
}
