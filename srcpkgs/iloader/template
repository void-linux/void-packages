# Template file for 'iloader'
pkgname=iloader
version=2.4.1
revision=1
# frontend toolchain (rolldown) has no prebuilt binding for i686
archs="~i686*"
build_wrksrc=src-tauri
build_style=cargo
configure_args="--features tauri/custom-protocol"
hostmakedepends="pkg-config cmake clang nodejs"
makedepends="libwebkit2gtk41-devel gtk+3-devel libsoup3-devel
 openssl-devel dbus-devel librsvg-devel"
depends="usbmuxd"
short_desc="User friendly iOS sideloader (SideStore, IPA install, pairing files)"
maintainer="Spirit <amr@programmer.net>"
license="MIT"
homepage="https://iloader.app"
changelog="https://github.com/nab138/iloader/releases"
distfiles="https://github.com/nab138/iloader/archive/refs/tags/v${version}.tar.gz"
checksum=04eef1401d9b0a1287995cf1bd69fae814dcd39fe0889415ba4b659b6a8e393f

pre_build() {
	# frontend must be built first; tauri embeds ../dist at compile time
	(
		cd ..
		cp ${FILESDIR}/package-lock.json .
		npm ci --ignore-scripts --no-audit --no-fund
		npm run build
	)
}

post_install() {
	vinstall ${FILESDIR}/iloader.desktop 644 usr/share/applications
	vinstall icons/128x128.png 644 usr/share/icons/hicolor/128x128/apps iloader.png
	vinstall icons/icon.png 644 usr/share/icons/hicolor/512x512/apps iloader.png
	vlicense ${wrksrc}/LICENSE
	vlicense ${wrksrc}/LICENSE-BRANDING
}
