# Template file for 'libmypaint'
pkgname=libmypaint
version=1.6.1
revision=2
build_style=gnu-configure
build_helper=gir
configure_args="--disable-gegl
 INTLTOOL_UPDATE=/usr/bin/false INTLTOOL_MERGE=/usr/bin/false
 INTLTOOL_EXTRACT=/usr/bin/false INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="gettext pkg-config $(vopt_if gir gobject-introspection)"
makedepends="json-c-devel libglib-devel json-glib-devel"
short_desc="MyPaint brush engine library"
maintainer="Orphaned <orphan@voidlinux.org>"
license="ISC"
homepage="https://github.com/mypaint/libmypaint"
distfiles="https://github.com/mypaint/libmypaint/releases/download/v${version}/libmypaint-${version}.tar.xz"
checksum=741754f293f6b7668f941506da07cd7725629a793108bb31633fb6c3eae5315f

build_options="gir"
build_options_default="gir"

post_patch() {
	vsed -i configure -e '
		/DATADIRNAME=/s/=.*/=share/
		/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.35/
	'
}

post_install() {
	vlicense COPYING
}

libmypaint-devel_package() {
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
		if [ "$build_option_gir" ]; then
			vmove "usr/share/gir-*"
		fi
	}
}
