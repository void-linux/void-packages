# Template file for 'menulibre'
pkgname=menulibre
version=2.2.1
revision=9
build_style=python3-module
hostmakedepends="python3-distutils-extra gettext glib gtk+3
 python3-gobject gdk-pixbuf pango gnome-menus"
depends="gnome-menus gobject-introspection gsettings-desktop-schemas gtk+3
 python3-gobject python3-psutil python3-xdg"
short_desc="Advanced menu editor"
maintainer="Styrsven <sven.a.jonsson@bahnhof.se>"
license="GPL-3.0-only"
homepage="https://bluesabre.org/projects/menulibre/"
distfiles="https://launchpad.net/$pkgname/${version%.*}/$version/+download/$pkgname-$version.tar.gz"
checksum=5b3ef8e6073d584f6accf282fa1eb649185ee42eb22fab70231491c7377d7e8f

pre_build() {
	printf '%s\n' po/*.po | sed 's;po/;;;s/.po//' >po/LINGUAS
	ln -sf /bin/true $XBPS_WRAPPERDIR/intltool-update
	sed -i 's/^_//' menulibre.desktop.in
	msgfmt --desktop --template menulibre.desktop.in \
		-d po -o menulibre.desktop
	rm -f menulibre.desktop.in
}

pre_install() {
	vinstall menulibre.desktop 644 usr/share/applications/
}
