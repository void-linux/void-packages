# Template file for 'libcdio-paranoia'
pkgname=libcdio-paranoia
version=10.2+2.0.2
revision=1
build_style=gnu-configure
configure_args="--enable-cpp-progs --disable-example-progs"
hostmakedepends="automake libtool pkg-config"
makedepends="libcdio-devel"
short_desc="CD paranoia utility/libraries from libcdio"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://www.gnu.org/software/libcdio/"
changelog="https://github.com/libcdio/libcdio-paranoia/releases"
distfiles="${GNU_SITE}/libcdio/libcdio-paranoia-$version.tar.bz2"
checksum=186892539dedd661276014d71318c8c8f97ecb1250a86625256abd4defbf0d0c
make_check=no # the official tarball does not include .BIN test data

pre_configure() {
	autoreconf -fi
}

libcdio-paranoia-devel_package() {
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
	}
}
