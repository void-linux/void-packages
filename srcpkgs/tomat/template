# Template file for 'tomat'
pkgname=tomat
version=2.14.0
revision=1
build_style=cargo
hostmakedepends="pkg-config"
makedepends="alsa-lib-devel"
short_desc="Pomodoro timer with daemon support for waybar and other status bars"
maintainer="rayfadh <rayfadh@duck.com>"
