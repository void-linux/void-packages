# Template file for 'praat'
pkgname=praat
version=7.0.03
revision=1
build_style=gnu-makefile
hostmakedepends="pkg-config"
makedepends="gtk+3-devel alsa-lib-devel jack-devel pulseaudio-devel"
checkdepends="cantarell-fonts"
short_desc="Speech analysis, synthesis, and manipulation"
maintainer="newbluemoon <blaumolch@mailbox.org>"
license="GPL-2.0-or-later"
homepage="https://www.fon.hum.uva.nl/praat/"
changelog="https://www.fon.hum.uva.nl/praat/manual/What_s_new_.html"
distfiles="https://github.com/praat/praat/archive/v${version}.tar.gz"
checksum=f193e8ba08bcc659d9291661c962508f342d272e7f7b4cd7bb417855d9bb249d

do_build() {
	vsed -i -e 's/-O\(1\|3\)//' \
	 -e 's/-no-pie//' \
	 -e 's/\(LINKER_COMMAND :=\) g++/\1 ${CXX}'/ \
	 Makefile

	make PRAAT_GRAPHICS=nogui ${makejobs} CC="$CC" CXX="$CXX" LD="$LD" AR="$AR"
	make clean
	make ${makejobs} CC="$CC" CXX="$CXX" LD="$LD" AR="$AR"
}

do_check() {
	for _dir in test dwtest; do
		cd "$_dir"
		../praat --FULL-TRUST --run runAllTests_batch.praat
		../praat_nogui --FULL-TRUST --run runAllTests_batch.praat
		cd ..
	done
}

praat-nogui_package() {
	short_desc+=" (nogui)"
	pkg_install() {
		vmove usr/bin/praat_nogui
	}
}
