# Template file for 'vinagre'
pkgname=vinagre
version=3.22.0
revision=3
build_style=gnu-configure
configure_args="--disable-schemas-compile --enable-compile-warnings=no
 INTLTOOL_UPDATE=/usr/bin/false INTLTOOL_MERGE=/usr/bin/false
 INTLTOOL_EXTRACT=/usr/bin/false INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="pkg-config gettext itstool glib"
makedepends="libxml2-devel libsecret-devel avahi-ui-libs-devel
 avahi-glib-libs-devel telepathy-glib-devel vte3-devel
 spice-gtk-devel gtk-vnc-devel openssh"
depends="openssh desktop-file-utils hicolor-icon-theme"
short_desc="VNC client for the GNOME desktop"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="http://projects.gnome.org/vinagre"
distfiles="${GNOME_SITE}/$pkgname/${version%.*}/$pkgname-$version.tar.xz"
checksum=cd1cdbacca25c8d1debf847455155ee798c3e67a20903df8b228d4ece5505e82

CFLAGS="-fcommon"

post_patch() {
	local name
	vsed -i configure -e '
		/DATADIRNAME=/s/=.*/=share/
		/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.50.1/
	'
	for name in vinagre-file vinagre; do
		vsed -i 's/^_//' data/$name.desktop.in.in
		vsed -i 's/^_//' data/$name.desktop.in
	done
	for name in vinagre.appdata vinagre-mime; do
		vsed -i 's/[<]_/</;s;[<][/]_;</;' data/$name.xml.in
	done
}

post_configure() {
	local name
	for name in vinagre-file vinagre; do
		msgfmt --desktop --template data/$name.desktop.in -d po -o data/$name.desktop
	done
	for name in vinagre.appdata vinagre-mime; do
		msgfmt --xml --template data/$name.xml.in -d po -o data/$name.xml
	done
}
