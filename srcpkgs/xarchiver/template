# Template file for 'xarchiver'
pkgname=xarchiver
version=0.5.4.26
revision=1
build_style=gnu-configure
configure_args="--disable-doc --enable-gtk2=no
 ac_cv_path_INTLTOOL_UPDATE=/usr/bin/false
 ac_cv_path_INTLTOOL_MERGE=/usr/bin/false
 ac_cv_path_INTLTOOL_EXTRACT=/usr/bin/false
 ac_cv_path_INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="pkg-config gettext"
makedepends="gtk+3-devel"
depends="xdg-utils desktop-file-utils hicolor-icon-theme"
short_desc="Lightweight desktop independent archive manager"
maintainer="icp <pangolin@vivaldi.net>"
license="GPL-2.0-or-later"
homepage="https://github.com/ib/xarchiver"
distfiles="https://github.com/ib/xarchiver/archive/refs/tags/${version}.tar.gz"
checksum=58e4fb2c1fb8421573a31cf3b4dfec301076d61f48ac5720df632986c87e9573

post_patch() {
	vsed -i configure -e '/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.40.1/'
	vsed -i xarchiver.desktop.in -e 's/^_//'
}

pre_build() {
	msgfmt --desktop --template xarchiver.desktop.in -d po -o xarchiver.desktop
}
