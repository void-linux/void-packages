# Template file for 'git-bug'
pkgname=git-bug
version=0.11.0
revision=1
build_style=go
# TestValidateUsername and TestValidateProject query the live GitHub APIs without a token.
make_check_args="-skip TestValidateUsername|TestValidateProject"
go_import_path=github.com/git-bug/git-bug
go_ldflags="-X main.version=v${version}"
hostmakedepends="pnpm"
depends="git"
checkdepends="git"
short_desc="Distributed, offline-first bug tracker integrated in git"
maintainer="MidoriKurage <kuragectl@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/git-bug/git-bug"
changelog="https://github.com/git-bug/git-bug/releases"
distfiles="https://github.com/git-bug/git-bug/archive/refs/tags/v${version}.tar.gz"
checksum=31ae65e733e31fbf37ecea8f31966fe46cbeb1657a144876c855d5cf09cffb69

# The webui build tag embeds the web UI assets into the binary.
# Vite 8/rolldown ships no ia32 native binding, so the web UI cannot be built on 32-bit x86.
if [ "${XBPS_TARGET_MACHINE%%-*}" != "i686" ]; then
	go_build_tags="webui"
fi

pre_build() {
	if [ "${XBPS_TARGET_MACHINE%%-*}" != "i686" ]; then
		pnpm --dir webui install --frozen-lockfile
		pnpm --dir webui run build
	fi
	CGO_ENABLED=0 GOARCH= go generate
}

post_install() {
	vman doc/man/git-bug.1
	for m in doc/man/git-bug-*.1; do
		vman "$m"
	done
	vinstall misc/completion/bash/git-bug 0644 usr/share/bash-completion/completions
	vinstall misc/completion/zsh/git-bug 0644 usr/share/zsh/site-functions _git-bug
	vinstall misc/completion/fish/git-bug 0644 usr/share/fish/vendor_completions.d git-bug.fish
}
