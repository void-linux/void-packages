# Template file for 'sysc-greet'
pkgname=sysc-greet
version=1.3.1
revision=1
build_style=go
go_import_path=github.com/Nomadcxx/sysc-greet
go_package=./cmd/sysc-greet
go_ldflags="-X main.Version=${version}"
conf_files="/etc/greetd/sysc-greet/*
 /etc/polkit-1/rules.d/85-sysc-greet.rules"
depends="greetd kitty gslapper socat elogind dbus polkit
 dejavu-fonts-ttf procps-ng"
short_desc="Graphical console greeter for greetd"
maintainer="Nomadcxx <noovie@gmail.com>"
license="GPL-3.0-only, MIT, CC0-1.0, CC-BY-4.0, CC-BY-NC-4.0,
 CC-BY-SA-4.0, CC-BY-NC-SA-4.0"
homepage="https://github.com/Nomadcxx/sysc-greet"
changelog="https://github.com/Nomadcxx/sysc-greet/releases"
distfiles="https://github.com/Nomadcxx/sysc-greet/archive/refs/tags/v${version}.tar.gz"
checksum=8d60a8d0c40243f5b905a57cb31f2f3e7c014889760c1bb8548785aa320f1cac
repository=nonfree
make_dirs="/var/cache/sysc-greet 0755 _greeter _greeter
 /var/lib/_greeter/Pictures/wallpapers 0755 _greeter _greeter"

post_patch() {
	sed -i -e 's,/usr/local/bin/sysc-greet,/usr/bin/sysc-greet,g' \
		-e 's,/var/lib/greeter,/var/lib/_greeter,g' \
		-e 's,/etc/greetd/,/etc/greetd/sysc-greet/,g' config/*
	vsed -i 's,subject.user == "greeter",subject.user == "_greeter",' \
		config/85-greeter.rules
}

post_install() {
	vmkdir usr/share/sysc-greet
	for dir in ascii_configs wallpapers themes fonts; do
		vcopy "$dir" usr/share/sysc-greet
	done
	vcopy cmd/sysc-greet/assets/borders usr/share/sysc-greet
	for config in config/*; do
		case "${config##*/}" in
			85-greeter.rules)
				vinstall "$config" 644 etc/polkit-1/rules.d 85-sysc-greet.rules ;;
			kitty-greeter.conf)
				vinstall "$config" 644 etc/greetd/sysc-greet kitty.conf ;;
			*.sh) vinstall "$config" 755 etc/greetd/sysc-greet ;;
			*) vinstall "$config" 644 etc/greetd/sysc-greet ;;
		esac
	done
	vinstall THIRD_PARTY_NOTICES.md 644 usr/share/sysc-greet
	vlicense LICENSE
	vlicense THIRD_PARTY_NOTICES.md
	vdoc "${FILESDIR}/README.voidlinux"
}
