do_check() {
	: gitolite test suite delete stuff
}

do_install() {
	vmkdir usr/lib/gitolite
	vmkdir usr/bin
	vcopy src/* usr/lib/gitolite
	echo "v$version" >"$DESTDIR/usr/lib/gitolite/VERSION"
	ln -s /usr/lib/gitolite/gitolite ${DESTDIR}/usr/bin/gitolite
}
