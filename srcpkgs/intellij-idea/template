# Template file for 'intellij-idea'
pkgname=intellij-idea
version=2026.3
revision=1
archs="x86_64"
depends="virtual?java-environment giflib libXtst hicolor-icon-theme ca-certificates public-suffix"
short_desc="Java integrated development environment by JetBrains"
maintainer="Bnyro <bnyro@tutanota.com>"
license="Apache-2.0"
homepage="https://www.jetbrains.org/"
distfiles="https://download.jetbrains.com/idea/idea-${version}.tar.gz"
checksum=6a53ff71f4a06add4c97edc4efe86c83119ff82e5b5e9f1db62fc95995bd6b25
repository=nonfree
nopie=yes
python_version=3
skiprdeps="/usr/lib/intellij-idea/plugins/Kotlin/bin/linux/LLDBFrontend"
replaces="intellij-idea-community-edition>=0 intellij-idea-ultimate-edition>=0"

do_install() {
	# use system CA certs
	rm jbr/lib/security/cacerts
	rm jbr/lib/security/public_suffix_list.dat
	ln -fs /etc/ssl/certs/java/cacerts jbr/lib/security
	ln -fs /usr/share/publicsuffix/public_suffix_list.dat jbr/lib/security

	# remove unnecessary libs/plugins
	rm plugins/gateway-plugin/lib/remote-dev-workers/remote-dev-worker-darwin-* -r
	rm plugins/gateway-plugin/lib/remote-dev-workers/remote-dev-worker-windows-* -r
	rm plugins/gateway-plugin/lib/remote-dev-workers/remote-dev-worker-linux-arm64 -r
	rm plugins/webp/lib/libwebp/linux/amd64/libwebp_jni.so

	vmkdir usr/bin
	vmkdir usr/share/doc/intellij-idea
	vmkdir usr/lib/intellij-idea
	vmkdir usr/share/pixmaps
	vmkdir usr/share/icons/hicolor/scalable/apps

	mv bin lib plugins product-info.json build.txt jbr ${DESTDIR}/usr/lib/intellij-idea
	mv license ${DESTDIR}/usr/share/doc/intellij-idea
	rm ${DESTDIR}/usr/lib/intellij-idea/lib/async-profiler/aarch64 -rf

	# install icons and desktop file
	ln -sf /usr/lib/intellij-idea/bin/idea.sh ${DESTDIR}/usr/bin/idea
	ln -sf /usr/lib/intellij-idea/bin/idea.png ${DESTDIR}/usr/share/pixmaps
	ln -sf /usr/lib/intellij-idea/bin/idea.svg ${DESTDIR}/usr/share/icons/hicolor/scalable/apps
	vinstall ${FILESDIR}/intellij-idea.desktop 644 usr/share/applications
}

intellij-idea-community-edition_package() {
	depends="intellij-idea-${version}_${revision}"
	short_desc+=" (transitional dummy package)"
	metapackage=yes
}

intellij-idea-ultimate-edition_package() {
	depends="intellij-idea-${version}_${revision}"
	short_desc+=" (transitional dummy package)"
	metapackage=yes
}
