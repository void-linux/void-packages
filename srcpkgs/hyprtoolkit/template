# Template file for 'hyprtoolkit'
pkgname=hyprtoolkit
version=0.5.3
revision=2
build_style=cmake
hostmakedepends="
	pkgconf
	hyprwayland-scanner
"
makedepends="
	MesaLib-devel
	aquamarine
	cairo-devel
	hyprgraphics
	hyprlang
	hyprutils
	libdrm-devel
	libgbm-devel
	pango-devel
	pixman-devel
	wayland-devel
	libxkbcommon-devel
	iniparser-devel
	wayland-protocols
"
short_desc="Modern C++ Wayland-native GUI toolkit"
maintainer="notnull <notnull@anarchyplanet.org>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprtoolkit"
changelog="https://github.com/hyprwm/${pkgname}/releases"
distfiles="https://github.com/hyprwm/${pkgname}/archive/refs/tags/v${version}.tar.gz"
checksum=7e6671fd4bf6f4b1eda0115aa187aa183db40d59049cca1d7546fb46fdb4cdc0

subpackages="${pkgname}-devel"

configure_args+=" --no-warn-unused-cli"
configure_args+=" -DCMAKE_BUILD_TYPE:STRING=Release"
configure_args+=" -DNO_SYSTEMD:BOOL=true"

post_install() {
	vlicense LICENSE
}

hyprtoolkit-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/libhyprtoolkit.so
		vmove usr/lib/pkgconfig/hyprtoolkit.pc
	}
}
