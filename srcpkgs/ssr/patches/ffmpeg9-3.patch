From ccc9d7e94e5ae6f903e8dd699aa743b27acda241 Mon Sep 17 00:00:00 2001
From: Matthew Mah <matthew.y.mah+dev@gmail.com>
Date: Sat, 29 Nov 2025 00:03:13 -0500
Subject: [PATCH] For #1074: newer ffmpeg versions need destructor
 implementation for memory cleanup.

---
 src/AV/Output/BaseEncoder.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/AV/Output/BaseEncoder.cpp b/src/AV/Output/BaseEncoder.cpp
index 5e8f5c82..d2ef34c7 100644
--- a/src/AV/Output/BaseEncoder.cpp
+++ b/src/AV/Output/BaseEncoder.cpp
@@ -178,6 +178,8 @@ void BaseEncoder::Free() {
 	if(m_codec_opened) {
 #if !SSR_USE_AVCODEC_CLOSE_DEPRECATED
 		avcodec_free_context(&m_codec_context);
+#else
+		avcodec_free_context(&m_codec_context);
 #endif
 		m_codec_opened = false;
 	}
