# Template file for 'dhcpcd-gtk'
pkgname=dhcpcd-gtk
version=0.8.0
revision=1
build_style=gnu-configure
configure_args="--with-gtk --with-icons --enable-notification"
hostmakedepends="pkg-config python3-cairosvg"
makedepends="gtk+-devel libnotify-devel dbus-devel"
depends="dhcpcd dhcpcd-icons desktop-file-utils"
short_desc="GTK+ monitor and configuration GUI for dhcpcd"
maintainer="Orphaned <orphan@voidlinux.org>"
license="BSD-2-Clause"
homepage="https://roy.marples.name/projects/dhcpcd-ui"
distfiles="https://github.com/NetworkConfiguration/dhcpcd-ui/releases/download/v${version}/dhcpcd-ui-${version}.tar.xz"
checksum=547c6c61704257535873c5f6638f5da68784b049a4e6f45864e80bd658c20bcd

if [ "${XBPS_TARGET_LIBC}" = musl ]; then
	makedepends+=" musl-legacy-compat"
fi

pre_install() {
	head -n 25 src/dhcpcd-gtk/dhcpcd-gtk.h > LICENSE
}

post_install() {
	vlicense LICENSE
}

dhcpcd-icons_package() {
	short_desc+=" - icon set"
	depends="hicolor-icon-theme"
	replaces="dhcpcd-gtk<0.7.4"
	pkg_install() {
		vmove usr/share/icons
		vmove usr/share/dhcpcd/icons
	}
}
