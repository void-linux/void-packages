# Template file for 'runawk'
pkgname=runawk
version=1.7.0
revision=1
hostmakedepends="mk-configure perl"
depends="virtual?awk"
short_desc="Powerful wrapper for AWK interpreter"
maintainer="Leah Neukirchen <leah@vuxu.org>"
license="MIT"
homepage="https://github.com/cheusov/runawk"
distfiles="https://github.com/cheusov/${pkgname}/archive/${pkgname}-${version}.tar.gz"
checksum=79b4f9fb058f2b42333b92806c419115b02a0ba5f2a52a95efa0a2c68e20d00f

do_build() {
	MKCOMPILERSETTINGS=yes mkcmake ${makejobs} PREFIX=/usr
}
do_install() {
	mkcmake install MANDIR=/usr/share/man STRIPFLAG= \
		PREFIX=/usr DESTDIR="$DESTDIR"
	vlicense doc/LICENSE
}
