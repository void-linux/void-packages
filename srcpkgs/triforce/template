do_install() {
	vinstall target/${RUST_TARGET}/release/libtriforce.so 0755 usr/lib/lv2/triforce.lv2 triforce.so
	vinstall triforce.ttl 0644 usr/lib/lv2/triforce.lv2
	vinstall manifest.ttl 0644 usr/lib/lv2/triforce.lv2
}
