# Template file for 'qdirstat'
pkgname=qdirstat
version=2.0
revision=1
build_style=qmake
hostmakedepends="qt6-base"
makedepends="qt6-base-devel qt6-qt5compat-devel"
short_desc="Qt-based directory statistics (KDirStat without any KDE)"
maintainer="lemmi <lemmi@nerd2nerd.org>"
