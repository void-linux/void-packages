post_install() {
	vman man/qdirstat.1
}

qdirstat-cache-writer_package() {
	short_desc+=" - headless scanner"
	depends="perl"
	pkg_install() {
		vmove usr/bin/qdirstat-cache-writer
		vmove usr/share/man/man1/qdirstat-cache-writer.1.gz
	}
}
