# Template file for 'zellij'
pkgname=zellij
version=0.46.0
revision=1
build_style=cargo
build_helper=qemu
configure_args="--no-default-features --features=plugins_from_target,web_server_capability,terminal"
hostmakedepends="pkg-config"
makedepends="libcurl-devel sqlite-devel"
checkdepends="libssh2-devel"
short_desc="Terminal workspace with batteries included"
maintainer="tranzystorekk <tranzystorek.io@protonmail.com>"
license="MIT"
homepage="https://zellij.dev"
changelog="https://raw.githubusercontent.com/zellij-org/zellij/main/CHANGELOG.md"
distfiles="https://github.com/zellij-org/zellij/archive/refs/tags/v${version}.tar.gz
 https://github.com/zellij-org/zellij/releases/download/v${version}/zellij-desktop-files.tar.gz>zellij-desktop-files-${version}.tar.gz"
checksum="2dfa237fea447f3cc98954e81b0097b9d25841010036720e11f67880fe7861f0
 fc037b206cbab9c1178b84140e699a5359990bc1b63ee42533c6ed9616b82073"
make_check_pre="env LIBSSH2_SYS_USE_PKG_CONFIG=1"
skip_extraction="zellij-desktop-files-${version}.tar.gz"

post_install() {
	vdoc README.md
	vlicense LICENSE.md

	mkdir zellij-desktop-assets
	vsrcextract -C zellij-desktop-assets zellij-desktop-files-${version}.tar.gz
	vcopy "zellij-desktop-assets/*" usr/share

	for shell in bash fish zsh; do
		vtargetrun "${DESTDIR}/usr/bin/zellij" setup --generate-completion ${shell} > zellij.${shell}
		vcompletion zellij.${shell} ${shell}
	done
}
