# Template file for 'uim-qt'
# Splited because meson hasn't supported Qt and gnu-configure can't cross
pkgname=uim-qt
version=2.0.0
revision=1
build_style=gnu-configure
build_helper="qmake qmake6"
configure_args="--with-libgcroots=installed --without-gtk3
 --with-qt5 --with-qt5-immodule --with-qt6 --with-qt6-immodule"
hostmakedepends="qt5-qmake qt6-base gettext pkg-config"
makedepends="qt5-devel qt5-x11extras-devel qt6-base-private-devel
 libgcroots-devel"
depends="uim>=${version}_1"
checkdepends="emacs"
short_desc="Multilingual input method library and environment - Qt5"
maintainer="Kazuho Sakoda <hyonhyoro.kazuho@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/uim/uim/wiki"
distfiles="https://github.com/uim/uim/releases/download/${version}/uim-${version}.tar.bz2"
checksum=a48d0019668e94463bf06b46f6130ddd8caebe62ce03985debb638b928eba50e
CXXFLAGS=-std=gnu++17
nocross=yes

post_install() {
	local file
	for file in $DESTDIR/usr/bin/*; do
		case "$file" in
			*-qt5 | *-qt6) ;;
			*) rm $file ;;
		esac
	done
	rm -r $DESTDIR/usr/include
	rm -r $DESTDIR/usr/lib/pkgconfig
	rm -r $DESTDIR/usr/lib/uim
	rm -r $DESTDIR/usr/lib/libuim*
	rm -r $DESTDIR/usr/libexec/uim-helper-server
	rm -r $DESTDIR/usr/share
}

uim-qt6_package() {
	short_desc="${short_desc%Qt5}Qt6"
	depends="uim>=${version}_1"
	pkg_install() {
		vmove "usr/bin/*-qt6"
		vmove usr/lib/qt6
		vmove usr/libexec/uim-candwin-qt6
	}
}
