# Template file for 'libspectrum'
pkgname=libspectrum
version=1.7.0
revision=1
build_style=gnu-configure
hostmakedepends="perl pkg-config"
makedepends="audiofile-devel bzip2-devel libglib-devel libgcrypt-devel zlib-devel"
short_desc="Spectrum emulation support library"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="http://fuse-emulator.sourceforge.net/"
distfiles="${SOURCEFORGE_SITE}/fuse-emulator/${pkgname}-${version}.tar.gz"
checksum=b537942b2aab090d2a72fec8f58e597cc7a1f76d74c27c034665e4727f02109f

libspectrum-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove usr/lib/pkgconfig
		vmove usr/share/man/man3
		vmove "usr/lib/*.so"
	}
}
