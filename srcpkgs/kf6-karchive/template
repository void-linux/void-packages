# Template file for 'kf6-karchive'
# group=kde-frameworks
pkgname=kf6-karchive
version=6.28.0
revision=1
build_style=cmake
hostmakedepends="extra-cmake-modules qt6-tools qt6-base
 pkg-config"
makedepends="qt6-base-devel zlib-devel bzip2-devel liblzma-devel
 libzstd-devel"
short_desc="Qt addon providing access to numerous types of archives"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/karchive"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=ff36137e6b171906b4bde4006558739c5d7771dc30b9a037b65e62b2674a1b13

# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version}"

kf6-karchive-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
