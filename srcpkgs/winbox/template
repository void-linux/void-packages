# Template file for 'winbox'
pkgname=winbox
version=4.5
revision=1
archs="x86_64"
create_wrksrc=yes
hostmakedepends="unzip"
depends="libxcb libxkbcommon libxkbcommon-x11 xcb-util-wm xcb-util-image xcb-util-keysyms xcb-util-renderutil xcb-util libX11 libXau libXdmcp libglvnd freetype fontconfig zlib dbus glibc bzip2 libpng brotli expat"
short_desc="MikroTik RouterOS graphical configuration utility"
maintainer="Nolan MacPhee <nolan.voidlinux@gmail.com>"
license="custom:proprietary"
homepage="https://mikrotik.com"
distfiles="https://download.mikrotik.com/routeros/winbox/${version}/WinBox_Linux.zip"
checksum=5192817089eb91ac5d03edc68661b2603ef81f8098627ab4fd9425b6cc7546a2
repository=nonfree
restricted=yes

do_install() {
	local package_location="usr/lib/$pkgname" item

	vmkdir usr/share/pixmaps
	chmod 644 assets/img/winbox.png
	vcopy assets/img/winbox.png /usr/share/pixmaps/

	vmkdir usr/share/applications
	vcopy $FILESDIR/winbox.desktop /usr/share/applications/

	vmkdir ${package_location}
	chmod +x WinBox

	vcopy "WinBox" "${package_location}"

	vmkdir usr/bin
	ln -sfr $DESTDIR/${package_location}/WinBox $DESTDIR/usr/bin/WinBox
}

post_install() {
	vlicense $FILESDIR/LICENSE
}
