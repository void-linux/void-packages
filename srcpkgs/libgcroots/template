# Template file for 'libgcroots'
pkgname=libgcroots
version=0.3.6
revision=1
build_style=meson
short_desc="GC library for sigscheme Scheme interpreter"
maintainer="Đoàn Trần Công Danh <congdanhqx@gmail.com>"
license="Boehm-GC"
homepage="https://github.com/uim/libgcroots"
distfiles="https://github.com/uim/libgcroots/releases/download/$version/libgcroots-$version.tar.gz"
checksum=4eaab99f16e3bd0de53300e440b0830080b97f5aeb14c1ec0a90f25792bf66e2

post_install() {
	vlicense COPYING
}

libgcroots-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
