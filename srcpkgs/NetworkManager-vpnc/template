# Template file for 'NetworkManager-vpnc'
pkgname=NetworkManager-vpnc
version=1.2.6
revision=5
build_style=gnu-configure
configure_args="--localstatedir=/var --disable-static --without-libnm-glib
 ac_cv_path_INTLTOOL_UPDATE=/usr/bin/false
 ac_cv_path_INTLTOOL_MERGE=/usr/bin/false
 ac_cv_path_INTLTOOL_EXTRACT=/usr/bin/false
 ac_cv_path_INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="pkg-config gettext"
makedepends="gtk+3-devel libnm libnma-devel libsecret-devel"
depends="vpnc"
short_desc="NetworkManager VPN plugin for VPNC"
maintainer="Peter Kuchar <masaj@gmx.com>"
license="GPL-2.0-or-later"
homepage="https://wiki.gnome.org/Projects/NetworkManager"
distfiles="${GNOME_SITE}/${pkgname}/${version%.*}/${pkgname}-${version}.tar.xz"
checksum=de4fd059c4c08365a40b32b6f6fad9674f556724b4bbeb1f9d4473ac19a745cb
lib32disabled=yes

post_patch() {
	vsed -i configure -e '
		/DATADIRNAME=/s/=.*/=share/
		/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.35/
	'
}

post_configure() {
	if [ -f appdata/network-manager-vpnc.metainfo.xml ]; then
		touch appdata/network-manager-vpnc.metainfo.xml
	fi
}
