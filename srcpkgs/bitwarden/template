# Template file for 'bitwarden'
pkgname=bitwarden
version=2026.7.0
revision=1
archs="x86_64"
hostmakedepends="tar"
depends="at-spi2-core libsecret alsa-lib cairo gtk+3 libdrm libX11
 libxcb libXcomposite libXdamage libXext libXfixes libxkbcommon
 libXrandr libXScrnSaver pango nss libcurl dbus mesa xdg-utils
 libglvnd expat"
short_desc="Bitwarden password manager desktop client"
maintainer="Zoa Hickenlooper <zoa@router.sex>"
license="GPL-3.0-only"
homepage="https://bitwarden.com/"
changelog="https://github.com/bitwarden/clients/releases"
nostrip=yes
noshlibprovides=yes
allow_unknown_shlibs=yes

case "$XBPS_TARGET_MACHINE" in
	x86_64)
		distfiles="https://github.com/bitwarden/clients/releases/download/desktop-v${version}/bitwarden_${version}_x64.tar.gz"
		checksum=c5d6d050eb3c3f269596f9556375d222924e4911c0473ea4d62497bf911346e0
		;;
	aarch64)
		distfiles="https://github.com/bitwarden/clients/releases/download/desktop-v${version}/bitwarden_${version}_arm64.tar.gz"
		checksum=ba666bd2b9fad671ae5dd82b8231ab75a2f6a7a3c40e738e795069212e7b2e86
		;;
	*)
		broken="bitwarden is only available for x86_64 and aarch64"
		;;
esac

do_install() {
	vmkdir usr/lib/bitwarden
	vcopy bitwarden-app usr/lib/bitwarden/
	vcopy chrome_crashpad_handler usr/lib/bitwarden/
	vcopy chrome-sandbox usr/lib/bitwarden/
	vcopy desktop_proxy usr/lib/bitwarden/
	vcopy libEGL.so usr/lib/bitwarden/
	vcopy libffmpeg.so usr/lib/bitwarden/
	vcopy libGLESv2.so usr/lib/bitwarden/
	vcopy libprocess_isolation.so usr/lib/bitwarden/
	vcopy libvk_swiftshader.so usr/lib/bitwarden/
	vcopy "libvulkan.so*" usr/lib/bitwarden/
	vcopy locales usr/lib/bitwarden/
	vcopy resources usr/lib/bitwarden/
	vcopy vk_swiftshader_icd.json usr/lib/bitwarden/
	vcopy icudtl.dat usr/lib/bitwarden/
	vcopy v8_context_snapshot.bin usr/lib/bitwarden/
	vcopy snapshot_blob.bin usr/lib/bitwarden/
	vcopy chrome_100_percent.pak usr/lib/bitwarden/
	vcopy chrome_200_percent.pak usr/lib/bitwarden/
	vcopy resources.pak usr/lib/bitwarden/
	vcopy LICENSE.electron.txt usr/lib/bitwarden/
	vcopy LICENSES.chromium.html usr/lib/bitwarden/
	# Upstream's own wrapper script (renamed 'bitwarden' in the release
	# tarball) already handles X11/Wayland Ozone platform detection
	# correctly — install it as-is rather than writing a new one. It
	# execs "$APP_PATH/bitwarden-app", where APP_PATH resolves relative
	# to the wrapper's own location, so it works unmodified as long as
	# bitwarden-app sits next to it (which it does, both under
	# usr/lib/bitwarden/).
	vcopy bitwarden usr/lib/bitwarden/

	chmod 4755 ${DESTDIR}/usr/lib/bitwarden/chrome-sandbox

	vmkdir usr/bin
	ln -s /usr/lib/bitwarden/bitwarden ${DESTDIR}/usr/bin/bitwarden

	vinstall resources/com.bitwarden.desktop.desktop 644 usr/share/applications

	for size in 16 32 64 128 256 512 1024; do
		vinstall resources/icons/${size}x${size}.png 644 \
			usr/share/icons/hicolor/${size}x${size}/apps com.bitwarden.desktop.png
	done
}
