# Template file for 'docbook5-xml'
pkgname=docbook5-xml
version=5.0
revision=1
hostmakedepends="libxml2"
depends="xmlcatmgr"
short_desc="DocBook 5.0 XML schemas (DTD, RELAX NG, W3C XML Schema, Schematron)"
maintainer="Fabian Constantinescu <fabian.constantinescu@protonmail.com>"
license="DocBook-Schema"
homepage="https://docbook.org/schemas/5x"
distfiles="https://archive.docbook.org/xml/${version}/docbook-${version}.zip"
checksum=3dcd65e1f5d9c0c891b3be204fa2bb418ce485d32310e1ca052e81d36623208e
xml_catalogs="/usr/share/xml/docbook/schema/docbook-${version}.xml"

do_install() {
	local f s u
	local _dir=/usr/share/xml/docbook/schema
	local _cat=${DESTDIR}${_dir}/docbook-${version}.xml

	for f in dtd/* rng/* sch/* xsd/*; do
		vinstall ${f} 644 ${_dir}/${f%/*}/${version}
	done

	xmlcatalog --noout --create ${_cat}
	xmlcatalog --noout --add public "-//OASIS//DTD DocBook XML ${version}//EN" \
		file://${_dir}/dtd/${version}/docbook.dtd ${_cat}
	for u in http://docbook.org/xml/${version} \
		http://www.oasis-open.org/docbook/xml/${version}; do
		xmlcatalog --noout --add system ${u}/dtd/docbook.dtd \
			file://${_dir}/dtd/${version}/docbook.dtd ${_cat}
		for s in docbook.rng docbookxi.rng docbook.rnc docbookxi.rnc; do
			xmlcatalog --noout --add uri ${u}/rng/${s} \
				file://${_dir}/rng/${version}/${s} ${_cat}
		done
		xmlcatalog --noout --add uri ${u}/sch/docbook.sch \
			file://${_dir}/sch/${version}/docbook.sch ${_cat}
		xmlcatalog --noout --add uri ${u}/xsd/docbook.xsd \
			file://${_dir}/xsd/${version}/docbook.xsd ${_cat}
	done

	vlicense ${FILESDIR}/LICENSE
}
