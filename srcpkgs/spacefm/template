# Template file for 'spacefm'
pkgname=spacefm
version=1.0.6
revision=2
build_style=gnu-configure
configure_args="--with-gtk3
 INTLTOOL_UPDATE=/usr/bin/false INTLTOOL_MERGE=/usr/bin/false
 INTLTOOL_EXTRACT=/usr/bin/false INTLTOOL_PERL=/usr/bin/true"
hostmakedepends="pkg-config gettext"
makedepends="gtk+3-devel
 startup-notification-devel eudev-libudev-devel ffmpegthumbnailer-devel"
depends="hicolor-icon-theme desktop-file-utils"
short_desc="Multi-panel tabbed file manager"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="http://ignorantguru.github.io/spacefm/"
distfiles="https://github.com/IgnorantGuru/spacefm/archive/${version}.tar.gz"
checksum=fedea9fcad776e0af4b8d90c5a1c86684a9c96ef1cdd4e959530ce93bdebe7c9
conf_files="/etc/spacefm/spacefm.conf"

CFLAGS="-fcommon"

post_patch() {
	local name
	vsed -i configure -e '
		/DATADIRNAME=/s/=.*/=share/
		/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.50.1/
	'
	for name in spacefm spacefm-find spacefm-folder-handler; do
		vsed -i 's/^_//' data/$name.desktop.in
	done
}

post_configure() {
	local name
	for name in spacefm spacefm-find spacefm-folder-handler; do
		msgfmt --desktop --template data/$name.desktop.in -d po -o data/$name.desktop
	done
}
