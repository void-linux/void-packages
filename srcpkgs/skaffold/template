# Template file for 'skaffold'
pkgname=skaffold
version=2.24.0
revision=1
build_style=go
go_import_path=github.com/GoogleContainerTools/skaffold/v2
go_package="${go_import_path}/cmd/skaffold"
go_ldflags="-X ${go_import_path}/pkg/skaffold/version.version=${version}"
hostmakedepends="git"
