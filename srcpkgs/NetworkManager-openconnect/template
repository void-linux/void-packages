post_patch() {
	vsed -i configure -e '
		/DATADIRNAME=/s/=.*/=share/
		/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.35/
	'
}

post_configure() {
	if [ -f appdata/network-manager-openconnect.metainfo.xml ]; then
		touch appdata/network-manager-openconnect.metainfo.xml
	fi
}
