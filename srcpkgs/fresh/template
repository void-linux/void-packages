# Template file for 'fresh'
pkgname=fresh
version=0.5.8
revision=1
archs="~armv6* ~armv7*"
build_style=cargo
make_install_args="--path crates/fresh-editor"
make_check_args="-- --skip services::recovery::tests::crash_before_the_save_wrote_keeps_the_unsaved_work --skip services::recovery::tests::crash_during_an_in_place_write_keeps_the_unsaved_work"
hostmakedepends="pkg-config oniguruma-devel"
makedepends="oniguruma-devel"
checkdepends="python3"
short_desc="Terminal based IDE & text editor: easy, powerful and fast"
maintainer="zenobit <zen@osowoso.org>"
license="GPL-3.0-only"
homepage="https://github.com/sinelaw/fresh"
distfiles="https://github.com/sinelaw/fresh/archive/refs/tags/v${version}.tar.gz"
checksum=b048bfa38b9b50a262f19ac49d254a1479926ddb74d496367649892ac8720495

_setup_env() {
	export CFLAGS_${RUST_BUILD//-/_}="${CFLAGS_host}" \
		CXXFLAGS_${RUST_BUILD//-/_}="${CXXFLAGS_host}" \
		LDFLAGS_${RUST_BUILD//-/_}="${LDFLAGS_host}" \
		CFLAGS_${RUST_TARGET//-/_}="${CFLAGS}" \
		CXXFLAGS_${RUST_TARGET//-/_}="${CXXFLAGS}" \
		LDFLAGS_${RUST_TARGET//-/_}="${LDFLAGS}" \
		HOST_PKG_CONFIG="/usr/bin/pkg-config" \
		CFLAGS="" CXXFLAGS="" LDFLAGS=""
}

pre_build() {
	_setup_env
}

pre_check() {
	_setup_env
}

pre_install() {
	_setup_env
}

do_check() {
	XDG_CACHE_HOME=/var/cache cargo test --lib --locked --target ${RUST_TARGET} \
		${configure_args} ${make_check_args}
}
