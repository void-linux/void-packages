# Template file for 'fresh'
pkgname=fresh
version=0.5.3
revision=1
build_style=cargo
make_install_args="--path crates/fresh-editor"
hostmakedepends="pkg-config oniguruma-devel"
makedepends="oniguruma-devel"
checkdepends="python3"
short_desc="Terminal based IDE & text editor: easy, powerful and fast"
maintainer="zenobit <zen@osowoso.org>"
license="GPL-3.0-only"
homepage="https://github.com/sinelaw/fresh"
distfiles="https://github.com/sinelaw/fresh/archive/refs/tags/v${version}.tar.gz"
checksum=76b9731fe75b3a2d3e39acc695c7fa16b74c7aff4744f6afcc5cf2c9b529ed60

_build_env() {
	export CFLAGS_${RUST_TARGET//-/_}="${CFLAGS}" \
		HOST_CFLAGS="-fstack-clash-protection ${CFLAGS_host}" \
		CFLAGS_${RUST_BUILD//-/_}="${HOST_CFLAGS}" \
		HOST_PKG_CONFIG=/usr/bin/pkg-config
	# cc-rs appends generic CFLAGS to both host and target flags.
	unset CFLAGS
}

pre_build() {
	_build_env
}

pre_check() {
	_build_env
}

do_check() {
	: ${make_cmd:=cargo auditable}
	: ${make_verbose:=-v}

	${make_check_pre} env CARGO_PROFILE_RELEASE_DEBUG_ASSERTIONS=true ${make_cmd} test ${XBPS_VERBOSE+${make_verbose}} --release --locked --target ${RUST_TARGET} \
		${configure_args} ${make_check_args}
}

pre_install() {
	_build_env
}
