# Template file for 'onboard'
pkgname=onboard
version=1.4.4+4
revision=1
build_style=python3-pep517
hostmakedepends="gettext python3-setuptools python3-distutils-extra pkg-config glib"
makedepends="python3-devel gtk+3-devel dconf-devel eudev-libudev-devel
 hunspell-devel libXi-devel libXtst-devel libcanberra-devel libxkbfile-devel"
depends="iso-codes python3-gobject python3-cairo python3-dbus"
short_desc="Onscreen keyboard useful for everybody"
maintainer="classabbyamp <void@placeviolette.net>"
license="GPL-3.0-or-later"
homepage="https://github.com/onboard-osk/onboard"
distfiles="https://github.com/onboard-osk/onboard/archive/refs/tags/v${version/+/-}.tar.gz"
checksum=5597fe8a66ac8ae0fb742883b001c430fa042ea4847b6f97b5d26c7866edfbad
make_check=no # cannot open display
noverifypydeps=yes

pre_build() {
	printf '%s\n' po/*.po | sed 's;po/;;;s/.po//' >po/LINGUAS
	ln -s /bin/true $XBPS_WRAPPERDIR/intltool-update
	vsed -i 's/^_//' data/onboard.desktop.in
	vsed -i 's/^_//' data/onboard-settings.desktop.in
	msgfmt --desktop --template data/onboard.desktop.in \
		-d po -o data/onboard.desktop
	msgfmt --desktop --template data/onboard-settings.desktop.in \
		-d po -o data/onboard-settings.desktop
	rm data/*.desktop.in
}

pre_install() {
	vinstall data/onboard-settings.desktop 644 \
		usr/share/applications/
	vinstall data/onboard.desktop 644 usr/share/applications/
}

post_install() {
	rm "${DESTDIR}/usr/share/glib-2.0/schemas/gschemas.compiled"
}
