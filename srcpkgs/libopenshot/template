# Template file for 'libopenshot'
pkgname=libopenshot
version=1.0.0
revision=1
build_style=cmake
# Builds fail with Ruby-2.4.1
configure_args="-DENABLE_RUBY=OFF -DUSE_SYSTEM_JSONCPP=ON -DENABLE_OPENCV=ON"
hostmakedepends="swig doxygen ruby python3 python3-setuptools pkg-config
 qt6-base protobuf"
makedepends="python3-devel ffmpeg6-devel libmagick-devel qt6-base-devel libgomp-devel
 libopenshot-audio-devel qt6-multimedia-devel unittest-cpp zeromq-devel cppzmq
 jsoncpp-devel qt6-svg-devel libopencv-devel babl-devel boost-devel protobuf-devel"
depends="python3"
short_desc="Library files for the OpenShot video editor"
maintainer="Orphaned <orphan@voidlinux.org>"
license="LGPL-3.0-or-later"
homepage="https://github.com/OpenShot/libopenshot"
distfiles="https://github.com/OpenShot/libopenshot/archive/v${version}.tar.gz"
checksum=5c5f3790f6f70977f3573b9d039372d5b85bddc46f8944244a6225a79891acf2

if [ "$CROSS_BUILD" ]; then
	hostmakedepends+=" protobuf-devel"
fi

libopenshot-devel_package() {
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/*.so
	}
}
