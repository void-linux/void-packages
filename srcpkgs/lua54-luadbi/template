# Template file for 'lua54-luadbi'
pkgname=lua54-luadbi
version=0.7.5
revision=1
makedepends="lua51-devel lua52-devel lua53-devel lua54-devel sqlite-devel
 postgresql-libs-devel libmariadbclient-devel duckdb-devel"
 depends="lua54"
_desc="Lua database interface library"
short_desc="${_desc} (5.4.x)"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://github.com/mwild1/luadbi"
distfiles="https://github.com/mwild1/luadbi/archive/refs/tags/v${version}.tar.gz>luadbi-${version}.tar.gz"
checksum=d11990029946cf29ee33cdb563900ba8e105207c507b08887896e88e429d8429

_lua_vers=("5.1" "5.2" "5.3" "5.4") # Note: This package does not support lua > 5.4, as of version 0.7.5
_common_cflags="-pedantic -Wall -O2 -shared -fpic -I${XBPS_CROSS_BASE}/usr/include/mysql -I${XBPS_CROSS_BASE}/usr/include/postgresql/server -I."

if [[ -n "${CROSS_BUILD}" ]]; then
	_common_cflags+=" -I${XBPS_CROSS_BASE}/usr/include"
fi

post_patch() {
	cd ${wrksrc}
	_source_files=$(ls)

	mkdir lua51
	mv ${_source_files} lua51

	for ver in ${_lua_vers[@]:1}; do
		cp -a lua51 "lua${ver/./}"
	done
}

do_build() {
	for ver in ${_lua_vers[@]}; do
		cd "${wrksrc}/lua${ver/./}"
		msg_normal "building for lua ${ver}\n"
		make CC="$CC" AR="$AR" RANLIB="$RANLIB" CFLAGS="${_common_cflags} -I${XBPS_CROSS_BASE}/usr/include/lua${ver}" LUA_V="${ver}" ${makejobs} free
	done
}

_lua_install() {
	_ver=$1
	cd "${wrksrc}/lua${_ver/./}"
	make install_free DESTDIR="${PKGDESTDIR}" LUA_V="${_ver}"
	vlicense COPYING
}

do_install() {
	for ver in ${_lua_vers[@]}; do
		_lua_install "${ver}"
	done
}

lua51-luadbi_package() {
	short_desc="${_desc} (5.1.x)"
	depends="lua51"
	pkg_install() {
		vmove "usr/lib/lua/5.1"
		vmove "usr/share/lua/5.1"
		vlicense "${wrksrc}/lua51/COPYING"
	}
}

lua52-luadbi_package() {
	short_desc="${_desc} (5.2.x)"
	depends="lua52"
	pkg_install() {
		vmove "usr/lib/lua/5.2"
		vmove "usr/share/lua/5.2"
		vlicense "${wrksrc}/lua52/COPYING"
	}
}

lua53-luadbi_package() {
	short_desc="${_desc} (5.3.x)"
	depends="lua53"
	pkg_install() {
		vmove "usr/lib/lua/5.3"
		vmove "usr/share/lua/5.3"
		vlicense "${wrksrc}/lua53/COPYING"
	}
}

lua-luadbi_package() {
	depends="lua53-luadbi>=${version}_${revision}"
	short_desc="${_desc} (5.3.x) (transitional dummy package)"
	metapackage=yes
}
