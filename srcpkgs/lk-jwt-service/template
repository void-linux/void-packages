# Template file for 'lk-jwt-service'
pkgname=lk-jwt-service
version=0.10.0
revision=1
archs="x86_64* i686* aarch64* arm*" # ring
build_style=cargo
make_build_args="-p lk-jwt-service"
make_install_args="--path . --bin lk-jwt-service"
make_check_args="-p lk-jwt-service"
hostmakedepends="pkg-config"
short_desc="Minimal service to issue LiveKit JWTs for MatrixRTC"
maintainer="Joel Beckmeyer <joel@beckmeyer.us>"
license="AGPL-3.0-only"
homepage="https://github.com/element-hq/lk-jwt-service"
changelog="https://github.com/element-hq/lk-jwt-service/releases"
distfiles="https://github.com/element-hq/lk-jwt-service/archive/refs/tags/v${version}.tar.gz"
checksum=40c3bb24616e27bd0d2854859b593bb79f2c7832d9202b998957998d6d5ca79b
conf_files="/etc/sv/lk-jwt-service/conf"
system_accounts="_lkjwt"

if [ "$XBPS_TARGET_NO_ATOMIC8" ]; then
	XBPS_CROSS_RUSTFLAGS+=" -latomic"
fi

# aws-lc-sys only ships pre-generated files for certain architectures
case "${XBPS_TARGET_MACHINE}" in
armv[67]l*)
	hostmakedepends+=" cmake rust-bindgen"
	;;
esac

post_install() {
	vlicense LICENSE
	vsv lk-jwt-service
	chmod 0600 "${DESTDIR}/etc/sv/lk-jwt-service/conf"
}
