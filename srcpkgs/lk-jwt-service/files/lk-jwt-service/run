#!/bin/sh
exec 2>&1

[ -r ./conf ] && . ./conf

export LIVEKIT_URL LIVEKIT_KEY LIVEKIT_KEY_FROM_FILE \
	LIVEKIT_SECRET LIVEKIT_SECRET_FROM_FILE LIVEKIT_KEY_FILE \
	LIVEKIT_JWT_BIND LIVEKIT_JWT_PORT \
	LIVEKIT_FULL_ACCESS_HOMESERVERS \
	LIVEKIT_REMOTE_CAN_PUBLISH_HOMESERVERS \
	LIVEKIT_SANITY_CHECK_INTERVAL_SECONDS \
	LIVEKIT_CAN_UPDATE_OWN_METADATA \
	LIVEKIT_LOG_LEVEL LIVEKIT_CS_API_URL_OVERRIDES \
	LIVEKIT_REDIS_URL LIVEKIT_REDIS_PASSWORD \
	LIVEKIT_AS_TOKEN LIVEKIT_HS_TOKEN \
	LIVEKIT_AS_REGISTRATION_FILE LIVEKIT_HS_SERVER_NAME \
	LIVEKIT_INSECURE_SKIP_VERIFY_TLS

exec chpst -u _lkjwt:_lkjwt lk-jwt-service
