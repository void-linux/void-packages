From 4b32c2a8f09b0d1a7b31aaa461e3936afb06b927 Mon Sep 17 00:00:00 2001
From: Duncan Overbruck <mail@duncano.de>
Date: Mon, 3 Nov 2025 21:34:19 +0100
Subject: [PATCH 12/15] fix bootstrap confusing lib and lib64 and core crates
 not being found

Source: https://github.com/chimera-linux/cports/blob/3b0287d5df849cc1f9a5e0a8fb3a396bbbe1f9fc/main/rust/patches/fuck-rust.patch

diff --git a/src/bootstrap/src/core/session.rs b/src/bootstrap/src/core/session.rs
index 4ad04df753..d2932233c8 100644
--- a/src/bootstrap/src/core/session.rs
+++ b/src/bootstrap/src/core/session.rs
@@ -294,7 +294,9 @@ impl Session {
             .args(["--print", "sysroot", "--print", "target-libdir"])
             .run_in_dry_run()
             .run_capture_stdout(&config)
-            .stdout();
+            .stdout()
+            .replace("lib64", "lib")
+            .replace("lib32", "lib");
         let mut rustc_paths = rustc_paths.lines();
         let initial_sysroot =
             rustc_paths.next().map(PathBuf::from).expect("Missing sysroot from initial rustc");
