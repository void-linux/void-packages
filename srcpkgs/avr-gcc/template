# Template file for 'avr-gcc'
pkgname=avr-gcc
version=16.2.0
revision=1
short_desc="GNU C Compiler for AVR"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GFDL-1.3-or-later, GPL-3.0-or-later, GCC-exception-3.1"
homepage="https://gcc.gnu.org"
distfiles="${GNU_SITE}/gcc/gcc-${version}/gcc-${version}.tar.gz"
checksum=071d00a097579e5ef7ce97fc4a9e58e73fd3503c0a013c765c970370a5a53b9b

hostmakedepends="avr-binutils tar"
if [ "$CROSS_BUILD" ]; then
	# Need a direct cross-compiler for libgcc.
	hostmakedepends+=" avr-gcc"
fi
makedepends="zlib-devel libmpc-devel isl-devel"
depends="avr-binutils"
nostrip=yes

do_configure() {
	[ -d obj-avr ] && rm -rf obj-avr
	mkdir obj-avr
	cd obj-avr

	CFLAGS="-O2 -pipe" \
	CXXFLAGS="-O2 -pipe" \
	LDFLAGS= \
	CONFIG_SHELL=/bin/bash \
	../configure \
		--target=avr \
		--build=$XBPS_TRIPLET \
		--host=$XBPS_CROSS_TRIPLET \
		--prefix=/usr \
		--infodir=/usr/share/info \
		--libdir=/usr/lib \
		--libexecdir=/usr/lib \
		--mandir=/usr/share/man \
		--disable-install-libiberty \
		--disable-libssp \
		--disable-libstdcxx-pch \
		--disable-libunwind-exceptions \
		--disable-linker-build-id \
		--disable-nls \
		--disable-werror \
		--disable-__cxa_atexit \
		--disable-gcov \
		--enable-checking=release \
		--enable-clocale=gnu \
		--enable-gnu-indirect-function \
		--enable-gnu-unique-object \
		--enable-gold \
		--enable-languages=c,c++ \
		--enable-ld=default \
		--enable-lto \
		--enable-plugin \
		--enable-shared \
		--with-isl \
		--with-gnu-as \
		--with-gnu-ld \
		--with-as=/usr/bin/avr-as \
		--with-ld=/usr/bin/avr-ld \
		--with-plugin-ld=ld.gold \
		--with-system-zlib
}

do_build() {
	cd obj-avr
	make ${makejobs}
}

do_install() {
	cd obj-avr
	make DESTDIR="$DESTDIR" install
}

post_install() {
	rm -rf "$DESTDIR"/usr/share/man/man7
	rm -rf "$DESTDIR"/usr/share/info
	rm -rf "$DESTDIR"/usr/lib/libcc1.*
	rm -rf "$DESTDIR"/usr/lib64
	ln -s avr-gcc "$DESTDIR"/usr/bin/avr-cc
	find "$DESTDIR"/usr/lib -type f -name "*.a" \
		-exec avr-strip --strip-debug {} \;
}
