modprobe apple-mailbox
modprobe nvme-apple
modprobe vfat
modprobe xhci-plat-hcd

esp_uuid="$(tr -d '\0' < /proc/device-tree/chosen/asahi,efi-system-partition)"
esp_dev="/dev/disk/by-partuuid/$esp_uuid"
set +f
for i in $(seq 0 50); do
	[ -b "$esp_dev" ] && break
	for part in /sys/class/block/nvme*n*p*; do
		[ -r "$part/partition" ] && [ -b "/dev/${part##*/}" ] || continue
		if grep -Fxiq "PARTUUID=$esp_uuid" "$part/uevent"; then
			esp_dev="/dev/${part##*/}"
			break 2
		fi
	done
	sleep 0.1
done
set -f

print 'asahi: mounting ESP'
mountpoint=/run/.system-efi
mkdir -p "$mountpoint"
while grep -q "$mountpoint" /proc/mounts; do
	umount "$mountpoint"
done
mount -t vfat -o ro "$esp_dev" "$mountpoint"

print 'asahi: unpacking vendor firmware into initramfs'
cpio -i < "$mountpoint/vendorfw/firmware.cpio"
umount "$mountpoint"
