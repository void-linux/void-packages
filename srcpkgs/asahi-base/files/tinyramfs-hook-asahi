mkdir -p "$tmpdir/usr/lib/firmware"
_vendor="$tmpdir/usr/lib/firmware/vendor"
if [ -d "$_vendor" ] && [ ! -L "$_vendor" ]; then
	mkdir -p "$tmpdir/vendorfw"
	cp -a --update=none "$_vendor/." "$tmpdir/vendorfw/"
	rm -r "$_vendor"
fi
ln -sfn ../../../vendorfw "$_vendor"

for _mod in \
	vfat nls_cp437 nls_ascii \
	apple-mailbox \
	nvme_apple \
	pinctrl-apple-gpio \
	macsmc macsmc-rtkit \
	macsmc-input macsmc-power macsmc-reboot \
	i2c-pasemi-platform tps6598x sn201202x apple-dart dwc3 dwc3-apple \
	nvme-apple-efuses phy-apple-atc \
	reset-apple-cio thunderbolt-apple \
	xhci-plat-hcd xhci-pci pcie-apple \
	gpio_macsmc \
	rtc-macsmc spmi-apple-controller apple_nvmem_spmi \
	spi-apple spi-hid-apple spi-hid-apple-of \
	apple-dockchannel dockchannel-hid apple-rtkit-helper \
	apple-sio \
	mux-apple-display-crossbar phy-apple-dptx
do
	copy_kmod "$_mod"
done

for _bin in umount cpio cp grep tr seq
do
	copy_exec "$_bin"
done
