font_dirs="/usr/share/fonts/OTF /usr/share/fonts/variable"
provides="font:monospace-0_1"

do_install() {
	vmkdir usr/share/fonts/OTF
	install -m644 ${wrksrc}/fonts/otf/*.otf ${DESTDIR}/usr/share/fonts/OTF
	vmkdir usr/share/fonts/variable
	install -m644 ${wrksrc}/fonts/variable/*.ttf ${DESTDIR}/usr/share/fonts/variable
	vinstall ${FILESDIR}/conf.avail 644 etc/fonts/conf.avail 75-inconsolata.conf
}
