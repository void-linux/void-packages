# Template file for 'eclipse'
pkgname=eclipse
version=2026.09
revision=1
_rel="${version//./-}"
_jdk=openjdk25
# Found in distfiles at eclipse/plugins/com.sun.jna_<version#>/
_jna_version="5.19.1.v20260612-1000"
archs="x86_64 aarch64"
depends="$_jdk gtk+3 libwebkit2gtk41 libXtst
 hicolor-icon-theme desktop-file-utils"
short_desc="IDE for Java and other languages"
maintainer="mobinmob <mobinmob@disroot.org>"
license="EPL-1.0"
homepage="https://eclipse.org"
make_dirs="/usr/lib/eclipse/dropins 0770 root users"
nopie=yes
nostrip=yes
python_version=3

_baseurl="https://mirror.umd.edu/eclipse/technology/epp/downloads/release"
_baseurl="https://ftp.jaist.ac.jp/pub/eclipse/technology/epp/downloads/release"
distfiles="$_baseurl/${_rel}/R/eclipse-java-${_rel}-R-linux-gtk-${XBPS_TARGET_MACHINE%-*}.tar.gz"
case ${XBPS_TARGET_MACHINE} in
	x86_64)
		checksum="1a836dcedcc353567f164964ecb251bf0477cffb26dec1cc49bcf6ec12d82eca"
		;;
	aarch64)
		checksum="37f8bff91ce2af38bb691ab0608e1184af48cb48ad04da2bb09a9568ba905f8d"
		;;
esac

# Skip JNA cross-platform binary components during dependency checks
for _jna_arch in \
	dragonflybsd-x86-64 freebsd-aarch64 \
	freebsd-x86-64 freebsd-x86 linux-aarch64 linux-armel \
		linux-arm linux-loongarch64 linux-mips64el linux-ppc64le linux-ppc \
		linux-riscv64 linux-s390x linux-x86-64 linux-x86 openbsd-x86-64 \
		openbsd-x86 sunos-sparc sunos-sparcv9 sunos-x86-64 sunos-x86; do
	skiprdeps+="/usr/lib/eclipse/plugins/com.sun.jna_${_jna_version}/com/sun/jna/${_jna_arch}/libjnidispatch.so "
done

do_build() {
	sed -i "s|^plugins/.*/bin/java|/usr/lib/jvm/$_jdk/bin/java|" eclipse.ini
	rm -rf plugins/org.eclipse.justj.openjdk*
}

do_install() {
	vmkdir usr/lib/eclipse
	cp -a ${wrksrc}/* ${DESTDIR}/usr/lib/eclipse

	vbin ${FILESDIR}/eclipse.sh eclipse
	vinstall ${FILESDIR}/eclipse.desktop 644 usr/share/applications

	for _i in 16 32 48 256; do
		install -Dm644 plugins/org.eclipse.platform_*/eclipse${_i}.png \
			${DESTDIR}/usr/share/icons/hicolor/${_i}x${_i}/apps/eclipse.png
	done
}
