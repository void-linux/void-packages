 libsecret-devel pugixml-devel libosmgpsmap-devel colord-gtk-devel
 libheif-devel portmidi-devel libjxl-devel potrace-devel
 $(vopt_if avif libavif-devel) $(vopt_if sdl2 SDL2-devel)"
