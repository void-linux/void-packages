# Template file for 'visual-paradigm'
pkgname=visual-paradigm
version=18.0
revision=1
archs="x86_64"
depends="openjdk11"
short_desc="UML design application"
maintainer="Quinten <quinten@korstanjes.nl>"
license="custom:EULA"
homepage="https://www.visual-paradigm.com"
distfiles="https://www.visual-paradigm.com/downloads/vp${version}/Visual_Paradigm_Linux64_InstallFree.tar.gz"
checksum="b43074dfe537f8f3243307ecb52b525817824195d64cc52786d8eb133e4677af"
repository=nonfree
restricted=yes
shlib_provides="libjpeg.so.62 libpng12.so.0"
nostrip_files="doxygen"
nopie_files="/opt/Visual_Paradigm/Application/bin/vp_windows/ci"

do_patch() {
	vsed -i -e 's|app_home=../../|app_home=/opt/Visual_Paradigm|' Application/bin/Visual_Paradigm*
	vsed -i -e 's|# INSTALL4J_JAVA_HOME_OVERRIDE=|INSTALL4J_JAVA_HOME_OVERRIDE=/usr/lib/jvm/java-11-openjdk|' Application/bin/Visual_Paradigm*
	vsed -i -e 's|JAVA="../jre/bin/java"|JAVA="/usr/lib/jvm/java-11-openjdk/bin/java"|' Application/scripts/*.sh
}

do_install() {
	vmkdir opt/Visual_Paradigm
	vcopy "Application" opt/Visual_Paradigm/
	vcopy ".install4j" opt/Visual_Paradigm/

	vmkdir usr/bin
	ln -s /opt/Visual_Paradigm/Application/bin/Visual_Paradigm ${DESTDIR}/usr/bin/visual-paradigm

	vmkdir usr/share/applications
	vinstall ${FILESDIR}/visual-paradigm.desktop 644 usr/share/applications/

	vmkdir usr/share/pixmaps
	vinstall Application/resources/vpuml.png 644 usr/share/pixmaps visual-paradigm.png

	chmod -R 755 ${DESTDIR}/opt/Visual_Paradigm/Application/scripts/

	vlicense ${FILESDIR}/EULA
}
