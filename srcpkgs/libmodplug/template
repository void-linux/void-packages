# Template file for 'libmodplug'
pkgname=libmodplug
version=0.8.9.2
revision=1
build_style=gnu-configure
configure_args="--enable-static"
short_desc="MOD playing library"
maintainer="Orphaned <orphan@voidlinux.org>"
license="Public Domain"
homepage="http://modplug-xmms.sourceforge.net/"
distfiles="${SOURCEFORGE_SITE}/modplug-xmms/$pkgname-$version.tar.gz"
checksum=e4d9cb46da78a639d6eadb4ff3ab955f68c3099579b5310af64b37091e28957e

libmodplug-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
