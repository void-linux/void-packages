From 388bf780619ac15104ca9f04d78aee9db15274a9 Mon Sep 17 00:00:00 2001
From: Christian Hergert <christian@sourceandstack.com>
Date: Mon, 21 Sep 2026 17:08:14 +0200
Subject: [PATCH] filelodaer: check stream read size

---
 gtksourceview/gtksourcefileloader.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/gtksourceview/gtksourcefileloader.c b/gtksourceview/gtksourcefileloader.c
index 7943459fa..51da299c2 100644
--- a/gtksourceview/gtksourcefileloader.c
+++ b/gtksourceview/gtksourcefileloader.c
@@ -263,6 +263,15 @@ check_expanded_size (GtkSourceFileLoader  *loader,
 		return TRUE;
 	}
 
+	if ((gsize)task_data->chunk_bytes_read > READ_CHUNK_SIZE)
+	{
+		g_set_error_literal (error,
+		                     GTK_SOURCE_FILE_LOADER_ERROR,
+		                     GTK_SOURCE_FILE_LOADER_ERROR_TOO_BIG,
+		                     _("File too big."));
+		return FALSE;
+	}
+
 	if (!_gtk_source_utils_checked_gssize_to_goffset (task_data->chunk_bytes_read,
 	                                                  &chunk_bytes_read) ||
 	    !_gtk_source_utils_checked_add_goffset (task_data->total_bytes_read,
