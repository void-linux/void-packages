# Template file for 'tango-icon-theme'
pkgname=tango-icon-theme
version=0.8.90
revision=2
build_style=gnu-configure
configure_args="--enable-icon-mapping
 ac_cv_path_INTLTOOL_UPDATE=/usr/bin/false
 ac_cv_path_INTLTOOL_MERGE=/usr/bin/false
 ac_cv_path_INTLTOOL_EXTRACT=/usr/bin/false
 ac_cv_path_INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="ImageMagick icon-naming-utils gettext pkg-config"
makedepends="icon-naming-utils libmagick-devel"
short_desc="Icon theme that follows the Tango visual guidelines"
maintainer="Orphaned <orphan@voidlinux.org>"
license="Public Domain"
homepage="http://tango.freedesktop.org/Tango_Icon_Library"
distfiles="http://tango.freedesktop.org/releases/${pkgname}-${version}.tar.gz"
checksum=6e98d8032d57d818acc907ec47e6a718851ff251ae7c29aafb868743eb65c88e

post_patch() {
	vsed -i configure -e '
		/DATADIRNAME=/s/=.*/=share/
		/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.50/
	'
	vsed -i 's/^_//' index.theme.in
}

pre_build() {
	msgfmt --desktop --template index.theme.in \
		-d po -o index.theme
}
