# Template file for 'for-desktop'
pkgname=for-desktop
version=1.5.3
revision=1
archs="x86_64"
makedepends="mise"
short_desc="Stoat client for desktop"
maintainer="Pedro Carreiras <pedrocarreiras@sapo.pt>"
license="AGPL-3.0-or-later"
homepage="https://stoat.chat"
_assets_commit=1e7f9990c29315f3f55acb7a420dabb6b4db1d9d
distfiles="https://github.com/stoatchat/for-desktop/archive/v${version}.tar.gz>${pkgname}-${version}.tar.gz
	https://github.com/stoatchat/assets/archive/${_assets_commit}.tar.gz>assets.tar.gz"
checksum="d038e783e6323777c20ddd15cf31de14c03e0ad27b00f7270de885589d680b41
	ab1c0557720d694d7b20e1e62179856ec3d663d54e68024b9a1b158aae2aa170"

post_extract() {
	mv ${pkgname}-${version}/{*,.[!.]*} .
	mv -T assets-${_assets_commit} assets
}

do_build() {
	mise install
	mise install:frozen
	mise build
}

do_install() {
	vmkdir usr/share/pixmaps
	vmkdir usr/lib/${pkgname}-${version}
	vmkdir usr/share/applications
	vmkdir usr/bin
	vcopy chat.stoat.StoatDesktop.desktop usr/share/applications
	vcopy out/Stoat-linux-x64/* usr/lib/${pkgname}-${version}
	vcopy assets/desktop/icon.png usr/share/pixmaps/stoat.png
	ln -sfr ${DESTDIR}/usr/lib/${pkgname}-${version}/stoat-desktop ${DESTDIR}/usr/bin/stoat-desktop
}

post_install() {
	vlicense out/Stoat-linux-x64/LICENSE
}
