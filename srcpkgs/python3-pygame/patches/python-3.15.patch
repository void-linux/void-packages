diff -ur a/src_c/surface.c b/src_c/surface.c
--- a/src_c/surface.c	2024-09-29 08:15:28.016111900 -0400
+++ b/src_c/surface.c	2026-11-27 15:00:50.942997387 -0500
@@ -1020,8 +1020,13 @@
         return NULL;
 
     for (i = 0; i < len; i++) {
-        tmp = PyWeakref_GetObject(PyList_GetItem(surf->locklist, i));
-        Py_INCREF(tmp);
+        int rc = PyWeakref_GetRef(PyList_GetItem(surf->locklist, i), &tmp);
+        if (rc < 0) {
+            Py_DECREF(tuple);
+            return NULL;
+        } else if (rc == 0) {
+            tmp = Py_NewRef(Py_None);
+        }
         PyTuple_SetItem(tuple, i, tmp);
     }
     return tuple;
@@ -3443,12 +3448,16 @@
     internal = (pg_bufferinternal *)view_p->internal;
     consumer_ref = internal->consumer_ref;
     assert(consumer_ref && PyWeakref_CheckRef(consumer_ref));
-    consumer = PyWeakref_GetObject(consumer_ref);
-    if (consumer) {
+    int rc = PyWeakref_GetRef(consumer_ref, &consumer);
+    if (rc > 0) {
         if (!pgSurface_UnlockBy((pgSurfaceObject *)view_p->obj, consumer)) {
             PyErr_Clear();
         }
+        Py_DECREF(consumer);
+    } else if (rc < 0) {
+        PyErr_Clear();
     }
+
     Py_DECREF(consumer_ref);
     PyMem_Free(internal);
     Py_DECREF(view_p->obj);
diff -ur a/src_c/surflock.c b/src_c/surflock.c
--- a/src_c/surflock.c	2024-09-29 08:15:28.016111900 -0400
+++ b/src_c/surflock.c	2026-11-27 15:09:23.994912129 -0500
@@ -124,13 +124,17 @@
         Py_ssize_t len = PyList_Size(surf->locklist);
         while (--len >= 0 && !found) {
             item = PyList_GetItem(surf->locklist, len);
-            ref = PyWeakref_GetObject(item);
-            if (ref == lockobj) {
-                if (PySequence_DelItem(surf->locklist, len) == -1) {
-                    return 0;
-                }
-                else {
-                    found = 1;
+            int rc = PyWeakref_GetRef(item, &ref);
+            if (rc > 0) {
+                int match = (ref == lockobj);
+                Py_DECREF(ref);
+                if (match) {
+                    if (PySequence_DelItem(surf->locklist, len) == -1) {
+                        return 0;
+                    }
+                    else {
+                        found = 1;
+                    }
                 }
             }
         }
@@ -139,14 +143,18 @@
         len = PyList_Size(surf->locklist);
         while (--len >= 0) {
             item = PyList_GetItem(surf->locklist, len);
-            ref = PyWeakref_GetObject(item);
-            if (ref == Py_None) {
+            int rc = PyWeakref_GetRef(item, &ref);
+            if (rc < 0) {
+                noerror = 0;
+            } else if (rc == 0) {
                 if (PySequence_DelItem(surf->locklist, len) == -1) {
                     noerror = 0;
                 }
                 else {
                     found++;
                 }
+            } else {
+                Py_DECREF(ref);
             }
         }
     }
