# Template file for 'mycelium'
pkgname=mycelium
version=0.7.10
revision=2
build_style=cargo
# The daemon crates are not part of the root workspace.
make_build_args="--manifest-path myceliumd/Cargo.toml"
make_install_args="--path myceliumd"
hostmakedepends="pkg-config"
makedepends="openssl-devel"
short_desc="End-to-end encrypted IPv6 overlay network"
maintainer="John Mitrich <johnmitrich@gmail.com>"
license=Apache-2.0
homepage="https://github.com/threefoldtech/mycelium"
changelog="https://raw.githubusercontent.com/threefoldtech/mycelium/main/CHANGELOG.md"
distfiles="https://github.com/threefoldtech/mycelium/archive/refs/tags/v${version}.tar.gz"
checksum=cc5d624366dd90b1b96d91faddeb3cbe5862128da5b3628f9327a3dfdc9db5d6

post_build() {
	cargo auditable build --release --locked --target "$RUST_TARGET" \
		--manifest-path myceliumd-private/Cargo.toml \
		--target-dir target
}

post_install() {
	vsv mycelium
	vbin "target/${RUST_TARGET}/release/mycelium-private"
	vsv mycelium-private
}

mycelium-private_package() {
	short_desc="End-to-end encrypted IPv6 overlay network - private daemon"

	pkg_install() {
		vmove usr/bin/mycelium-private
		vmove etc/sv/mycelium-private
	}
}
