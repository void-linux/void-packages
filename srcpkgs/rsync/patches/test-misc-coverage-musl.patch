Source: https://gitlab.alpinelinux.org/alpine/aports/-/blob/ef4dc64387ff9b77f4e0a8831323aac282a4073f/main/rsync/test-misc-coverage-no-glibc.patch
or it will error with

  --info=stats3 did not emit malloc stats:

--- a/testsuite/misc-coverage_test.py
+++ b/testsuite/misc-coverage_test.py
@@ -53,7 +53,7 @@ out = r.stdout + r.stderr
 # no-op (still called, and thus covered, at INFO_GTE(STATS,3), just no output).
 # show_flist_stats() is currently an empty stub.
 import platform
-if platform.system() == 'Linux':
+if platform.libc_ver()[0] == 'glibc':
     if 'heap statistics' not in out:
         test_fail(f"--info=stats3 did not emit malloc stats:\n{out}")
     # One block per process: sender + server receiver + server generator.
