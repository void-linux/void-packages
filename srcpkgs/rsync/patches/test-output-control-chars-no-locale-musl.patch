Source: https://gitlab.alpinelinux.org/alpine/aports/-/blob/ef4dc64387ff9b77f4e0a8831323aac282a4073f/main/rsync/test-output-control-chars-no-locale.patch
Do not fail the output-control-chars test when locale(1) is missing,
as is the case on musl based systems like Alpine Linux. The test
already handles having no locales available.

--- a/testsuite/output-control-chars_test.py	2026-11-05 08:12:44.117428316 +0100
+++ b/testsuite/output-control-chars_test.py	2026-11-05 08:12:44.136536886 +0100
@@ -6,8 +6,12 @@
 
 
 def available_locales():
-    proc = subprocess.run(['locale', '-a'], stdout=subprocess.PIPE,
-                          stderr=subprocess.DEVNULL)
+    try:
+        proc = subprocess.run(['locale', '-a'], stdout=subprocess.PIPE,
+                              stderr=subprocess.DEVNULL)
+    except OSError:
+        # e.g. musl based systems have no locale(1) by default
+        return {}
     if proc.returncode != 0:
         return {}
     return {name.lower(): name for name in proc.stdout.decode('ascii', 'ignore').splitlines()}
