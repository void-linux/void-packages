# Template file for 'wasi-sdk'
pkgname=wasi-sdk
version=34
revision=2
_llvmversion="23.1.4"
_llvmver="${_llvmversion%%.*}"
_wasi_libc_ref=2e6fb9d8ee0cdf9e431fbcabe8af3115de000a13
build_style=cmake
hostmakedepends="python3 clang${_llvmver} llvm${_llvmver} lld${_llvmver} llvm${_llvmver}-devel ninja
 wasm-component-ld wasm-tools"
depends="wasi-libc wasi-libcxx wasi-compiler-rt"
short_desc="WASI-enabled WebAssembly C/C++ toolchain"
maintainer="Duncaen <duncaen@voidlinux.org>"
license="custom:Apache-2.0-with-llvm-exception"
homepage="https://github.com/WebAssembly/wasi-sdk"
distfiles="https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-${_llvmversion}.tar.gz
 https://github.com/WebAssembly/wasi-sdk/archive/refs/tags/wasi-sdk-${version}.tar.gz
 https://github.com/WebAssembly/wasi-libc/archive/${_wasi_libc_ref}.zip>wasi-libc-${_wasi_libc_ref}.tar.gz"
checksum="3e1c70b30f623976c2046d94b8eeab6cac536f107914cb4ed7bac572a03131db
 3d7bc84a88b1a90a6cec5a6797e744c958bb7b357781797003a0ca2a8beaa2c9
 d4321cb88bc7bf83dd8cf9aafae57404e1f4dc360e04fb89a218a122b83be0f4"

skip_extraction="llvmorg-${_llvmversion}.tar.gz wasi-libc-${_wasi_libc_ref}.tar.gz"

conf_files="/etc/clang${_llvmver}/*.cfg"


subpackages="wasi-compiler-rt wasi-libcxx wasi-libc" # subpackages need to be ordered right

export CMAKE_GENERATOR=Ninja

post_extract() {
	vsrcextract -C src/llvm-project "llvmorg-${_llvmversion}.tar.gz"
	vsrcextract -C src/wasi-libc "wasi-libc-${_wasi_libc_ref}.tar.gz"
}

do_configure() {
	unset CFLAGS CXXFLAGS LDFLAGS
	cmake -G Ninja -B build -S . \
		-DCMAKE_INSTALL_PREFIX=build/install \
		-DCMAKE_TOOLCHAIN_FILE="${wrksrc}/wasi-sdk-p1.cmake" \
		-DCMAKE_C_COMPILER_WORKS=ON \
		-DCMAKE_CXX_COMPILER_WORKS=ON \
		-DWASI_SDK_PREFIX=/usr \
		-DWASI_SDK_VERSION="${version}"
}

do_build() {
	unset CFLAGS CXXFLAGS LDFLAGS
	cmake --build build --target dist ${makejobs}
}

do_install() {
	vmkdir "usr/lib/llvm/${_llvmver}/lib/clang/${_llvmver}/lib"
	bsdtar -x -C "${DESTDIR}/usr/lib/llvm/${_llvmver}/lib/clang/${_llvmver}/lib" --strip-components 1 -f "build/dist/libclang_rt-${version}.tar.gz"

	vmkdir usr/share/wasi-sysroot
	bsdtar -x -C "${DESTDIR}/usr/share/wasi-sysroot" --strip-components 1 -f "build/dist/wasi-sysroot-${version}.tar.gz"

	mkdir -p "${DESTDIR}/etc/clang${_llvmver}"
	cat <<-EOF >"${DESTDIR}/etc/clang${_llvmver}/wasm32-unknown-wasip1.cfg"
	--sysroot /usr/share/wasi-sysroot
	EOF
	cat <<-EOF >"${DESTDIR}/etc/clang${_llvmver}/wasm32-unknown-wasip1-threads.cfg"
	--sysroot /usr/share/wasi-sysroot
	EOF
	cat <<-EOF >"${DESTDIR}/etc/clang${_llvmver}/wasm32-unknown-wasip2.cfg"
	--sysroot /usr/share/wasi-sysroot
	EOF
	cat <<-EOF >"${DESTDIR}/etc/clang${_llvmver}/wasm32-unknown-wasip3.cfg"
	--sysroot /usr/share/wasi-sysroot
	EOF

	vlicense LICENSE
}

wasi-libcxx_package() {
	short_desc+=" - C++ standard library"
	nostrip=yes
	make_dirs="/usr/share/wasi-sysroot/include/c++/v1 0755 root root"
	pkg_install() {
		for _target in wasm32-wasip1 wasm32-wasip2 wasm32-wasip3 wasm32-wasip1-threads; do
			vmove "usr/share/wasi-sysroot/include/${_target}/eh/c++"
			vmove "usr/share/wasi-sysroot/include/${_target}/noeh/c++"
			vmove "usr/share/wasi-sysroot/lib/${_target}/noeh/libc++.a"
			vmove "usr/share/wasi-sysroot/lib/${_target}/noeh/libc++abi.a"
			vmove "usr/share/wasi-sysroot/lib/${_target}/noeh/libc++experimental.a"
			vmove "usr/share/wasi-sysroot/lib/${_target}/noeh/libc++.modules.json"
		done
		vmove usr/share/wasi-sysroot/share/libc++
		vmove usr/share/wasi-sysroot/experimental-coop-threads/share/libc++
		vmove usr/share/wasi-sysroot/experimental-coop-threads/include/wasm32-wasip3/noeh/c++
		vmove usr/share/wasi-sysroot/experimental-coop-threads/lib/wasm32-wasip3/noeh/libc++.a
		vmove usr/share/wasi-sysroot/experimental-coop-threads/lib/wasm32-wasip3/noeh/libc++abi.a
		vmove usr/share/wasi-sysroot/experimental-coop-threads/lib/wasm32-wasip3/noeh/libc++experimental.a
		vmove usr/share/wasi-sysroot/experimental-coop-threads/lib/wasm32-wasip3/noeh/libc++.modules.json
		vmove "usr/share/wasi-sysroot/experimental-coop-threads/lib/wasm32-wasip3/noeh/llvm-lto/${_llvmversion}/libc++experimental.a"
		vmove "usr/share/wasi-sysroot/experimental-coop-threads/lib/wasm32-wasip3/noeh/llvm-lto/${_llvmversion}/libc++abi.a"
		vmove "usr/share/wasi-sysroot/experimental-coop-threads/lib/wasm32-wasip3/noeh/llvm-lto/${_llvmversion}/libc++.modules.json"
		vmove "usr/share/wasi-sysroot/experimental-coop-threads/lib/wasm32-wasip3/noeh/llvm-lto/${_llvmversion}/libc++.a"
	}
}

wasi-compiler-rt_package() {
	short_desc+=" - runtime libraries"
	nostrip=yes
	pkg_install() {
		vmove "usr/lib/llvm/${_llvmver}/lib/clang/${_llvmver}/lib"
	}
}

wasi-libc_package() {
	short_desc+=" - C standard library"
	nostrip=yes
	pkg_install() {
		vmove "usr/share/wasi-sysroot/experimental-coop-threads"
		vmove "usr/share/wasi-sysroot/include"
		vmove "usr/share/wasi-sysroot/lib"
	}
}
