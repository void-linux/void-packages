# Template file for 'gdmap'
pkgname=gdmap
version=0.8.1
revision=4
build_style=gnu-configure
configure_args="
 ac_cv_path_INTLTOOL_UPDATE=/usr/bin/false
 ac_cv_path_INTLTOOL_MERGE=/usr/bin/false
 ac_cv_path_INTLTOOL_EXTRACT=/usr/bin/false
 ac_cv_path_INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="pkg-config gettext"
makedepends="gtk+-devel libxml2-devel"
short_desc="Graphical Disk Map"
maintainer="Leah Neukirchen <leah@vuxu.org>"
license="GPL-2.0-only"
homepage="http://gdmap.sourceforge.net/"
distfiles="${SOURCEFORGE_SITE}/${pkgname}/${pkgname}-${version}.tar.gz"
checksum=a200c98004b349443f853bf611e49941403fce46f2335850913f85c710a2285b

post_patch() {
	vsed -i configure -e '
		/DATADIRNAME=/s/=.*/=share/
		/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.35/
		/INTLTOOL_PERL.*fgrep.*5/s/.*/if false; then/
	'
	sed -i 's/^_//' data/gdmap.desktop.in
	printf '%s\n' po/*.po | sed 'sspo/ss;s/[.]po//' >po/LINGUAS
}

post_configure() {
	msgfmt --desktop --template data/gdmap.desktop.in \
		-d po -o data/gdmap.desktop
}
