# Template file for 'jdtls'
pkgname=jdtls
version=1.63.0
revision=1
_timestamp=202610191322
depends="virtual?java-runtime python3"
short_desc="Eclipse Java language server"
maintainer="tema5002 <tema5002@tuta.io>"
license="EPL-2.0"
homepage="https://github.com/eclipse/eclipse.jdt.ls"
distfiles="https://download.eclipse.org/jdtls/milestones/${version}/jdt-language-server-${version}-${_timestamp}.tar.gz"
checksum=b1f2abe0b3cccb462cf64fb4a5587c7d09df60cf8be7748b152cbd89d018bdc4

do_install() {
	local _dir=usr/share/java/jdtls

	vmkdir ${_dir}
	vcopy bin ${_dir}
	rm ${DESTDIR}/${_dir}/bin/jdtls.bat
	vcopy "config_linux*" ${_dir}
	vcopy "config_ss_linux*" ${_dir}
	vcopy features ${_dir}
	vcopy plugins ${_dir}

	vmkdir usr/bin
	ln -s /${_dir}/bin/jdtls "${DESTDIR}/usr/bin/jdtls"
}
