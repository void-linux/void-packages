# Template file for 'takao-fonts'
pkgname=takao-fonts
version=00303.01
revision=1
depends="font-util"
short_desc="Community developed derivatives of IPA Fonts"
maintainer="tema5002 <tema5002@tuta.io>"
license="IPA"
homepage="https://launchpad.net/takao-fonts"
distfiles="${homepage}/trunk/15.03/+download/TakaoFonts_${version}.tar.xz"
checksum=e9871f72ac69acb3e277aebbee7ca01fbebf54800733e29fafdc46133fc3552f
font_dirs="/usr/share/fonts/TTF"

do_install() {
	vmkdir usr/share/fonts/TTF
	vinstall TakaoGothic.ttf 644 usr/share/fonts/TTF
	vinstall TakaoPGothic.ttf 644 usr/share/fonts/TTF
	vinstall TakaoMincho.ttf 644 usr/share/fonts/TTF
	vinstall TakaoPMincho.ttf 644 usr/share/fonts/TTF

	vinstall ${FILESDIR}/66-takao-fonts.conf 644 usr/share/fontconfig/conf.avail
	vmkdir etc/fonts/conf.d
	ln -sf ../../../usr/share/fontconfig/conf.avail/66-takao-fonts.conf \
		${DESTDIR}/etc/fonts/conf.d/66-takao-fonts.conf

	vlicense IPA_Font_License_Agreement_v1.0.txt
}
