pkgname=kf6-prison
version=6.31.0
revision=1
build_style=cmake
hostmakedepends="extra-cmake-modules qt6-tools qt6-base
 qt6-declarative-host-tools"
makedepends="qt6-declarative-devel qt6-multimedia-devel zxing-cpp-devel
 libdmtx-devel qrencode-devel"
short_desc="Barcode API to produce QRCode barcodes and DataMatrix barcodes"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/prison"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=30cdb5564ef76c4c2a6fe509234095c1329f30165243b81008312a1182d326bc

# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version%.*}"

kf6-prison-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
