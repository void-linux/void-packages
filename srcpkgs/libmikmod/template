# Template file for 'libmikmod'
pkgname=libmikmod
version=3.3.15
revision=1
build_style=gnu-configure
short_desc="MikMod Sound Library"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later OR LGPL-2.1-or-later"
homepage="https://mikmod.sourceforge.net/"
changelog="https://mikmod.sourceforge.net/#news"
distfiles="${SOURCEFORGE_SITE}/mikmod/${pkgname}-${version}.tar.gz"
checksum=dc27b338154b8f88dc9e6317196d42c6abc13bf63c4e055257a18d4e38e1afa2

libmikmod-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/bin
		vmove usr/include
		vmove usr/share
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
