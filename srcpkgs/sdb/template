# Template file for 'sdb'
pkgname=sdb
version=2.6.2
revision=1
build_style=gnu-makefile
make_use_env=yes
hostmakedepends="pkg-config"
makedepends="vala-devel"
short_desc="Simple key-value database with JSON support"
maintainer="Orphaned <orphan@voidlinux.org>"
license="LGPL-3.0-or-later"
homepage="https://github.com/radareorg/sdb"
distfiles="https://github.com/radareorg/sdb/archive/refs/tags/${version}.tar.gz"
