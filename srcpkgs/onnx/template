# Template file for 'onnx'
pkgname=onnx
version=1.22.0
revision=1
build_helper="qemu"
build_style=cmake
# -DBUILD_SHARED_LIBS=ON currently breaks tests
configure_args="
 -DONNX_USE_PROTOBUF_SHARED_LIBS=ON
 -DONNX_BUILD_PYTHON=OFF
 -DONNX_INSTALL=ON
 -DFETCHCONTENT_FULLY_DISCONNECTED=ON
 -DFETCHCONTENT_TRY_FIND_PACKAGE_MODE=ALWAYS"
hostmakedepends="protobuf python3-build python3-installer python3-scikit-build-core python3-protobuf python3-nanobind python3-devel"
makedepends="protobuf-devel python3-devel abseil-cpp-devel python3-nanobind"
checkdepends="gtest-devel"
short_desc="Open standard for machine learning interoperability"
maintainer="Duncaen <duncaen@voidlinux.org>"
license="Apache-2.0"
homepage="https://onnx.ai/"
changelog="https://github.com/onnx/onnx/releases"
distfiles="https://github.com/onnx/onnx/archive/refs/tags/v${version}.tar.gz"
checksum=70bb8b25cf31ea9b1d9f94baacfdc8c4fa27a760f9a10f5d93881bc9eede5fbc

if [ "$XBPS_CHECK_PKGS" ] && [ -z "$CROSS_BUILD" ]; then
	configure_args+=" -DONNX_BUILD_TESTS=ON "
fi

post_build() {
	 #
	export CMAKE_ARGS="
	 -DPython3_INCLUDE_DIR:PATH=${XBPS_CROSS_BASE}/${py3_inc}
	 -DPython_INCLUDE_DIR:PATH=${XBPS_CROSS_BASE}/${py3_inc}
	 -DONNX_USE_PROTOBUF_SHARED_LIBS=ON
	 -DBUILD_SHARED_LIBS=OFF
	 -DONNX_BUILD_PYTHON=ON"
	if [ "$CROSS_BUILD" ]; then
		CMAKE_ARGS+=" -DCMAKE_TOOLCHAIN_FILE=${wrksrc}/${build_wrksrc}/build/cross_${XBPS_CROSS_TRIPLET}.cmake"
	fi
	python -m build --wheel --no-isolation
}

post_install() {
	python3 -m installer --destdir "${DESTDIR}" \
		--no-compile-bytecode dist/*.whl
}

onnx-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove "usr/lib/*.a"
		vmove usr/include
		vmove usr/lib/cmake
	}
}

python3-onnx_package() {
	short_desc+=" - Python3"
	depends="python3-numpy python3-protobuf python3-typing_extensions python3-ml_dtypes"
	pkg_install() {
		vmove "usr/lib/python${py3_ver}"
	}
}
