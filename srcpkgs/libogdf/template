# Template file for 'libogdf'
pkgname=libogdf
version=2025.10
revision=1
archs="i686* x86_64*"
build_style=cmake
configure_args="-DBUILD_SHARED_LIBS=ON"
hostmakedepends="unzip"
short_desc="Open Graph Drawing Framework"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="https://ogdf.uos.de/"
distfiles="https://ogdf.uos.de/wp-content/uploads/${version%.*}/${version#*.}/ogdf.v${version}.zip"
checksum=54f8fc9c2b44b3e4f34ca85be3ae77ce2a309337397662c1432a960367522ccb
nocross="can't find cpuid.h headers"

if [ "$XBPS_TARGET_LIBC" = musl ]; then
	broken="Non optional usage of broken mallinfo"
fi

post_install() {
	mv $DESTDIR/usr/include/coin $DESTDIR/usr/include/ogdf
}

libogdf-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
	}
}
