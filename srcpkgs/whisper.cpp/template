# Template file for 'whisper.cpp'
pkgname=whisper.cpp
version=1.9.5
revision=1
build_style=cmake
configure_args="-DWHISPER_COMMON_FFMPEG=ON -DWHISPER_BUILD_SERVER=ON
 -DWHISPER_USE_SYSTEM_GGML=ON -DWHISPER_BUILD_IS_DEV=OFF"
hostmakedepends="pkg-config"
makedepends="ffmpeg6-devel ggml-devel libgomp-devel"
short_desc="Port of OpenAI's Whisper model in C/C++"
maintainer="Mateusz Sylwestrzak <slymattz@gmail.com>"
license="MIT"
homepage="https://github.com/ggml-org/whisper.cpp"
changelog="https://github.com/ggml-org/whisper.cpp/releases"
distfiles="https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v${version}.tar.gz"
checksum=ff1a9053feb509ff9d7729703355541ae9690073a6b1c40eb692c962e0dc1720

do_check() {
	# test-vad-full: needs ggml-base.en.bin model to pass
	# test-whisper-cli-large: takes too much resources
	# test-parakeet: requires network and additional tools
	ctest --test-dir build \
		-E 'test-vad-full|test-whisper-cli-large|test-parakeet'
}

post_install() {
	vlicense LICENSE

	# downloads Whisper model files that have already been converted to ggml format
	vbin models/download-ggml-model.sh download-ggml-model
}

whisper.cpp-server_package() {
	short_desc+=" - server"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/bin/whisper-server
	}
}

whisper.cpp-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
	}
}
