# Template file for 'fonts-nanum-ttf'
pkgname=fonts-nanum-ttf
version=20250212
revision=1
depends="font-util"
short_desc="Nanum Korean fonts"
maintainer="Orphaned <orphan@voidlinux.org>"
license="OFL-1.1"
homepage="https://hangeul.naver.com/2017/nanum"
distfiles="${DEBIAN_SITE}/main/f/${pkgname%-*}/${pkgname%-*}_${version}.orig.tar.xz"
checksum=2f5a399f9df5bc69f6a0e97f382f24cbd79590f4fc66c4b621fd17cfb31ba34e
font_dirs="/usr/share/fonts/nanum"

do_install() {
	vmkdir usr/share/fonts/nanum
	find . -name '*.ttf' -exec \
		install -m644 '{}' ${DESTDIR}/usr/share/fonts/nanum ';'
}

fonts-nanum-ttf-extra_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - additional variants"
	font_dirs="/usr/share/fonts/nanum"
	pkg_install() {
		vmove usr/share/fonts/nanum/Nanum*Light.ttf
		vmove usr/share/fonts/nanum/Nanum*L.ttf
		vmove usr/share/fonts/nanum/Nanum*Lt.ttf
		vmove usr/share/fonts/nanum/Nanum*Extra*.ttf
		vmove usr/share/fonts/nanum/Nanum*EB.ttf
		vmove usr/share/fonts/nanum/Nanum*Eb.ttf
		vmove usr/share/fonts/nanum/Nanum*Hv.ttf
		vmove usr/share/fonts/nanum/Nanum*-YetHangul.ttf
		vmove usr/share/fonts/nanum/Nanum*Eco*.ttf
		vmove usr/share/fonts/nanum/NanumBarunpen*.ttf
		vmove usr/share/fonts/nanum/NanumBrush.ttf
		vmove usr/share/fonts/nanum/NanumHuman*.ttf
		vmove usr/share/fonts/nanum/NanumPen.ttf
		vmove usr/share/fonts/nanum/NanumSquare_ac*.ttf
	}
}

fonts-nanum-otf_package() {
	short_desc+=" - Open Type Fonts"
	font_dirs="/usr/share/fonts/nanum"
	pkg_install() {
		vmkdir usr/share/fonts/nanum
		find $wrksrc -name '*.otf' -exec \
			install -m644 '{}' ${PKGDESTDIR}/usr/share/fonts/nanum ';'
	}
}
