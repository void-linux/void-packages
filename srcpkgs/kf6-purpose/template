# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version}"

kf6-purpose-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} kf6-kcoreaddons-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
