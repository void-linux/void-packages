# Template file for 'nvme-cli'
pkgname=nvme-cli
version=3.1
revision=1
build_style=meson
configure_args="-Ddocs=man -Dudevrulesdir=lib/udev/rules.d -Djson-c=enabled
 -Dnvme=enabled -Dlibnvme=enabled -Dpython=enabled -Dnvmf-autoconnect=disabled"
hostmakedepends="pkg-config swig python3-packaging-bootstrap python3-mypy flake8 autopep8 python3-isort zsh asciidoc git"
makedepends="zlib-devel json-c-devel openssl-devel python3-devel keyutils-devel libkmod-devel"
short_desc="NVMe management command line interface"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-only"
homepage="https://nvmexpress.org"
changelog="https://raw.githubusercontent.com/linux-nvme/nvme-cli/master/NEWS.md"
distfiles="https://github.com/linux-nvme/nvme-cli/archive/v${version}.tar.gz"
checksum=8a6879f1f2af53743c03a8f77f247261306300d3f3b0edfd242c5f646bdfdccb
conf_files="/etc/nvme/*.conf*"

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
	configure_args+=" -Dtests=false" # error: invalid use of undefined type 'struct stat64'
fi

do_check() {
	meson test -C build ${makejobs} --print-errorlogs \
		--exclude="libnvme - tree-pcie" \
		--exclude="libnvme - tree-apple-nvme" \
		--exclude="libnvme - tree-pcie-hostnqn" \
		--exclude="libnvme - tree-apple-nvme-hostnqn" \
		--exclude="libnvme - kdoc" \
		--exclude="nvme-cli - samsung-cli"
}

libnvme3_package() {
	short_desc+=" - runtime library"
	license="LGPL-2.1-or-later"
	pkg_install() {
		vmove "usr/lib/*.so.*"
	}
}

libnvme3-devel_package() {
	short_desc+=" - development files"
	license="LGPL-2.1-or-later"
	depends="libnvme3>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}

python3-libnvme3_package() {
	short_desc+=" - Python3 bindings"
	license="LGPL-2.1-or-later"
	pkg_install() {
		vmove "usr/lib/python*"
	}
}
