Date: Tue, 3 Nov 2026 23:40:25 +0100
Subject: remove superfluous sys/unistd.h

on glibc it literally is `#include <unistd.h>`
on musl libc it's not present
---
 open-vm-tools/vgauth/lib/netPosix.c         | 1 -
 open-vm-tools/vgauth/serviceImpl/netPosix.c | 1 -
 2 files changed, 2 deletions(-)

diff --git a/open-vm-tools/vgauth/lib/netPosix.c b/open-vm-tools/vgauth/lib/netPosix.c
index bac05b9d2..0490b9a9c 100644
--- a/open-vm-tools/vgauth/lib/netPosix.c
+++ b/open-vm-tools/vgauth/lib/netPosix.c
@@ -27,7 +27,6 @@
 #include <sys/socket.h>
 #include <sys/stat.h>
 #include <unistd.h>
-#include <sys/unistd.h>
 #include <sys/un.h>
 #include <netinet/in.h>
 #include <arpa/inet.h>
diff --git a/open-vm-tools/vgauth/serviceImpl/netPosix.c b/open-vm-tools/vgauth/serviceImpl/netPosix.c
index ec878c8e3..d3e7c6c22 100644
--- a/open-vm-tools/vgauth/serviceImpl/netPosix.c
+++ b/open-vm-tools/vgauth/serviceImpl/netPosix.c
@@ -28,7 +28,6 @@
 #include <sys/socket.h>
 #include <sys/stat.h>
 #include <unistd.h>
-#include <sys/unistd.h>
 #include <sys/un.h>
 #include <netinet/in.h>
 #include <arpa/inet.h>
