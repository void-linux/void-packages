# Template file for 'livekit'
pkgname=livekit
version=1.13.11
revision=1
build_style=go
go_import_path="github.com/livekit/livekit-server"
go_package="${go_import_path}/cmd/server"
short_desc="Scalable, distributed WebRTC SFU (Selective Forwarding Unit)"
maintainer="Joel Beckmeyer <joel@beckmeyer.us>"
license="Apache-2.0"
homepage="https://github.com/livekit/livekit"
changelog="https://raw.githubusercontent.com/livekit/livekit/master/CHANGELOG.md"
distfiles="https://github.com/livekit/livekit/archive/refs/tags/v${version}.tar.gz"
checksum=c8d9b7ba9d66c8b5f314a438c0c2493815e7e70085e37706b888cab3c4ab8f8d
conf_files="/etc/livekit.yaml"
system_accounts="_livekit"
make_check=no # tests require a running redis server and docker

post_install() {
	mv "${DESTDIR}/usr/bin/"{server,livekit-server}
	vsed -i -e 's/^redis:$/# redis:/' \
		-e 's/^  address: redis.host:6379$/  # address: redis.host:6379/' \
		config-sample.yaml
	vinstall config-sample.yaml 0640 etc livekit.yaml
	vsv livekit
}
