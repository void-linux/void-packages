# Template file for 'tauonmb'
pkgname=tauonmb
version=13.1.1
revision=1
build_style=python3-pep517
python3_pep517_backend="scikit-build-core"
hostmakedepends="git cmake ninja pkg-config gettext python3-scikit-build-core python3-setuptools python3-wheel"
makedepends="python3-devel SDL3-devel chromaprint-devel libflac-devel libgme-devel libjxl-devel libopenmpt-devel opusfile-devel libvorbis-devel wavpack-devel mpg123-devel libsamplerate-devel pipewire-devel cairo-devel dbus-devel libayatana-appindicator-devel gobject-introspection"
depends="python3-BeautifulSoup4 python3-Pillow python3-PyOpenGL python3-Unidecode python3-dbus python3-gobject python3-musicbrainzngs python3-mutagen python3-pylast python3-rapidfuzz python3-requests python3-send2trash python3 SDL3 chromaprint libflac libgme libjxl libopenmpt opusfile libvorbis libwavpack libmpg123 libsamplerate libpipewire cairo dbus-libs"
short_desc="Modern music player - Tauon"
maintainer="giallorosso84 <giallorosso84@voidlinux.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/Taiko2k/Tauon"
# Using git because tarball doesn't submodules
do_fetch() {
  if [ ! -d ${XBPS_SRCDISTDIR}/${pkgname}-${version} ]; then
    git clone --recurse-submodules --branch v${version} \
      https://github.com/Taiko2k/Tauon.git \
      ${XBPS_SRCDISTDIR}/${pkgname}-${version}
  fi
}
do_extract() {
  cp -a ${XBPS_SRCDISTDIR}/${pkgname}-${version} ${XBPS_BUILDDIR}/
}
pre_build() {
  export CMAKE_PREFIX_PATH=/usr
}
