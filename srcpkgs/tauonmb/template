depends="python3-BeautifulSoup4 python3-dbus python3-jxlpy python3-musicbrainzngs python3-mutagen python3-Pillow python3-gobject python3-pylast python3-PyOpenGL python3-rapidfuzz python3-requests python3-send2trash python3-Unidecode python3-natsort python3-colored-traceback python3-setproctitle python3-zeroconf python3-pypresence python3-plexapi ffmpeg SDL3 chromaprint libopenmpt opusfile"
short_desc="Tauon Music Box - modern music player"
