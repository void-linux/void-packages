license="GPL-3.0-or-later"
homepage="https://tauonmusicbox.rocks/"
distfiles="https://github.com/Taiko2k/Tauon/archive/refs/tags/v${version}.tar.gz
 https://github.com/mborgerding/kissfft/archive/f5f2a3b2f2cd02bf80639adb12cbeed125bdf420.tar.gz>kissfft-f5f2a3b.tar.gz
