build_wrksrc="Tauon-${version}"

post_extract() {
	rm -rf Tauon-${version}/src/phazor/kissfft Tauon-${version}/src/phazor/miniaudio
	mv kissfft-f5f2a3b2f2cd02bf80639adb12cbeed125bdf420 Tauon-${version}/src/phazor/kissfft
	mv miniaudio-4a5b74bef029b3592c54b6048650ee5f972c1a48 Tauon-${version}/src/phazor/miniaudio
}

post_install() {
	vinstall src/tauon/assets/svg/app-icon.svg 644 usr/share/icons/hicolor/scalable/apps tauon.svg
	vmkdir usr/share/applications
	cat > ${DESTDIR}/usr/share/applications/tauonmb.desktop <<EOF
[Desktop Entry]
Version=1.1
Comment=Play the music you own
GenericName=Audio Player
GenericName[ja]=音楽プレイヤー
GenericName[zh_CN]=音乐播放器
GenericName[de]=Musik-Player
GenericName[pt_BR]=Reprodutor de Áudio
Keywords=Music;MP3;OGG;FLAC;OPUS;Convert;Stream;Podcast;Playlist;Last.fm;PHAzOR;Radio;
Keywords[pt_BR]=Música;MP3;OGG;FLAC;OPUS;Converter;Transmissão;Podcast;Playlist;Last.fm;PHAzOR;Rádio;
Name=Tauon
Name[pt_BR]=Tauon
Exec=tauon %U
Icon=tauonmb
MimeType=application/ogg;audio/x-vorbis+ogg;application/x-ogg;audio/ogg;audio/x-ogg;audio/x-opus+ogg;audio/flac;audio/x-flac;application/flac;audio/wav;audio/x-wav;audio/tta;audio/x-tta;audio/mpeg;audio/mp3;audio/x-mp3;audio/m4a;audio/x-m4a;audio/ape;audio/x-ape;x-content/audio-player;audio/scpls;audio/x-scpls;audio/x-pls;audio/m3u;application/xspf+xml
StartupNotify=false
StartupWMClass=Tauon Music Box
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;Music;
Actions=PlayPause;Previous;Next;Stop
X-GNOME-UsesNotifications=true

[Desktop Action PlayPause]
Exec=tauon --playpause
Name=Play/Pause

[Desktop Action Previous]
Exec=tauon --previous
Name=Previous Track

[Desktop Action Next]
Exec=tauon --next
Name=Next Track

[Desktop Action Stop]
Exec=tauon --stop
Name=Stop
EOF
}
