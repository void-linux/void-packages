post_extract() {
	vsrcextract -C src/phazor/kissfftudio "kissfft-${_kissfft_rev}.tar.gz"
	vsrcextract -C src/phazor/miniaudio "miniaudio-${_miniaudio_rev}.tar.gz"
}

post_install() {
	vinstall src/tauon/assets/svg/app-icon.svg 644 usr/share/icons/hicolor/scalable/apps tauon.svg
	vmkdir usr/share/applications
	cat > ${DESTDIR}/usr/share/applications/tauon.desktop <<EOF
[Desktop Entry]
Name=Tauon Music Box
Comment=Modern music player
Exec=tauon
Icon=tauon
Terminal=false
Type=Application
Categories=Audio;Music;Player;AudioVideo;
StartupWMClass=tauon
EOF
}
