post_patch() {
	if [ "$CROSS_BUILD" ]; then
		vsed -i src/meson.build \
			-e "s%rust_target /%'${RUST_TARGET}' / &%"
	fi
}

do_check() {
	# skip cargo-test (debug_assert! is disabled in release builds)
	# skip cargo-clippy (-D warnings fails on newer Rust lints)
	meson test -C build validate-desktop validate-gschema validate-appdata
}
