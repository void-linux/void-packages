# on 32bit builds of taglib 2.3.2, RIFF readers may overflow the readBlock length
# https://github.com/taglib/taglib/issues/1446
# https://github.com/taglib/taglib/pull/1453
diff --git a/src/core/engine/input/taglibparser.cpp b/src/core/engine/input/taglibparser.cpp
index 2b20e6b48..bc116ecfd 100644
--- a/src/core/engine/input/taglibparser.cpp
+++ b/src/core/engine/input/taglibparser.cpp
@@ -156,10 +156,12 @@ public:
         if(!isOpen()) {
             qCDebug(TAGLIB) << "Unable to read unopened file";
             return {};
         }
 
+        if (static_cast<qint64>(length) > m_input->bytesAvailable()) { length = m_input->bytesAvailable(); }
+
         std::vector<char> data(length);
         const auto lenRead = m_input->read(data.data(), static_cast<qint64>(length));
         if(lenRead < 0) {
             return {};
         }
