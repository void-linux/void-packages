qt6-httpserver-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} qt6-base-devel
	 qt6-websockets-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/pkgconfig
		vmove usr/lib/qt6
		vmove "usr/lib/*.prl"
		vmove "usr/lib/*.so"
	}
}
