post_patch() {
	# In file included from src/daemon.c:20:
	# /usr/include/sys/prctl.h:88:8: error: redefinition of 'struct prctl_mm_map'
	vsed -i src/daemon.c -e '/#include <linux\/prctl.h>/d'
}

post_install() {
	vsv mbpfan
}
