# Template file for 'sound-theme-freedesktop'
pkgname=sound-theme-freedesktop
version=0.8
revision=3
build_style=gnu-configure
configure_args="--enable-icon-mapping
 ac_cv_path_INTLTOOL_UPDATE=/usr/bin/false
 ac_cv_path_INTLTOOL_MERGE=/usr/bin/false
 ac_cv_path_INTLTOOL_EXTRACT=/usr/bin/false
 ac_cv_path_INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="pkg-config gettext"
short_desc="Freedesktop sound theme"
maintainer="Orphaned <orphan@voidlinux.org>"
license="custom:multiple"
homepage="http://freedesktop.org/wiki/Specifications/sound-theme-spec"
distfiles="http://people.freedesktop.org/~mccann/dist/sound-theme-freedesktop-${version}.tar.bz2"
checksum=cb518b20eef05ec2e82dda1fa89a292c1760dc023aba91b8aa69bafac85e8a14

post_patch() {
	vsed -i configure -e '
		/DATADIRNAME=/s/=.*/=share/
		/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.50/
	'
	vsed -i 's/^_//' index.theme.in
}

pre_build() {
	msgfmt --desktop --template index.theme.in \
		-d po -o index.theme
}

post_install() {
	vlicense CREDITS
}
