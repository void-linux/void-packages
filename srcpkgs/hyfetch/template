post_install() {
	vlicense LICENSE.md
}

# overriding do_install(), since by default it will pointlessly rebuild the package again
do_install() {
	vbin target/${RUST_TARGET}/release/hyfetch
	#ln -s "hyfetch" "${DESTDIR}/usr/bin/hyfetch"

	for doc in docs/*; do
		vman $doc
	done
}
