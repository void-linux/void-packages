# Template file for 'kf6-bluez-qt'
# group=kde-frameworks
pkgname=kf6-bluez-qt
version=6.29.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml"
hostmakedepends="extra-cmake-modules qt6-tools qt6-base
 qt6-declarative-host-tools"
makedepends="qt6-declarative-devel"
checkdepends="dbus"
short_desc="Qt wrapper for Bluez 5 DBus API"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/bluez-qt"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=15e2ae85d0e3e205cd17c3c5f079d2263abc4a341fbf223b2561510f69382a2b

# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	dbus-run-session ctest -E "bluezqt-managertest"
}

kf6-bluez-qt-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
