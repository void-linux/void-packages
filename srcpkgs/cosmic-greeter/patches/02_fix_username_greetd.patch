Upstream's greetd config launches a "cosmic-greeter-start" wrapper
script as a "cosmic-greeter" user, neither of which this package ships
(see 04_justfile-remove-systemd.patch, which drops the Debian-only
start script entirely). Run cosmic-comp directly instead, as the
"_cosmicgreeter" system account this package actually creates.

--- a/cosmic-greeter.toml	2026-01-01 23:01:48.756565198 +0100
+++ b/cosmic-greeter.toml	2026-01-01 23:02:31.873561140 +0100
@@ -5,5 +5,5 @@
 service = "cosmic-greeter"
 
 [default_session]
-command = "cosmic-greeter-start"
-user = "cosmic-greeter"
+command = "cosmic-comp cosmic-greeter"
+user = "_cosmicgreeter"
