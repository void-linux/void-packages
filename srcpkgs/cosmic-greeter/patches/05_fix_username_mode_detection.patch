The binary picks greeter-vs-locker mode by the current username, hardcoded
to upstream's "cosmic-greeter". Void names the account _cosmicgreeter
(patches 01/02) because the xbps system-accounts trigger cannot handle
dashes in account names, so the greeter silently started in screen-locker
mode instead: it session-locked cosmic-comp and never mapped a surface,
leaving only a grey screen.

--- a/src/main.rs
+++ b/src/main.rs
@@ -30,7 +30,7 @@

     match pwd::Passwd::current_user() {
         Some(current_user) => match current_user.name.as_str() {
-            "cosmic-greeter" => greeter::main(),
+            "cosmic-greeter" | "_cosmicgreeter" => greeter::main(),
             _ => locker::main(current_user),
         },
         _ => Err("failed to determine current user".into()),
