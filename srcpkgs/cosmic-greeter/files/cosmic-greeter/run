#!/bin/sh
exec 2>&1
sv check dbus >/dev/null || exit 1
sv check cosmic-greeter-daemon >/dev/null || exit 1
# pam_elogind.so (debian/cosmic-greeter.pam) needs a running logind to
# register the session; without this greetd starts but logins fail.
# elogind also ships a D-Bus activation file for org.freedesktop.login1;
# if the name is requested before the supervised elogind claims it, dbus
# spawns an unsupervised copy that keeps the name and the elogind service
# crash-loops forever. Kill any elogind runit doesn't own so the
# supervised one can claim the name on its next restart.
if [ -d /var/service/elogind ]; then
	# sv check first: supervise/pid isn't guaranteed fresh until runsv has
	# confirmed the service up, so reading it earlier can return a stale
	# PID (0 on first start) and cause the loop below to kill the real,
	# just-started elogind instead of a stray.
	sv check elogind >/dev/null
	elogind_pid=$(cat /var/service/elogind/supervise/pid 2>/dev/null)
	for pid in $(pgrep -x 'elogind'; pgrep -x 'elogind-daemon'); do
		[ "$pid" = "$elogind_pid" ] || kill "$pid"
	done
fi
sv check elogind >/dev/null || exit 1
exec greetd -c /etc/greetd/cosmic-greeter.toml
