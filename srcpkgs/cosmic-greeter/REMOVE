#!/bin/sh
case "$ACTION" in
pre)
	if [ "$UPDATE" = "no" ]; then
		if [ "$(readlink -f . 2>/dev/null || echo .)" != "/" ]; then
			prefix="-P ."
		fi
		usermod ${prefix} -L -d /var/empty -s /bin/false \
			-c "cosmic-greeter - for uninstalled package ${PKGNAME}" \
			cosmic-greeter >/dev/null 2>&1
	fi
	;;
esac
