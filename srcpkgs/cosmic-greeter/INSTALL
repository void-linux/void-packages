#!/bin/sh
# Creates the cosmic-greeter system account.
#
# Not done via system_accounts: the xbps trigger builds shell variable
# names from the account name (<account>_homedir, ...), which a dash in
# the name silently mangles (the user would get the bogus homedir
# "-greeter_homedir"). useradd/groupadd handle dashes fine.
case "$ACTION" in
post)
	if [ "$UPDATE" = "no" ]; then
		if [ "$(readlink -f . 2>/dev/null || echo .)" != "/" ]; then
			prefix="-P ."
		fi

		# -U creates the matching system group in one step.
		if ! getent passwd cosmic-greeter >/dev/null 2>&1; then
			useradd ${prefix} -r -U -G video,input \
				-d /var/lib/cosmic-greeter -s /usr/sbin/nologin \
				-c "Cosmic Greeter Account" cosmic-greeter
			usermod ${prefix} -L cosmic-greeter >/dev/null 2>&1
		fi

		mkdir -p var/lib/cosmic-greeter
		chown cosmic-greeter:cosmic-greeter var/lib/cosmic-greeter
		chmod 750 var/lib/cosmic-greeter
	fi
	;;
esac
