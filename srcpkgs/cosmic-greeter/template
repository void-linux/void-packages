# Template file for 'cosmic-greeter'
pkgname=cosmic-greeter
version=1.6.0
revision=1
archs="x86_64*"
_tag=epoch-${version}
build_style=cargo
configure_args="--all"
hostmakedepends="pkg-config just llvm18-devel"
makedepends="libxkbcommon-devel eudev-libudev-devel pam-devel libinput-devel libdav1d-devel"
depends="greetd elogind dbus cosmic-comp cosmic-session libxkbcommon pam-libs"
short_desc="COSMIC greeter for greetd"
maintainer="Benjamin Calderon <benj.calderon@gmail.com>"
license="GPL-3.0-only"
homepage="https://github.com/pop-os/cosmic-greeter"
distfiles="https://github.com/pop-os/cosmic-greeter/archive/refs/tags/${_tag}.tar.gz"
checksum=d8d4135d926c0f2673dbb8ddb6120a7dc5f992811798ca193372db904f385f76
conf_files="/etc/pam.d/cosmic-greeter /etc/greetd/cosmic-greeter.toml"

export VERGEN_GIT_COMMIT_DATE="${version}_${revision}"
export VERGEN_GIT_SHA="${version}_${revision}"

do_install() {
	just --set cargo-target-dir "target/${RUST_TARGET}" --set rootdir ${DESTDIR} --set prefix /usr install

	vinstall ${FILESDIR}/cosmic-greeter.pam 644 etc/pam.d cosmic-greeter
	vinstall ${FILESDIR}/cosmic-greeter.toml 644 etc/greetd
	vsv cosmic-greeter-daemon
	vsv cosmic-greeter
}
