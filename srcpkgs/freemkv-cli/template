# Template file for 'freemkv-cli'
pkgname=freemkv-cli
version=1.8.9
revision=1
build_style=cargo
hostmakedepends="pkg-config"
short_desc="Open source 4K UHD / Blu-ray / HD DVD / DVD backup tool - CLI"
maintainer="Mateusz Sylwestrzak <slymattz@gmail.com>"
license="MIT"
homepage="https://freemkv.org"
changelog="https://raw.githubusercontent.com/freemkv/freemkv/main/CHANGELOG.md"
distfiles="https://github.com/freemkv/freemkv/archive/refs/tags/v${version}.tar.gz"
checksum=e6d9097516d3dbbfa054c5b4dc5336ee598865293a57552853312678da2fd7fa

if [ "$XBPS_TARGET_WORDSIZE" = 32 ]; then
	broken="error[E0308]: mismatched types"
fi

if [ "$XBPS_TARGET_LIBC" = glibc ]; then
	# gtk4 GUI is broken on musl
	# it is documented upstream
	makedepends+=" glib-devel gtk4-devel libadwaita-devel"
	subpackages="freemkv"
else
	# do not produce freemkv subpackage for musl
	# an empty string would make xbps-src detect this subpkg
	subpackages=" "
fi

post_build() {
	cp "target/${RUST_TARGET}/release/freemkv" freemkv-cli

	if [ "$XBPS_TARGET_LIBC" = glibc ]; then
		(
			configure_args+=" --features gui"
			do_build
		)
	cp "target/${RUST_TARGET}/release/freemkv" freemkv-gui
	fi
}

do_install() {
	vbin freemkv-cli
}

post_install() {
	vlicense LICENSE
}

freemkv_package() {
	short_desc="${short_desc//CLI/CLI and GUI}"

	pkg_install() {
		vbin "${wrksrc}/freemkv-gui" freemkv
		vlicense LICENSE

		vinstall packaging/flatpak/org.freemkv.FreeMKV.desktop \
			644 usr/share/applications

		vinstall res/freemkv-icon.svg \
			644 usr/share/icons/hicolor/scalable/apps \
			org.freemkv.FreeMKV.svg
	}
}
