# Template file for 'thin-provisioning-tools'
pkgname=thin-provisioning-tools
version=1.3.4
revision=1
build_style=cargo
hostmakedepends="pkg-config clang device-mapper-bootstrap"
makedepends="eudev-libudev-devel device-mapper-bootstrap"
short_desc="Tools for manipulating the metadata of dm-thin device-mapper targets"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://github.com/jthornber/thin-provisioning-tools"
changelog="https://raw.githubusercontent.com/jthornber/thin-provisioning-tools/main/CHANGES"
distfiles="${homepage}/archive/v${version}.tar.gz"
checksum=e09caa006ee6ff1e0b32dea934e6cb5d96412cd31163d82bd7ccdc1ac06304d5
# Does a ton of disk IO.
make_check=extended

post_patch() {
	vsed -e "s:target/release/pdata_tools:target/${RUST_TARGET}/release/pdata_tools:" -i Makefile
}

# cross build pollutes devicemapper-sys build script
pre_build() {
	if [ "$CROSS_BUILD" ]; then
		export HOST_PKG_CONFIG="$PKG_CONFIG_FOR_BUILD"
		export "BINDGEN_EXTRA_CLANG_ARGS_${RUST_BUILD//-/_}="
	fi
}

pre_install() {
	pre_build
}

post_install() {
	make DESTDIR=${DESTDIR} BINDIR=${DESTDIR}/usr/bin install
}
