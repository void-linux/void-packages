# Template file for 'starship'
pkgname=starship
version=1.27.0
revision=1
build_style=cargo
build_helper=qemu
checkdepends="git fish-shell"
short_desc="Minimal, fast and customizable cross-shell prompt"
maintainer="cinerea0 <cinerea0@protonmail.com>"
license="ISC"
homepage="https://starship.rs"
changelog="https://raw.githubusercontent.com/starship/starship/master/CHANGELOG.md"
distfiles="https://github.com/starship/starship/archive/refs/tags/v${version}.tar.gz"
checksum=f1887ffa88a7ba437d2932501794047e28d03387996f7d1c364631c053cffc44
make_check_pre="env HOME=${wrksrc}/fake-home"

_setup_env() {
	# workaround the cc-rs mixing CFLAGS for host and target.
	# https://github.com/rust-lang/cc-rs/issues/1469
	export CFLAGS_${RUST_BUILD//-/_}="${CFLAGS_host}" \
		CXXFLAGS_${RUST_BUILD//-/_}="${CXXFLAGS_host}" \
		LDFLAGS_${RUST_BUILD//-/_}="${LDFLAGS_host}" \
		CFLAGS_${RUST_TARGET//-/_}="${CFLAGS}" \
		CXXFLAGS_${RUST_TARGET//-/_}="${CXXFLAGS}" \
		LDFLAGS_${RUST_TARGET//-/_}="${LDFLAGS}" \
		CFLAGS="" CXXFLAGS="" LDFLAGS=""
}

pre_build() {
	_setup_env
}

pre_check() {
	_setup_env
	mkdir -p fake-home
}

pre_install() {
	_setup_env
}

post_install() {
	for shell in bash fish zsh; do
		vtargetrun ${DESTDIR}/usr/bin/starship completions ${shell} > starship.${shell}
		vcompletion starship.${shell} ${shell}
	done

	vlicense LICENSE
}
