# Template file for 'fcitx5-lotus'
pkgname=fcitx5-lotus
version=7.0.2
revision=1
build_style=cmake
configure_args="-DLOTUS_UINPUT_PROXY_USER=_uinput_proxy -DINSTALL_RUNIT=ON
 -DRUNIT_SV_DIR=/usr/share/examples/sv $(vopt_bool settings BUILD_QML_SETTING)"
hostmakedepends="extra-cmake-modules pkgconf gettext wayland-devel $(vopt_if settings qt6-base)"
makedepends="libfcitx5-devel libinput-devel eudev-libudev-devel libevdev-devel
 libnotify-devel libxcb-devel dbus-devel wayland-devel $(vopt_if settings qt6-declarative-devel)"
depends="fcitx5 acl-progs"
checkdepends="dbus xvfb-run"
short_desc="Fcitx5 - Vietnamese IME"
maintainer="Coolllyn <leanhduc673@gmail.com>"
license="GPL-3.0-or-later AND MIT"
homepage="https://github.com/LotusInputMethod/fcitx5-lotus"
changelog="https://github.com/LotusInputMethod/fcitx5-lotus/releases"
distfiles="https://github.com/LotusInputMethod/fcitx5-lotus/archive/refs/tags/v${version}.tar.gz>fcitx5-lotus-${version}.tar.gz"
checksum=07cf0e599eecafa1c4c2b21d778b293e7f90af4c27205ee0bd5ab1396654841f
system_accounts="_uinput_proxy"
_uinput_proxy_groups="input"

build_options="settings"
desc_option_settings="Build the Qt Quick settings GUI"
build_options_default="settings"

subpackages="$(vopt_if settings fcitx5-lotus-settings)"

if [ "$XBPS_CHECK_PKGS" ]; then
	configure_args+=" -DBUILD_TESTING=ON"
fi

post_install() {
	vlicense lotus/LICENSE.bamboo-core
	vdoc ${FILESDIR}/README.voidlinux
}

fcitx5-lotus-settings_package() {
	short_desc+=" - Settings"
	depends="${sourcepkg}>=${version}_${revision} qt6-svg"
	pkg_install() {
		vmove usr/bin/fcitx5-lotus-settings
		vmove usr/share/applications/org.fcitx.Fcitx5.Addon.Lotus.Settings.desktop
		vlicense settings-gui/qml/DCommon/LICENSE DCommon.LICENSE
	}
}
