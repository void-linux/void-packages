# Template file for 'python3-llvmlite'
pkgname=python3-llvmlite
version=0.50.0
revision=1
_llvmver=22
build_style=python3-module
hostmakedepends="python3-setuptools python3-wheel cmake pkg-config"
makedepends="python3-devel zlib-devel llvm${_llvmver}-devel
 libffi-devel libedit-devel libxml2-devel libzstd-devel"
depends="python3 llvm${_llvmver}"
short_desc="Lightweight LLVM Python binding for Numba"
maintainer="ihateemoji <ihateemoji.dev@gmail.com>"
license="BSD-2-Clause"
homepage="https://github.com/numba/llvmlite"
changelog="https://github.com/numba/llvmlite/blob/main/CHANGE_LOG"
distfiles="https://github.com/numba/llvmlite/archive/refs/tags/v${version}.tar.gz"
checksum=30fca6c79b243ceda5cdc62c318292179f0703dd70e58adc6f2b5493e526d2fb

export LLVMLITE_SHARED=1

pre_build() {
	local _prefix="/usr/lib/llvm/${_llvmver}"
	if [ -n "$CROSS_BUILD" ]; then
		_prefix="${XBPS_CROSS_BASE}${_prefix}"
	fi
	export CMAKE_PREFIX_PATH="${_prefix}"
	export LLVM_DIR="${_prefix}/lib/cmake/llvm"
	export PATH="/usr/bin:${PATH}"
}

do_check() {
	python3 runtests.py
}

post_install() {
	vlicense LICENSE
}
