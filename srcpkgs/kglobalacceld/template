# Template file for 'kglobalacceld'
# group=kde-plasma
pkgname=kglobalacceld
version=6.8.3
revision=1
build_style=cmake
hostmakedepends="extra-cmake-modules qt6-base qt6-tools kf6-kconfig"
makedepends="kf6-kglobalaccel-devel kf6-kconfig-devel kf6-kcrash-devel
 kf6-kdbusaddons-devel kf6-kwindowsystem-devel kf6-kservice-devel
 kf6-kio-devel qt6-base-private-devel"
short_desc="Daemon providing Global Keyboard Shortcut functionality"
maintainer="John <me@johnnynator.dev>"
license="GPL-3.0-or-later"
homepage="https://invent.kde.org/plasma/kglobalacceld"
distfiles="${KDE_SITE}/plasma/${version}/${pkgname}-${version}.tar.xz"
checksum=e0fa8b3d951e85d1713e92f4d5c0622a5b0cd441a50383b8b26ac25cceab45c6

# stage builds
makedepends+=" kde-plasma-base"
shlib_requires="KDE_Plasma.${version}"

do_check() {
	cd build
	ctest -E "shortcutstest|migrateconfigtest|allowlisttest"
}

kglobalacceld-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		#vmove "usr/lib/*.so"
	}
}

khotkeys_package() {
	metapackage=yes
	depends="kglobalacceld"
	short_desc+=" - transition"
}
