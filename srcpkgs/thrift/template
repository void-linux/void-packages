# Template file for 'thrift'
pkgname=thrift
version=0.25.0
revision=1
build_style=cmake
configure_args="-DBUILD_SHARED_LIBS=ON -DWITH_AS3=OFF -DWITH_JAVA=OFF -DWITH_JAVASCRIPT=OFF -DWITH_NODEJS=OFF -DWITH_PYTHON=ON"
hostmakedepends="flex bison python3-build python3-setuptools python3-wheel python3-installer"
makedepends="boost-devel openssl-devel libevent-devel zlib-devel"
short_desc="Apache Thrift compiler"
maintainer="Jason Elswick <jason@jasondavid.us>"
license="Apache-2.0"
homepage="https://thrift.apache.org/"
distfiles="https://github.com/apache/thrift/archive/v${version}.tar.gz"
checksum=f6aa5fadd01320e17c73e0c1f3b22c858bd235fe5214a5dd9cd5c830822c4529

if [ "$CROSS_BUILD" ]; then
	configure_args+=" -DBUILD_TESTING=OFF -DBUILD_TUTORIALS=OFF"
fi

post_configure() {
	cat > build/CTestCustom.cmake <<-EOF
	set(CTEST_CUSTOM_TESTS_IGNORE
		UnitTests
		StressTest
		StressTestConcurrent
		StressTestNonBlocking
	)
	EOF
}

post_install() {
	cd lib/py
	python3 -m build --wheel --no-isolation
	python3 -m installer --destdir="${DESTDIR}" dist/*.whl
}

thrift-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/cmake
		vmove usr/lib/pkgconfig
	}
}

thrift-python3_package() {
	short_desc+=" - Python3 bindings"
	depends="python3-Twisted python3-tornado python3-zope.interface"
	pkg_install() {
		vmove "${py3_sitelib}"
	}
}
