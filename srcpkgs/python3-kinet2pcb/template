make_check=no

post_patch() {
	# setuptools tries to fetch pytest-runner (setup_requires) via pip,
	# which is unavailable in the build chroot
	vsed -e '/^setup_requirements = \[/,/^\]/d' -e '/setup_requires=setup_requirements,/d' -i setup.py
}

post_install() {
	vlicense LICENSE
}
