# Template file for 'deadlock-mod-manager'
pkgname=deadlock-mod-manager
version=1.1.0
revision=1
build_helper="rust"
build_wrksrc=apps/desktop
hostmakedepends="cargo pkg-config pnpm libprotobuf protobuf protobuf-devel"
makedepends="gtk+3-devel libayatana-appindicator-devel libwebkit2gtk41-devel
 libsoup3-devel openssl-devel rust-std libprotobuf protobuf protobuf-devel"
depends="desktop-file-utils hicolor-icon-theme xdg-utils"
short_desc="Mod manager for the Valve game Deadlock"
maintainer="Simon Larsson <simon.larsson-general@protonmail.com>"
license="GPL-3.0-only"
homepage="https://github.com/deadlock-mod-manager/deadlock-mod-manager"
changelog="https://github.com/deadlock-mod-manager/deadlock-mod-manager/releases"
distfiles="https://github.com/deadlock-mod-manager/deadlock-mod-manager/archive/refs/tags/v${version}.tar.gz"
checksum=d37f382cc3708ed6cd2de12e43fc92f0f00eb96bcbd711659e773118c10a31b1

pre_build() {
	# v1.1.0 pins valveprotos to deadlock-api/valveprotos-rs, which was merged
    # into the deadlock-api monorepo (same rev). Drop once _pkgver moves past 1.1.0.
	vsed -i 's#deadlock-api/valveprotos-rs#deadlock-api/deadlock-api#' src-tauri/Cargo.toml Cargo.lock

	pnpm install
}

do_build() {
	export CARGO_BUILD_TARGET="$RUST_TARGET"
	export VITE_API_URL="https://api.deadlockmods.app"
	export VITE_WEB_URL="https://deadlockmods.app"
	export VITE_AUTH_URL="https://auth.deadlockmods.app"

	pnpm tauri build --no-bundle
}

do_install() {
	vinstall ../../distribution/aur/deadlock-modmanager.desktop 644 usr/share/applications
	vbin target/${RUST_TARGET}/release/deadlock-mod-manager deadlock-modmanager
	vinstall src-tauri/icons/32x32.png 644 usr/share/icons/hicolor/32x32/apps deadlock-modmanager.png
	vinstall src-tauri/icons/128x128.png 644 usr/share/icons/hicolor/128x128/apps deadlock-modmanager.png
	vinstall src-tauri/icons/128x128@2x.png 644 usr/share/icons/hicolor/256x256/apps deadlock-modmanager.png
	vinstall src-tauri/icons/icon.png 644 usr/share/icons/hicolor/512x512/apps deadlock-modmanager.png
	vinstall src-tauri/dev.stormix.deadlock-mod-manager.metainfo.xml 644 usr/share/metainfo
}
