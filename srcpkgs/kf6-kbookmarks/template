# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version}"

kf6-kbookmarks-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}
	 kf6-kwidgetsaddons-devel qt6-base-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
