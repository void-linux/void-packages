# Template file for 'gnome-screensaver'
pkgname=gnome-screensaver
version=3.6.1
revision=5
build_style=gnu-configure
configure_args="--enable-compile-warnings=minimum
 ac_cv_path_INTLTOOL_UPDATE=/usr/bin/false
 ac_cv_path_INTLTOOL_MERGE=/usr/bin/false
 ac_cv_path_INTLTOOL_EXTRACT=/usr/bin/false
 ac_cv_path_INTLTOOL_PERL=/usr/bin/true
 "
hostmakedepends="pkg-config automake gettext glib-devel"
makedepends="gnome-desktop-devel dbus-glib-devel pam-devel"
depends="gnome-desktop libgnomekbd dbus"
short_desc="GNOME's screensaver that can replace xscreensaver"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="https://wiki.gnome.org/Projects/GnomeScreensaver"
distfiles="${GNOME_SITE}/${pkgname}/${version%.*}/${pkgname}-${version}.tar.xz"
checksum=f39b78d4f7fed748c7f0a31d694112fb907c6d3c4e63db22eb858df07e962cd0

post_patch() {
	vsed -i configure -e '
		/DATADIRNAME=/s/=.*/=share/
		/INTLTOOL_APPLIED_VERSION=/s/=.*/=0.50/
	'
	vsed -i 's/^_//' src/$pkgname.desktop.in
}

pre_build() {
	msgfmt --desktop --template src/$pkgname.desktop.in \
		-d po -o src/$pkgname.desktop
}
