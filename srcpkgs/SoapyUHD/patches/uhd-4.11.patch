From 3a97da9401ae245e8a604af5e1e0dbb044569f0a Mon Sep 17 00:00:00 2001
From: Ryan Volz <ryan.volz@gmail.com>
Date: Fri, 25 Sep 2026 17:08:13 -0400
Subject: [PATCH] UHDSoapyDevice: define get_stream_info for UHD>=4.11 (#78)

Signed-off-by: Ryan Volz <ryan.volz@gmail.com>
---
 UHDSoapyDevice.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

--- a/UHDSoapyDevice.cpp
+++ b/UHDSoapyDevice.cpp
@@ -715,6 +715,13 @@ public:
     }
     #endif
 
+    #if UHD_VERSION >= 4110000
+    uhd::device_addr_t get_stream_info(const size_t /*chan*/) const override
+    {
+        throw uhd::not_implemented_error("get_stream_info is not implemented here!");
+    }
+    #endif
+
 private:
     SoapySDR::Device *_device;
     SoapySDR::Stream *_stream;
@@ -867,6 +874,13 @@ public:
     }
     #endif
 
+    #if UHD_VERSION >= 4110000
+    uhd::device_addr_t get_stream_info(const size_t /*chan*/) const override
+    {
+        throw uhd::not_implemented_error("get_stream_info is not implemented here!");
+    }
+    #endif
+
 private:
     bool _active;
     SoapySDR::Device *_device;
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -165,7 +165,7 @@ install(TARGETS soapySupport
 )
 
 #using C++11 features for this uhd module
-set_target_properties(soapySupport PROPERTIES CXX_STANDARD 11)
+set_target_properties(soapySupport PROPERTIES CXX_STANDARD 17)
 
 ########################################################################
 # rpath setup - http://www.cmake.org/Wiki/CMake_RPATH_handling
