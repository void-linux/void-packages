# Template file for 'typescript'
pkgname=typescript
version=6.0.3
revision=1
archs="~i686*"
hostmakedepends="nodejs"
depends="nodejs"
short_desc="JavaScript with syntax for types"
maintainer="xJayMorex <github@johntaylor.hu>"
license="Apache-2.0"
homepage="https://github.com/microsoft/TypeScript"
distfiles="https://github.com/microsoft/TypeScript/archive/refs/tags/v${version}.tar.gz"
checksum=c26953b79c1197e02f5666a0b612d5b9707339557aa9744097e7d5719de1a117

do_configure() {
	npm ci
}

do_build() {
	npx hereby LKG
}

do_check() {
	npm run test
}

do_install() {
	vmkdir usr/lib/node_modules/typescript
	vcopy node_modules/typescript/package.json usr/lib/node_modules/typescript

	vmkdir usr/lib/node_modules/typescript/lib
	vcopy "node_modules/typescript/lib/*" usr/lib/node_modules/typescript/lib

	vmkdir usr/lib/node_modules/typescript/bin
	vinstall node_modules/typescript/bin/tsc 755 usr/lib/node_modules/typescript/bin
	vinstall node_modules/typescript/bin/tsserver 755 usr/lib/node_modules/typescript/bin

	vmkdir usr/bin
	ln -s /usr/lib/node_modules/typescript/bin/tsc ${DESTDIR}/usr/bin/tsc
	ln -s /usr/lib/node_modules/typescript/bin/tsserver ${DESTDIR}/usr/bin/tsserver

	vdoc node_modules/typescript/README.md
	vdoc node_modules/typescript/SECURITY.md
}
