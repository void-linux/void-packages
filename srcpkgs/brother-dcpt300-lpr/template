# Template file for 'brother-dcpt300-lpr'
pkgname=brother-dcpt300-lpr
version=3.0.2
revision=1
archs="i686 x86_64"
depends="a2ps ghostscript"
short_desc="LPR driver for the Brother DCP-T300 inkjet printer"
maintainer="Suyono Sukorame <suyonosukorame@ymail.com>"
license="custom:Brother"
homepage="https://support.brother.com/g/b/downloadtop.aspx?c=in&lang=en&prod=dcpt300_all"
distfiles="https://download.brother.com/welcome/dlf101960/dcpt300lpr-${version}-0.i386.deb"
checksum=fb46231309028c037d852318677c19fa3ff91b2369014be68691be9102f65750
mutable_files="/opt/brother/Printers/dcpt300/inf/brdcpt300rc"
repository="nonfree"
nopie=yes

if [ "$XBPS_TARGET_MACHINE" = "x86_64" ]; then
	depends+=" glibc-32bit"
fi

do_install() {
	# The Brother binaries (brdcpt300filter, brprintconf_dcpt300) have
	# hardcoded /opt/brother/Printers/dcpt300/ paths, so the canonical
	# tree must be preserved.
	vcopy opt /
	# brprintconf_dcpt300 is executed at runtime by brcupsconfpt1 (it builds
	# a 'brprintconf_dcpt300 ... -rcfile ...' command via system()) so it
	# must be on PATH.
	vcopy usr /
	# The proprietary binaries are covered by the Brother EULA; ship the
	# license text with the binary package (license="custom:Brother").
	vlicense ${FILESDIR}/agree.html
}
