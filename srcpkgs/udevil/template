# Template file for 'udevil'
pkgname=udevil
version=0.4.4
revision=6
build_style=gnu-configure
configure_args="--disable-systemd
 ac_cv_path_INTLTOOL_UPDATE=/usr/bin/false
 ac_cv_path_INTLTOOL_MERGE=/usr/bin/false
 ac_cv_path_INTLTOOL_EXTRACT=/usr/bin/false
 ac_cv_path_INTLTOOL_PERL=/usr/bin/true
 "
conf_files="/etc/udevil/udevil.conf"
hostmakedepends="pkg-config gettext"
makedepends="libglib-devel eudev-libudev-devel"
short_desc="CLI which mounts and unmounts removable devices without a password"
