# Template file for 'gsoap'
pkgname=gsoap
version=2.8.145
revision=1
build_style=gnu-configure
configure_args="--enable-ipv6"
hostmakedepends="unzip flex autoconf automake libtool ca-certificates"
makedepends="openssl-devel zlib-devel"
short_desc="Toolkit for SOAP and REST Web Services and XML-Based Applications"
maintainer="Enno Boland <gottox@voidlinux.org>"
license="GPL-2.0-only"
homepage="https://www.genivia.com/dev.html"
# distfile is gone from upstream
distfiles="https://sources.voidlinux.org/gsoap-${version}/gsoap_${version}.zip"
distfiles="${SOURCEFORGE_SITE}/gsoap2/gsoap_${version}.zip"
checksum=176767e2443f3586048108209d9424a71b0ae7ba2658655878ab513edec1eede
disable_parallel_build=yes

if [ "$CROSS_BUILD" ]; then
	hostmakedepends+=" gsoap"
fi

CFLAGS="-D_GNU_SOURCE=1"

if [ "$XBPS_TARGET_LIBC" = musl ]; then
	CFLAGS+=" -DWITH_MUSL=1"
fi
CXXFLAGS="$CFLAGS"

post_patch() {
	msg_normal "Generate gsoap/plugin/cacerts.c\n"
	mv gsoap/plugin/cacerts.c cacerts.c.old
	{
		sed '/^const char cacert_pem_data/q' cacerts.c.old
		sed 's/$/\\n\\/' /etc/ssl/certs.pem
		cat <<-EOF
		";
		#ifdef __cplusplus
		}
		#endif
		EOF
	} >gsoap/plugin/cacerts.c
}

pre_configure() {
	autoreconf -fi
}

pre_build() {
	if [ "$CROSS_BUILD" ]; then
		# run host 'soapcpp2'
		sed -i 's|^\(SOAP = \).*|\1soapcpp2|' gsoap/wsdl/Makefile
	fi
}

gsoap-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} ${makedepends}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.a"
		vmove "usr/share"
	}
}
