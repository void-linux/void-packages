# Template file for 'box2d'
pkgname=box2d
version=3.1.1
revision=1
build_style=cmake
configure_args="-DBOX2D_BUILD_TESTBED=OFF -DBOX2D_UNIT_TESTS=OFF
 -DBOX2D_SAMPLES=OFF -DBUILD_SHARED_LIBS=ON"
makedepends="libX11-devel"
short_desc="2D physics engine for games"
maintainer="Đoàn Trần Công Danh <congdanhqx@gmail.com>"
license="MIT"
homepage="https://github.com/erincatto/box2d"
# Use this distfiles until next release
distfiles="https://dev-www.libreoffice.org/src/box2d-${version}.tar.gz"
# distfiles="https://github.com/erincatto/box2d/archive/refs/tags/v${version}.tar.gz"
checksum=fb6ef914b50f4312d7d921a600eabc12318bb3c55a0b8c0b90608fa4488ef2e4

case "$XBPS_TARGET_MACHINE" in
	x86_64*|i686*|armv7*)
		# box2d is used for libreoffice,
		# SIMD should be ON by default
		build_options="simd"
		build_options_default="simd"
		;;
esac

if [ "$build_option_simd" ]; then
	configure_args+=" -DBOX2D_DISABLE_SIMD=OFF"
	case "$XBPS_TARGET_MACHINE" in
	x86_64*) configure_args+=" -DBOX2D_AVX2=ON" ;;
	i686*) CFLAGS+=" -msse" ;;
	armv7*) CFLAGS+=" -mfpu=neon" ;;
	esac
else
	configure_args+=" -DBOX2D_DISABLE_SIMD=ON"
fi

post_install() {
	vlicense LICENSE
	vmkdir usr/lib/pkgconfig
	cat <<-EOF >$DESTDIR/usr/lib/pkgconfig/box2d.pc
	prefix=/usr
	exec_prefix=\${prefix}
	libdir=\{exec_prefix}/lib
	includedir=\${exec_prefix}/include

	Name: box2d
	Description: ${short_desc}
	Version: ${version}
	Libs: -lbox2d
	EOF
}

box2d-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
