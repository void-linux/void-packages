# Template file for 'libpaper'
pkgname=libpaper
version=2.3.0
revision=1
build_style=gnu-configure
conf_files="/etc/paperspecs"
short_desc="Library for handling paper characteristics"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT, GPL-3.0-or-later"
homepage="https://github.com/rrthomas/libpaper"
changelog="https://raw.githubusercontent.com/rrthomas/libpaper/master/ChangeLog"
distfiles="https://github.com/rrthomas/libpaper/releases/download/v${version}/libpaper-${version}.tar.gz"
checksum=882b1c7636052fc9a318caa20292b35616b588824b70e7053018262b29b1409a

post_install() {
	vlicense COPYING-MIT
}

libpaper-devel_package() {
	depends="${sourcepkg}-${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
		vmove "usr/lib/*.so"
	}
}
