pkgname=LACT
version=0.10.1
revision=1
_llvmver=22
build_style=cargo
make_check_args="-- --skip app::root_stack::thermals_page::fan_curve_frame::tests::set_get_curve"
hostmakedepends="pkg-config blueprint-compiler gtk4-devel clang${_llvmver}-devel"
makedepends="gtk4-devel libadwaita-devel libdisplay-info-devel"
