From 45d963b619a90f03d6d6f1268279f0cde41ae32a Mon Sep 17 00:00:00 2001
From: sentriz <senan@senan.xyz>
Date: Mon, 26 Oct 2026 10:52:18 +0000
Subject: [PATCH] fix(subsonic): parse millisecond timestamps as int64 on
 32-bit

Fixes #738
---
 server/ctrlsubsonic/params/params.go | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/server/ctrlsubsonic/params/params.go b/server/ctrlsubsonic/params/params.go
index 53a520358..84ff193ac 100644
--- a/server/ctrlsubsonic/params/params.go
+++ b/server/ctrlsubsonic/params/params.go
@@ -380,12 +380,11 @@ func parseID(in string) (specid.ID, error)  { return specid.New(in) }
 func parseBool(in string) (bool, error)     { return strconv.ParseBool(in) }
 
 func parseTime(in string) (time.Time, error) {
-	ms, err := strconv.Atoi(in)
+	ms, err := strconv.ParseInt(in, 10, 64)
 	if err != nil {
 		return time.Time{}, err
 	}
-	ns := int64(ms) * 1e6
-	return time.Unix(0, ns), nil
+	return time.UnixMilli(ms), nil
 }
 
 func parse(values []string, i any) error {

