# Template file for 'convey'
pkgname=convey
version=50.2.1
revision=1
build_style=meson
configure_args="-Dprofile=release"
# js-tests assert on WebKit-generated markup; fails with webkitgtk 2.50
make_check_args="--exclude convey:js-tests"
hostmakedepends="appstream-glib desktop-file-utils gettext glib-devel
 gobject-introspection iso-codes itstool pkg-config vala"
makedepends="enchant2-devel folks-devel gcr4-devel gmime3-devel
 gnome-online-accounts-devel gst-plugins-base1-devel gstreamer1-devel
 icu-devel json-glib-devel libadwaita-devel libgee08-devel libpeas2-devel
 libsecret-devel libsoup3-devel libstemmer-devel libunwind-devel
 libxml2-devel sqlite-devel libwebkitgtk60-devel ytnef-devel"
depends="gnome-keyring"
checkdepends="dbus gnutls-tools tar xvfb-run xz"
short_desc="Email application for the GNOME desktop"
maintainer="John Mitrich <johnmitrich@gmail.com>"
license="LGPL-2.1-or-later"
homepage="https://gitlab.gnome.org/donnybeelo/convey"
changelog="https://gitlab.gnome.org/donnybeelo/convey/-/raw/main/NEWS"
distfiles="https://gitlab.gnome.org/donnybeelo/convey/-/archive/50.2-1/convey-50.2-1.tar.gz"
checksum=e082e15adc24e20fe8bece3694b707f3b371983dc1f364f860c3aabffaf0ee88
# fork of geary, installs the same hicolor icon files
conflicts="geary>=0"
make_check_pre="env WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1
 dbus-run-session xvfb-run"

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
	# engine-tests abort with SIGABRT on musl
	make_check_args+=" --exclude convey:engine-tests"
fi
