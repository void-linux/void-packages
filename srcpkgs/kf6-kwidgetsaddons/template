# Template file for 'kf6-kwidgetsaddons'
# group=kde-frameworks
pkgname=kf6-kwidgetsaddons
version=6.31.0
revision=1
_llvmver=21
build_style=cmake
configure_args="-DBUILD_DESIGNERPLUGIN=ON $(vopt_bool python BUILD_PYTHON_BINDINGS)"
hostmakedepends="extra-cmake-modules qt6-tools qt6-base
 $(vopt_if python "python3-build python3-setuptools shiboken6 llvm${_llvmver}")"
makedepends="qt6-base-devel qt6-tools-devel
 $(vopt_if python 'libshiboken6-devel libpyside6-devel python3-devel')"
short_desc="KWidgetsAddons"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kwidgetsaddons"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=94d1a1ba334a383c38b7f4238d93895ddd2b40f3d6511b16937bc951b542b5a5

# stage builds
makedepends+=" kf6-base"
shlib_requires="KDE_Frameworks.${version%.*}"

build_options="python"
build_options_default="python"

export LLVM_INSTALL_DIR=/usr/lib/llvm/${_llvmver}

do_check() {
	cd build
	# disable failing tests
	ctest -E "ktooltipwidgettest|kwidgetsaddons-kcolumnresizertest"
}

kf6-kwidgetsaddons-devel_package() {
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
		vmove usr/lib/qt6/plugins/designer
	}
}
