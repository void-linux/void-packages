# Template file for 'tetrio-desktop'
pkgname=tetrio-desktop
version=11
revision=1
archs="x86_64"
hostmakedepends="sed gendesk"
depends="alsa-lib dbus gtk+3 libnotify nss libXtst"
short_desc="TETR.IO desktop client"
maintainer="tema5002 <tema5002@tuta.io>"
license="custom:Proprietary"
homepage="https://tetr.io"
distfiles="https://tetr.io/about/desktop/builds/${version}/TETR.IO%20Setup.tar.gz
 https://txt.osk.sh/branding/tetrio-color.svg>TETR.IO.svg
 https://tetr.io/about/terms>terms.html"
checksum="eb0443a1b85994bf81c68e25390b174b2faae7c057ecc2fcc515fa2f71d66805
 dd7e411f20992eac528d01d8b961a699ddc61b1879fee22e92c1c87aea255aa8
 d70b963d89c48d06874b64598d2259c6965d172c862f45575f0ebeac35343c57"
repository=nonfree
restricted=yes
nopie=yes
nostrip=yes
noshlibprovides=yes
skip_extraction="TETR.IO.svg terms.html"

do_build() {
	# Strip the HTML from the fetched ToS page and leave plain legal text
	sed -e '/<head>/,/<\/head>/d' \
		-e '/<header>/,/<\/header>/d' \
		-e '/<!DOCTYPE/d' \
		-e '/<img/d' \
		-e 's/<[^>]*>//g' \
		-e 's/^[ \t]*//' \
		-e '/^BACK$/d' \
		-e '/^[[:space:]]*$/d' \
		"${XBPS_SRCDISTDIR}/${pkgname}-${version}/terms.html" > LICENSE

	gendesk -n \
		--pkgname "${pkgname}" \
		--name 'TETR.IO' \
		--pkgdesc "${short_desc}" \
		--exec "${pkgname} %U" \
		--icon 'TETR.IO' \
		--categories 'Game;BlocksGame;' \
		--mimetypes 'x-scheme-handler/tetrio' \
		--custom 'StartupWMClass=TETR.IO'
}

do_install() {
	local package_location="usr/lib/${pkgname}"

	vmkdir "${package_location}"
	vcopy "*" "${package_location}"
	rm -f "${DESTDIR}/${package_location}/LICENSE" "${DESTDIR}/${package_location}/${pkgname}.desktop"

	chmod 755 "${DESTDIR}/${package_location}/TETR.IO" "${DESTDIR}/${package_location}/chrome_crashpad_handler"
	chmod 4755 "${DESTDIR}/${package_location}/chrome-sandbox"

	vinstall "${XBPS_SRCDISTDIR}/${pkgname}-${version}/TETR.IO.svg" 644 usr/share/icons/hicolor/scalable/apps
	vinstall "${pkgname}.desktop" 644 usr/share/applications

	vmkdir usr/bin
	ln -s "../lib/${pkgname}/TETR.IO" "${DESTDIR}/usr/bin/${pkgname}"

	vlicense LICENSE
	local f
	for f in LICENSE.electron.txt LICENSES.chromium.html; do
		if [ -f "${f}" ]; then
			vlicense "${f}"
		fi
	done
}
