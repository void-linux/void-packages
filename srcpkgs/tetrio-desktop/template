# Template file for 'tetrio-desktop'
pkgname=tetrio-desktop
version=10
revision=1
archs="x86_64"
hostmakedepends="gendesk sed"
depends="alsa-lib dbus gtk+3 libnotify nss libXtst"
short_desc="TETR.IO desktop client"
maintainer="tema5002 <tema5002@tuta.io>"
license="custom:Proprietary"
homepage="https://tetr.io"
distfiles="https://tetr.io/about/desktop/builds/${version}/TETR.IO%20Setup.tar.gz
 https://txt.osk.sh/branding/tetrio-color.svg>TETR.IO.svg
 https://tetr.io/about/terms>terms.html"
checksum="474138f6114a65313f3f5ffd938d98b38eb6e817d8fc396978a0c58a475730e5
 dd7e411f20992eac528d01d8b961a699ddc61b1879fee22e92c1c87aea255aa8
 df90b79f4490e16b64dd9666d0817ac9419ac5eca7ee77b8b7d8b9dc5c8736fa"
repository=nonfree
restricted=yes
nopie=yes
nostrip=yes
skip_extraction="TETR.IO.svg terms.html"

post_extract() {
	# Strip the HTML tags from the fetched ToS page and leave plain legal text
	sed -e '/<head>/,/<\/head>/d' \
		-e '/<header>/,/<\/header>/d' \
		-e '/<!DOCTYPE/d' \
		-e '/<img/d' \
		-e 's/<[^>]*>//g' \
		-e 's/^[ \t]*//' \
		-e '/^BACK$/d' \
		-e '/^[[:space:]]*$/d' \
		"${XBPS_SRCDISTDIR}/${pkgname}-${version}/terms.html" > LICENSE

	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/TETR.IO.svg" .
}

do_install() {
	cd "${wrksrc}"
	local package_location="usr/lib/${pkgname}"

	vmkdir "${package_location}"
	vmkdir usr/bin

	vmkdir usr/share/icons/hicolor/scalable/apps
	vcopy "TETR.IO.svg" usr/share/icons/hicolor/scalable/apps

	chmod +x TETR.IO
	chmod +x chrome-sandbox
	chmod +x chrome_crashpad_handler

	for item in \
		TETR.IO \
		chrome-sandbox \
		chrome_crashpad_handler \
		chrome_100_percent.pak \
		chrome_200_percent.pak \
		icudtl.dat \
		libEGL.so \
		libGLESv2.so \
		libffmpeg.so \
		libvk_swiftshader.so \
		libvulkan.so.1 \
		resources.pak \
		snapshot_blob.bin \
		v8_context_snapshot.bin \
		vk_swiftshader_icd.json \
		locales \
		resources
	do
		cp -R "${wrksrc}/${item}" "${DESTDIR}/${package_location}"
	done

	gendesk -n \
		--pkgname ${pkgname} \
		--name 'TETR.IO' \
		--pkgdesc "${short_desc}" \
		--exec ${pkgname} \
		--icon 'TETR.IO' \
		--categories 'Game;BlocksGame;' \
		--mimetypes "x-scheme-handler/tetrio" \
		--custom "StartupWMClass=TETR.IO"

	vmkdir usr/share/applications
	vcopy "${pkgname}.desktop" usr/share/applications

	ln -sfr "${DESTDIR}/${package_location}/TETR.IO" "${DESTDIR}/usr/bin/tetrio-desktop"
}

post_install() {
	vlicense LICENSE
}
