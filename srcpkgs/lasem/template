# Template file for 'lasem'
pkgname=lasem
version=0.6.0
revision=1
build_style=meson
build_helper=gir
hostmakedepends="pkg-config gettext flex bison glib-devel"
makedepends="libglib-devel gdk-pixbuf-devel cairo-devel pango-devel libxml2-devel"
short_desc="SVG and Mathml rendering library"
maintainer="Đoàn Trần Công Danh <congdanhqx@gmail.com>"
license="LGPL-2.1-or-later"
homepage="https://github.com/LasemProject/lasem"
distfiles="https://github.com/LasemProject/lasem/releases/download/${version}/lasem-${version}.tar.xz"
checksum=991a23debf7e2c5683516d7a90eca112a9c985252e984d0e3410691d7e1159ea

lasem-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
		vmove "usr/share/gir*"
	}
}
