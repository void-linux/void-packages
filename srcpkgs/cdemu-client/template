# Template file for 'cdemu-client'
pkgname=cdemu-client
version=3.3.1
revision=1
build_style=cmake
configure_args="-DCMAKE_INSTALL_COMPLETIONSDIR=/usr/share/bash-completion/completions
 -DPOST_INSTALL_HOOKS=OFF"
hostmakedepends="python3 gettext pkg-config"
depends="cdemu-daemon python3-gobject"
short_desc="Simple command-line client for controlling CDEmu daemon"
maintainer="Helmut Pozimski <helmut@pozimski.eu>"
license="GPL-2.0-or-later"
homepage="https://cdemu.sourceforge.io"
distfiles="${SOURCEFORGE_SITE}/cdemu/cdemu-client-${version}.tar.xz"
checksum=dba28c77636da0c1c6d802603c64894e072c85f4b22735b47548a9980dcd1a5c

post_patch() {
	sed -i '
		/find_package.*IntlTool/s/REQUIRED//
		/intltool_merge/d
	' CMakeLists.txt
	sed -i 's/^_//' data/cdemu-client.desktop.in
}

post_build() {
	msgfmt --desktop --template data/cdemu-client.desktop.in \
		-d po -o build/cdemu-client.desktop
}
