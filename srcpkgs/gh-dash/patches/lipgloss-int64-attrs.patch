lipgloss v2 stores its boolean style properties in an "int" bitmask, while
the property keys are int64. The Inline() key is bit 41, which does not fit
into a 32-bit int, so on 32-bit targets Inline(true) is silently dropped
and styles keep their padding. This changes how the carousel widget renders
its overflow ellipsis and drops the left border of every panel.

Upstream fix: https://github.com/charmbracelet/lipgloss/pull/348

--- a/vendor/charm.land/lipgloss/v2/get.go
+++ b/vendor/charm.land/lipgloss/v2/get.go
@@ -505,7 +505,7 @@
 	if !s.isSet(k) {
 		return defaultVal
 	}
-	return s.attrs&int(k) != 0
+	return s.attrs&int64(k) != 0
 }
 
 func (s Style) getAsColors(k propKey) (colors []color.Color) {
--- a/vendor/charm.land/lipgloss/v2/set.go
+++ b/vendor/charm.land/lipgloss/v2/set.go
@@ -89,16 +89,16 @@
 	default:
 		if v, ok := value.(bool); ok { //nolint:nestif
 			if v {
-				s.attrs |= int(key)
+				s.attrs |= int64(key)
 			} else {
-				s.attrs &^= int(key)
+				s.attrs &^= int64(key)
 			}
-		} else if attrs, ok := value.(int); ok {
+		} else if attrs, ok := value.(int64); ok {
 			// bool attrs
-			if attrs&int(key) != 0 {
-				s.attrs |= int(key)
+			if attrs&int64(key) != 0 {
+				s.attrs |= int64(key)
 			} else {
-				s.attrs &^= int(key)
+				s.attrs &^= int64(key)
 			}
 		}
 	}
--- a/vendor/charm.land/lipgloss/v2/style.go
+++ b/vendor/charm.land/lipgloss/v2/style.go
@@ -147,7 +147,7 @@
 	link, linkParams string
 
 	// we store bool props values here
-	attrs int
+	attrs int64
 
 	// props that have values
 	fgColor color.Color
