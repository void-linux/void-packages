# Template file for 'mimalloc'
pkgname=mimalloc
version=3.7.1
revision=1
build_style=cmake
configure_args="-DCMAKE_BUILD_TYPE=Release -DMI_BUILD_OBJECT=OFF -DMI_INSTALL_TOPLEVEL=ON $(vopt_bool secure MI_SECURE) -DMI_NO_LIB_SUFFIX=ON"
short_desc="General purpose allocator with excellent performance characteristics"
maintainer="Jason Elswick <jason@jasondavid.us>"
license="MIT"
homepage="https://github.com/microsoft/mimalloc"
distfiles="https://github.com/microsoft/mimalloc/archive/refs/tags/v${version}.tar.gz"
checksum=8bc9f820eaf3dad3509d7930d80c40512bc51e04989641f892ee64c46b7ab0d8

build_options="secure"
build_options_default="secure"
desc_option_secure="Build mimalloc in secure mode"

if [ "${XBPS_TARGET_LIBC}" = "musl" ]; then
	configure_args+=" -DMI_LIBC_MUSL=ON"
fi

if [ "$XBPS_TARGET_ENDIAN" = "be" ]; then
	configure_args+=" -DMI_BIG_ENDIAN_EXITCODE=1"
else
	configure_args+=" -DMI_BIG_ENDIAN_EXITCODE=0"
fi

post_install() {
	vlicense LICENSE
}

mimalloc-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove usr/lib/libmimalloc.so
		vmove usr/lib/libmimalloc.a
		vmove usr/lib/pkgconfig
	}
}
