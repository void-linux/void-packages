# Template file for 'libssh'
pkgname=libssh
version=0.12.2
revision=1
build_style=cmake
hostmakedepends="pkg-config python3"
makedepends="zlib-devel openssl-devel cmocka-devel"
checkdepends="openssh"
short_desc="Multiplatform C library implementing the SSH v2 protocol"
maintainer="skmpz <dem.procopiou@gmail.com>"
license="LGPL-2.1-or-later"
homepage="https://www.libssh.org/"
changelog="https://git.libssh.org/projects/libssh.git/plain/CHANGELOG"
distfiles="https://www.libssh.org/files/${version%*.*}/libssh-${version}.tar.xz"
checksum=49560f677d96e3706a904ac2de1116e25f3680937d51e5c92198fcba4a1c1e9f

case "$XBPS_TARGET_MACHINE" in
	*-musl) configure_args="-DHAVE_GLOB=0" ;;
esac

if [ "$XBPS_CHECK_PKGS" ]; then
	configure_args+=" -DUNIT_TESTING=ON"
else
	configure_args+=" -DUNIT_TESTING=OFF"
fi

libssh-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/lib/cmake
	}
}
