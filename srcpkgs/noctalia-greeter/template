# Template file for 'noctalia-greeter'
pkgname=noctalia-greeter
version=1.6.0
revision=1
build_style=meson
configure_args="--buildtype=plain"
hostmakedepends="pkg-config wayland-devel"
makedepends="wayland-devel wayland-protocols wlroots0.20-devel
 libinput-devel libglvnd-devel freetype-devel fontconfig-devel
 cairo-devel pango-devel harfbuzz-devel librsvg-devel libxml2-devel
 libxkbcommon-devel glib-devel tomlplusplus-devel json-c++ stb
 libwebp-devel"
depends="greetd dbus bash"
short_desc="Minimal login greeter for greetd matching Noctalia Shell"
maintainer="BlackScorp <cccpmik@gmail.com>"
license="MIT"
homepage="https://github.com/noctalia-dev/noctalia-greeter"
distfiles="https://github.com/noctalia-dev/noctalia-greeter/archive/refs/tags/v${version}.tar.gz"
checksum=f23ebf07cbe4508971c08b0b81d2b5bfc4ec1ec45605d8f8fb01b799743a70b6
make_dirs="/var/lib/noctalia-greeter 0750 _greeter _greeter"

post_install() {
	# The upstream tmpfiles entry hardcodes "greeter"; Void uses "_greeter".
	rm -f "${DESTDIR}/usr/lib/tmpfiles.d/noctalia-greeter.conf"
	vlicense LICENSE
	vlicense "${FILESDIR}/wuffs-LICENSE-MIT"
}
