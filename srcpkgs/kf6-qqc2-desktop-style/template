do_check() {
	cd build
	ctest -E "animationspeedmodifiertest|TextFieldContextMenuTest"
}

kf6-qqc2-desktop-style-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/lib/cmake
	}
}
