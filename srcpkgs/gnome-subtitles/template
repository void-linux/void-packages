# Template file for 'gnome-subtitles'
pkgname=gnome-subtitles
version=1.8
revision=1
_gst=1.28.9
_gtk=786f531be6c2285c8fe5d00163a4aa28e912f528
build_style=meson
build_helper=gir
# configure_args="--disable-schemas-compile"
hostmakedepends="glib-devel gettext mono pkg-config yelp-tools
 gobject-introspection"
makedepends="gst-plugins-base1-devel gtkspell3-devel
 gst-plugins-bad1-devel gst-rtsp-server-devel
 gst1-editing-services-devel
 gtk+3-devel mono-devel"
depends="gst-libav mono"
short_desc="Video subtitle editor for GNOME"
maintainer="Enno Boland <gottox@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="http://www.gnomesubtitles.org/"
distfiles="${SOURCEFORGE_SITE}/${pkgname}/${pkgname}-${version}.tar.xz
 https://gstreamer.freedesktop.org/src/gstreamer-sharp/gstreamer-sharp-${_gst}.tar.xz
 https://github.com/GLibSharp/GtkSharp/archive/${_gtk}.tar.gz
 "
checksum="2c13ab03380587e6ab05ac4d5267c238136b028fdf26e2d8d1abe93756deb35a
 c0206b072651c0cce75b3519011408686302573a19cf52cdb3ef5d88c7f34dcb
 53ffe5befccd9ff4d3dcbfecf3cfbc2b914b6bdfa1d1b724f2f2c747d47b953e"

skip_extraction="gstreamer-sharp-${_gst}.tar.xz ${_gtk}.tar.gz"
nocross=yes

post_extract() {
	mkdir -p subprojects/gstreamer-sharp
	vsrcextract -C subprojects/gstreamer-sharp \
		"gstreamer-sharp-${_gst}.tar.xz"
	mkdir -p subprojects/gtk-sharp
	vsrcextract -C subprojects/gtk-sharp \
		"${_gtk}.tar.gz"
}

pre_configure() {
	if [ "$CROSS_BUILD" ]; then
		cat <<-EOF >csc.meson
		[binaries]
		cs = 'mcs'
		EOF
		configure_args+=" --cross-file=csc.meson"
	fi
}
