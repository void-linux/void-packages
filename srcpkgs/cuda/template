cuda-runtime_package() {
	short_desc="CUDA Runtime"
	depends="cuda-common-${version}_${revision}"
	nostrip=yes
	pkg_install() {
		# cuda-cudart
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy cuda_cudart/targets/x86_64-linux/lib/"*.so.*" opt/cuda/targets/x86_64-linux/lib

		# cuda-nvrtc
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy cuda_nvrtc/targets/x86_64-linux/lib/"*.so.*" opt/cuda/targets/x86_64-linux/lib

		# cuda-opencl
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy cuda_opencl/targets/x86_64-linux/lib/"*.so.*" opt/cuda/targets/x86_64-linux/lib

		# libcublas13
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy libcublas/targets/x86_64-linux/lib/"libcublas.so.*" opt/cuda/targets/x86_64-linux/lib
		vcopy libcublas/targets/x86_64-linux/lib/"libcublasLt.so.*" opt/cuda/targets/x86_64-linux/lib
		vcopy libcublas/targets/x86_64-linux/lib/"libnvblas.so.*" opt/cuda/targets/x86_64-linux/lib

		# libcufft
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy libcufft/targets/x86_64-linux/lib/"libcufft*.so.*" opt/cuda/targets/x86_64-linux/lib

		# libcufile
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vmkdir opt/cuda/targets/x86_64-linux/include
		vcopy libcufile/targets/x86_64-linux/include/cufile.h opt/cuda/targets/x86_64-linux/include
		vcopy libcufile/targets/x86_64-linux/lib/"libcufile.so.*" opt/cuda/targets/x86_64-linux/lib
		vcopy libcufile/targets/x86_64-linux/lib/"libcufile_rdma.so.*" opt/cuda/targets/x86_64-linux/lib

		# libcuobjclient
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vmkdir opt/cuda/gds/cuobject
		vcopy libcuobjclient/targets/x86_64-linux/lib/"libcuobjclient.so.*" opt/cuda/targets/x86_64-linux/lib
		vcopy libcuobjclient/gds/cuobject/cuObjRDMADESCRprotocolformat.pdf opt/cuda/gds/cuobject
		vcopy libcuobjclient/gds/cuobject/README opt/cuda/gds/cuobject
		vcopy libcuobjclient/gds/cuobject/VERSION opt/cuda/gds/cuobject
		vcopy libcuobjclient/gds/cuobject/Doxyfile.in opt/cuda/gds/cuobject

		# libcurand
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy libcurand/targets/x86_64-linux/lib/"libcurand.so.*" opt/cuda/targets/x86_64-linux/lib

		# libcusolver
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy libcusolver/targets/x86_64-linux/lib/"libcusolver.so.*" opt/cuda/targets/x86_64-linux/lib
		vcopy libcusolver/targets/x86_64-linux/lib/"libcusolverMg.so.*" opt/cuda/targets/x86_64-linux/lib

		# libcucusparse
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy libcusparse/targets/x86_64-linux/lib/"libcusparse.so.*" opt/cuda/targets/x86_64-linux/lib

		# libnpp
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy libnpp/targets/x86_64-linux/lib/"libnpp*.so.*" opt/cuda/targets/x86_64-linux/lib

		# libnvfatbin
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy libnvfatbin/targets/x86_64-linux/lib/"libnvfatbin*.so.*" opt/cuda/targets/x86_64-linux/lib

		# libnvjitlink
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy libnvjitlink/targets/x86_64-linux/lib/"*.so.*" opt/cuda/targets/x86_64-linux/lib

		# libnvjpeg
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy libnvjpeg/targets/x86_64-linux/lib/"libnvjpeg.so.*" opt/cuda/targets/x86_64-linux/lib

		cat <<-EOF >cuda.conf
		/opt/cuda/lib64
		/opt/cuda/nvvm/lib64
		EOF
		vinstall cuda.conf 644 etc/ld.so.conf.d
	}
}

cuda-tools_package() {
	short_desc="CUDA Command Line Tools"
	depends="cuda-common-${version}_${revision}"
	skiprdeps="
	 /opt/cuda/bin/cuda-gdb-python3.8-tui
	 /opt/cuda/bin/cuda-gdb-python3.9-tui
	 /opt/cuda/bin/cuda-gdb-python3.10-tui
	 /opt/cuda/bin/cuda-gdb-python3.11-tui
	 /opt/cuda/bin/cuda-gdb-python3.12-tui
	 /opt/cuda/compute-sanitizer/x86/libTreeLauncherTargetUpdatePreloadInjection.so
	 /opt/cuda/compute-sanitizer/x86/TreeLauncherSubreaper
	 /opt/cuda/compute-sanitizer/x86/libInterceptorInjectionTarget.so
	 /opt/cuda/compute-sanitizer/x86/libTreeLauncherTargetInjection.so
	 /opt/cuda/compute-sanitizer/x86/TreeLauncherTargetLdPreloadHelper
	"
	nostrip=yes
	pkg_install() {
		# cuda-cupti
		vmkdir opt/cuda/extras
		vcopy cuda_cupti/extras/CUPTI opt/cuda/extras

		# cuda-gdb
		vmkdir opt/cuda/bin
		vmkdir opt/cuda/extras/Debugger
		vmkdir opt/cuda/share
		vcopy cuda_gdb/bin opt/cuda
		vcopy cuda_gdb/extras/Debugger opt/cuda/extras
		vcopy cuda_gdb/share opt/cuda

		# nvdisasm
		vmkdir opt/cuda/bin
		vcopy cuda_nvdisasm/bin/nvdisasm opt/cuda/bin

		# nvtx
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vmkdir opt/cuda/targets/x86_64-linux/include
		vcopy cuda_nvtx/targets/x86_64-linux/lib opt/cuda/targets/x86_64-linux
		vcopy cuda_nvtx/targets/x86_64-linux/include opt/cuda/targets/x86_64-linux

		# compute-sanitizer
		vmkdir opt/cuda/compute-sanitizer
		vcopy cuda_sanitizer_api/compute-sanitizer opt/cuda

		# compute-sanitizer-integration
		vmkdir opt/cuda/bin
		vcopy integration/Sanitizer/"*" opt/cuda/bin
	}
}

cuda-compiler_package() {
	short_desc="CUDA Compiler"
	depends="cuda-common-${version}_${revision}"
	nostrip=yes
	pkg_install() {
		# cuda-crt
		vmkdir opt/cuda/targets/x86_64-linux/include
		vcopy cuda_crt/targets/x86_64-linux/include/crt opt/cuda/targets/x86_64-linux/include

		# cuda-ctadvisor
		vmkdir opt/cuda/bin
		vcopy cuda_ctadvisor/bin/ctadvisor opt/cuda/bin

		# cuda-cuobjdump
		vmkdir opt/cuda/bin
		vcopy cuda_cuobjdump/bin/cuobjdump opt/cuda/bin

		# cuda-cuxxfilt
		vmkdir opt/cuda/bin
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vmkdir opt/cuda/targets/x86_64-linux/include
		vcopy cuda_cuxxfilt/bin/cu++filt opt/cuda/bin
		vcopy cuda_cuxxfilt/targets/x86_64-linux/lib opt/cuda/targets/x86_64-linux
		vcopy cuda_cuxxfilt/targets/x86_64-linux/include opt/cuda/targets/x86_64-linux

		# cuda-nvcc
		vmkdir opt/cuda/bin
		vmkdir opt/cuda/targets/x86_64-linux/include
		vcopy cuda_nvcc/bin opt/cuda
		vcopy cuda_nvcc/targets/x86_64-linux/include/"*.h" opt/cuda/targets/x86_64-linux/include

		# cuda-nvprune
		vmkdir opt/cuda/bin
		vcopy cuda_nvprune/bin/nvprune opt/cuda/bin

		# tileiras
		vmkdir opt/cuda/bin
		vcopy cuda_tileiras/bin/tileiras opt/cuda/bin

		# libnvptxcompiler
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vmkdir opt/cuda/targets/x86_64-linux/include
		vcopy libnvptxcompiler/targets/x86_64-linux/lib opt/cuda/targets/x86_64-linux
		vcopy libnvptxcompiler/targets/x86_64-linux/include opt/cuda/targets/x86_64-linux

		# libnvvm
		vmkdir opt/cuda/nvvm
		vcopy libnvvm/nvvm/bin opt/cuda/nvvm
		vcopy libnvvm/nvvm/include opt/cuda/nvvm
		vcopy libnvvm/nvvm/lib64 opt/cuda/nvvm
		vcopy libnvvm/nvvm/libdevice opt/cuda/nvvm
	}
}
