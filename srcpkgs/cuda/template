# Template file for 'cuda'
pkgname=cuda
version=13.2.2
revision=1
_nvidia_ver=595.71.05
# See this table for compatibility and the archive for available versions:
# https://docs.nvidia.com/cuda/cuda-toolkit-release-notes/index.html#id10
# https://developer.nvidia.com/cuda-toolkit-archive
metapackage=yes
archs="x86_64"
build_wrksrc="builds"
hostmakedepends="tar"
depends="
 cuda-compiler
 cuda-devel
 cuda-runtime
 cuda-tools"
short_desc="NVIDIA CUDA Toolkit"
maintainer="Duncaen <duncaen@voidlinux.org>"
license="custom:NVIDIA Proprietary"
homepage="https://developer.nvidia.com/cuda"
distfiles="https://developer.download.nvidia.com/compute/cuda/${version}/local_installers/cuda_${version}_${_nvidia_ver}_linux.run"
checksum="ba1f73f356810870272e3bfa25fcde98ffe1abb0f603fb65fe3461df7fa85c22"

repository="nonfree"

nopie_files="
 /opt/cuda/gds/tools/gds_stats
 /opt/cuda/gds/tools/gdscheck
 /opt/cuda/gds/tools/gdscp
 /opt/cuda/gds/tools/gdsio_verify
 /opt/cuda/gds/tools/gdsio

 /opt/cuda/bin/cuda-gdbserver
 /opt/cuda/bin/cuda-gdb-minimal
 /opt/cuda/bin/cuda-gdb-python3.9-tui
 /opt/cuda/bin/cuda-gdb-python3.10-tui
 /opt/cuda/bin/cuda-gdb-python3.11-tui
 /opt/cuda/bin/cuda-gdb-python3.12-tui
 /opt/cuda/bin/cuda-gdb-python3.8-tui

 /opt/cuda/compute-sanitizer/x86/TreeLauncherTargetLdPreloadHelper
 /opt/cuda/compute-sanitizer/x86/TreeLauncherSubreaper
 /opt/cuda/compute-sanitizer/compute-sanitizer
 /opt/cuda/compute-sanitizer/TreeLauncherTargetLdPreloadHelper
 /opt/cuda/compute-sanitizer/TreeLauncherSubreaper

 /opt/cuda/nvvm/bin/cicc

 /opt/cuda/bin/tileiras

 /opt/cuda/bin/__nvcc_device_query
"

do_extract() {
	sh "${XBPS_SRCDISTDIR}/${pkgname}-${version}/cuda_${version}_${_nvidia_ver}_linux.run" --target "${wrksrc}" --noexec
}

_create_pkgconfig() {
	vmkdir usr/lib/pkgconfig
	cat <<-EOF >"${PKGDESTDIR:-${DESTDIR}}/usr/lib/pkgconfig/${name?}-${ver?}.pc"
	cudaroot=/opt/cuda
	libdir=\${cudaroot}/targets/x86_64-linux/lib
	includedir=\${cudaroot}/targets/x86_64-linux/include

	Name: ${name?}
	Description: ${desc?}
	Version: ${ver}
	Libs: -L\${libdir}${subdir:+/${subdir}} -l${name?}
	Cflags: -I\${includedir}
	EOF
}

cuda-common_package() {
	short_desc="CUDA common files"
	pkg_install() {
		vmkdir opt/cuda
		ln -s targets/x86_64-linux/lib "${PKGDESTDIR}/opt/cuda/lib64"
		ln -s targets/x86_64-linux/lib "${PKGDESTDIR}/opt/cuda/lib"
		ln -s targets/x86_64-linux/include "${PKGDESTDIR}/opt/cuda/include"
		vlicense EULA.txt
	}
}

cuda-devel_package() {
	short_desc="CUDA Toolkit"
	depends="cuda-common-${version}_${revision} cuda-runtime-${version}_${revision}"
	nostrip=yes
	pkg_install() {
		# cuda-cccl
		vmkdir opt/cuda
		vcopy cuda_cccl/targets opt/cuda

		# cuda-cudart-dev
		name=cudart ver=13.2 desc="CUDA Runtime Library" _create_pkgconfig
		vmkdir opt/cuda/targets/x86_64-linux/lib
		vcopy cuda_cudart/targets/x86_64-linux/lib/"*.a" opt/cuda/targets/x86_64-linux/lib
		vcopy cuda_cudart/targets/x86_64-linux/lib/"*.so" opt/cuda/targets/x86_64-linux/lib
		vcopy cuda_cudart/targets/x86_64-linux/include opt/cuda/targets/x86_64-linux

		# cuda-driver-dev
		name=cuda ver=13.2 subdir=stubs desc="CUDA Driver Library" _create_pkgconfig
		vmkdir opt/cuda/targets/x86_64-linux/lib/stubs
		vcopy cuda_cudart/targets/x86_64-linux/lib/stubs/libcuda.so opt/cuda/targets/x86_64-linux/lib/stubs

		# cuda-nvml-dev
		name=nvidia-ml ver=13.2 subdir=stubs desc="NVML" _create_pkgconfig
		vmkdir opt/cuda/targets/x86_64-linux/include
		vmkdir opt/cuda/targets/x86_64-linux/lib/stubs
		vmkdir opt/cuda/nvml
		vcopy cuda_nvml_dev/targets/x86_64-linux/lib/stubs/libnvidia-ml.a opt/cuda/targets/x86_64-linux/lib/stubs
		vcopy cuda_nvml_dev/targets/x86_64-linux/lib/stubs/libnvidia-ml.so opt/cuda/targets/x86_64-linux/lib/stubs
		vcopy cuda_nvml_dev/targets/x86_64-linux/include/nvml.h opt/cuda/targets/x86_64-linux/include
		vcopy cuda_nvml_dev/nvml opt/cuda

		# cuda-nvrtc-dev
		name=nvrtc ver=13.2 desc="A runtime compilation library for CUDA C++" _create_pkgconfig
