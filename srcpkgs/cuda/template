		# cuda-sandbox-dev
		vmkdir opt/cuda/targets/x86_64-linux/include
		vmkdir opt/cuda/targets/x86_64-linux/lib/stubs
		vcopy cuda_sandbox_dev/targets/x86_64-linux/include/nvsandboxutils.h opt/cuda/targets/x86_64-linux/include
		vcopy cuda_sandbox_dev/targets/x86_64-linux/include/nvsandboxutils_loader.h opt/cuda/targets/x86_64-linux/include
		vcopy cuda_sandbox_dev/targets/x86_64-linux/lib/stubs/libnvidia-sandboxutils_loader.a opt/cuda/targets/x86_64-linux/lib/stubs


		# libcublas-dev
		name=cublas ver=13 desc="CUDA Basic Linear Algebra Subprograms" _create_pkgconfig
		vmkdir opt/cuda/targets/x86_64-linux/include
		vmkdir opt/cuda/targets/x86_64-linux/lib/stubs
		vmkdir opt/cuda/src
