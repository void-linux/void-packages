From fb07a6da892ba8e577f932af24a9575c870582c2 Mon Sep 17 00:00:00 2001
From: Lemmy <studio@quadbyte.net>
Date: Mon, 19 Oct 2026 11:43:25 -0400
Subject: [PATCH] test(plugins): tolerate floating-point precision in
 recommendation scores

---
 CONTRIBUTING.md                       | 4 ++++
 tests/plugin_recommendations_test.cpp | 4 +++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/CONTRIBUTING.md b/CONTRIBUTING.md
index e2d04a170d..eda86a0ba3 100644
--- a/CONTRIBUTING.md
+++ b/CONTRIBUTING.md
@@ -175,6 +175,10 @@ a release build would pass a broken test silently; `TEST_CHECK` prints the faile
 exits non-zero. The header refuses to compile with `NDEBUG`, so test executables set
 `override_options: ['b_ndebug=false']` in `meson.build`.
 
+Compare parsed floating-point values with an appropriate tolerance, not exact equality to a decimal literal. For
+double-precision fixtures near 1, use `std::abs(actual - expected) <= std::numeric_limits<double>::epsilon()`, as in
+the plugin manifest tests. This also accommodates excess precision on 32-bit x87 builds.
+
 ## Commit Messages
 
 Follow the Conventional Commits style used in the history: `type(scope): summary`, or `type: summary` when no scope
diff --git a/tests/plugin_recommendations_test.cpp b/tests/plugin_recommendations_test.cpp
index dacf6bc07c..0ff0245cfb 100644
--- a/tests/plugin_recommendations_test.cpp
+++ b/tests/plugin_recommendations_test.cpp
@@ -10,10 +10,12 @@
 
 #include <algorithm>
 #include <chrono>
+#include <cmath>
 #include <cstdlib>
 #include <filesystem>
 #include <fstream>
 #include <functional>
+#include <limits>
 #include <nlohmann/json.hpp>
 #include <print>
 #include <string>
@@ -65,7 +67,7 @@ namespace {
     const auto metrics = PluginRecommendations::parseMetrics(doc);
     TEST_CHECK(metrics.has_value());
     TEST_CHECK(metrics->at(*key).recommendations == 0);
-    TEST_CHECK(metrics->at(*key).trendingScore == 1.23456789);
+    TEST_CHECK(std::abs(metrics->at(*key).trendingScore - 1.23456789) <= std::numeric_limits<double>::epsilon());
     TEST_CHECK(!metrics->contains("community:CaseAuthor/Case.Plugin"));
     auto invalid = nlohmann::json::parse(doc);
     invalid["schema"] = 2;
