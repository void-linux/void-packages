# Template file for 'muon-bootstrap'
# Needed to prevent build cycles of pkgconf -> python -> meson -> pkgconf
# and pkgconf -> muon -> pkgconf.
pkgname=muon-bootstrap
version=0.6.0
revision=1
bootstrap=yes
hostmakedepends="samurai"
depends="samurai"
short_desc="Meson implementation in C (xbps-src bootstrap package)"
maintainer="Enno Boland <gottox@voidlinux.org>"
license="GPL-3.0-only, Apache-2.0"
homepage="https://muon.build"
changelog="https://muon.build/releases/v${version}/docs/release_notes.html"
distfiles="https://git.sr.ht/~lattis/muon/archive/$version.tar.gz"
checksum=5300e58c4b4d43e3026856004c79d746075aaa9d9e66d76ba9f32ce249495b81
repository=bootstrap
nocross="Builds and runs a stage1 binary to produce the final binary"

do_build() {
	CFLAGS=-DBOOTSTRAP_NO_SAMU ./bootstrap.sh stage1
	stage1/muon-bootstrap setup -Dprefix=/usr \
		-Dman-pages=disabled -Dsamurai=disabled \
		build
	samu -C build
}

do_check() {
	build/muon -C build test -R
}

do_install() {
	# prevent file name conflict with muon
	install -D -m755 build/muon ${DESTDIR}/usr/bin/muon-bootstrap
}
