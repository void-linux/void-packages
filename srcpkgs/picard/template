# Template file for 'picard'
pkgname=picard
version=3.0.2
revision=1
build_style=python3-pep517
hostmakedepends="gettext python3-setuptools python3-shtab python3-pyqt6 python3-mutagen
 python3-pyqt6-network python3-yaml python3-pyqt6-gui python3-pyqt6-widgets python3-pyqt6-dbus"
makedepends="python3-devel"
depends="python3-discid python3-Markdown python3-mutagen python3-PyJWT python3-pyqt6
 python3-yaml python3-charset-normalizer python3-pygit2 python3-tomli python3-pyqt6-gui
 python3-pyqt6-widgets python3-pyqt6-network python3-pyqt6-dbus python3-pyqt6-multimedia
 python3-tomlkit"
checkdepends="python3-pytest $depends python3-pyqt6-test"
short_desc="MusicBrainz's audio tagger"
maintainer="Michael Aldridge <maldridge@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="https://picard.musicbrainz.org/"
changelog="https://picard.musicbrainz.org/changelog/"
distfiles="https://data.musicbrainz.org/pub/musicbrainz/picard/picard-${version}.tar.gz"
checksum=ca875d573eb4b898f99821ec32978d9a6b47dc1f96b25f96608a75b6234d6098

export PICARD_DISABLE_AUTOUPDATE=1

post_install() {
	for shell in bash zsh; do
		PYTHONPATH="${DESTDIR}/${py3_sitelib}" PATH="${DESTDIR}/usr/bin:${PATH}" \
			picard-cli completions "$shell" > "picard-cli.${shell}"
		vcompletion "picard-cli.${shell}" "$shell" picard-cli
	done
}
