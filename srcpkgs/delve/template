# disable tests that require coredumps and network
_skip="TestCore|TestCoreWithEmptyString|TestCoreCGOAssert|TestDump|TestCancelDownload|TestCancelDownloadAfterAttach"

# test.c has no main func, broken on musl. dlopen segfaults.
if [ "$XBPS_TARGET_LIBC" = musl ]; then
	_skip+="|TestNonGoDebug|TestNonGoBinaryWithGoDlopen"
fi

make_check_args="-skip ^(${_skip})$"

post_install() {
	vlicense LICENSE
	vmkdir "usr/share/doc/${pkgname}"
	vcopy Documentation/* "usr/share/doc/${pkgname}"
}
