# Template file for 'tfetch'
pkgname=tfetch
version=1.5
revision=1
#archs="x86_64"
hostmakedepends="clang"
short_desc="fetch utility for linux"
maintainer=" <>"
license="BSD-2-Clause"
homepage="https://github.com/trianguloff/tfetch/"
distfiles="https://github.com/trianguloff/tfetch/archive/refs/tags/v${version}.tar.gz"
checksum=94f36e344a35b0058b5631c81476d66fd1a4f08280a291a2590e000b69627c50
do_build() {

	clang ${CFLAGS} ${LDFLAGS} -o tfetch tfetch-${version}.c

}

do_install() {

	vbin tfetch
	vlicense LICENSE

}
