checksum=c865bd55459c5b8020a6ac962e462fc33eb4bf2dae8bf7c474357c58ce22a95d

SPIRV-Reflect-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} SPIRV-Headers"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
	}
}
