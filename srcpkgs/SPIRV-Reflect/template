SPIRV-Reflect-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} SPIRV-Headers"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.a"
	}
}
