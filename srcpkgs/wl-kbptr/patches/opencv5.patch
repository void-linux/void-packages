From 0854a51cfa5b3d74c0f81f0a4da9b5bb11c9b9f1 Mon Sep 17 00:00:00 2001
From: Dereck Angeles <dereckangeles15071998@gmail.com>
Date: Mon, 3 Aug 2026 13:24:57 -0600
Subject: [PATCH] Support building against OpenCV 4 or 5

Arch and other distributions have moved to OpenCV 5, which
relocated `cv::boundingRect` out of `imgproc.hpp`. Look for
OpenCV 4 first so existing builds are unaffected, and fall
back to OpenCV 5.

fixes #99
---
 meson.build              | 2 +-
 src/target_detection.cpp | 4 ++++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index 979df4d..db88878 100644
--- a/meson.build
+++ b/meson.build
@@ -26,7 +26,7 @@ cc = meson.get_compiler('c')
 if use_opencv
   add_project_arguments('-DOPENCV_ENABLED=1', language: ['c', 'cpp'])
   add_languages('cpp', native: false)
-  opencv = dependency('opencv4')
+  opencv = dependency('opencv4', 'opencv5')
   pixman = dependency('pixman-1')
 endif

diff --git a/src/target_detection.cpp b/src/target_detection.cpp
index 31e8232..1fcf241 100644
--- a/src/target_detection.cpp
+++ b/src/target_detection.cpp
@@ -6,6 +6,10 @@

 #include <opencv2/imgcodecs.hpp>
 #include <opencv2/imgproc.hpp>
+// OpenCV 5 moved `cv::boundingRect` out of `imgproc.hpp`.
+#if __has_include(<opencv2/geometry/2d.hpp>)
+#include <opencv2/geometry/2d.hpp>
+#endif
 #include <pixman.h>
 #include <stdint.h>
 #include <stdlib.h>
