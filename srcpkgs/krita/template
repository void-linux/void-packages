# Template file for 'krita'
pkgname=krita
version=6.0.4
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF -DENABLE_UPDATERS=OFF
 -DBUILD_WITH_QT6=ON -DALLOW_UNSTABLE=QT6
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules gettext pkg-config python3
 qt6-base qt6-declarative-host-tools kf6-kconfig kf6-kcoreaddons
 python3-pyqt6 python3-pyqt6-devel"
makedepends="kf6-karchive-devel kf6-kconfig-devel kf6-kwidgetsaddons-devel
 kf6-kcolorscheme-devel kf6-kcompletion-devel kf6-kcoreaddons-devel
 kf6-kguiaddons-devel kf6-ki18n-devel kf6-kitemviews-devel
 kf6-kwindowsystem-devel kf6-kio-devel kf6-kcrash-devel qt6-svg-devel
 qt6-multimedia-devel qt6-declarative-devel qt6-qt5compat-devel
 qt6-base-private-devel qt6-wayland-devel qt6-wayland-private-devel
 boost-headers gsl-devel tiff-devel libjpeg-turbo-devel libraw-devel fftw-devel
 opencolorio-devel eigen exiv2-devel libXi-devel libopenexr-devel libgomp-devel
 poppler-qt6-devel giflib-devel python3-devel python3-pyqt6
 python3-pyqt6-devel quazip-qt6-devel libheif-devel seexpr-krita-devel
 libopenjpeg2-devel libwebp-devel libmypaint-devel libjxl-devel
 libkdcraw-qt6-devel immer zug lager libunibreak-devel mlt7-devel xsimd"
depends="qt6-plugin-sqlite qt6-wayland python3-pyqt6"
short_desc="Painting and image editing program"
maintainer="John <me@johnnynator.dev>"
license="GPL-3.0-only"
homepage="https://krita.org/"
distfiles="${KDE_SITE}/krita/${version}/krita-${version}.tar.xz"
checksum=ef73e57fe20fa5bd896d53d4af6eb254e5ade83e6a39b47273dd320f9823ab4b
python_version=3
replaces="calligra-krita>=0"
# FIXME
make_check=no

case "$XBPS_TARGET_MACHINE" in
	i686*|x86_64*) makedepends+=" vc";;
esac

pre_configure() {
	# CMake won't search in those directories because of CMAKE_FIND_ROOT_PATH
	if [ "$CROSS_BUILD" ]; then
		configure_args+=" -D_find_sip_py=$wrksrc/cmake/modules/FindSIP.py"
		configure_args+=" -D_find_pyqt6_py=$wrksrc/cmake/modules/FindPyQt6.py"
		configure_args+=" -DTIFF_CAN_WRITE_PSD_TAGS_EXITCODE=0"
	fi
}

post_patch() {
	vsed -i -e 's|set(abi_version "13.0")|set(abi_version "13")|' \
		-e 's|set(abi_version "12.8")|set(abi_version "12")|' \
		cmake/modules/SIPMacros.cmake
}

krita-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
	}
}
