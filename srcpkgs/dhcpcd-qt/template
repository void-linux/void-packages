# Template file for 'dhcpcd-qt'
pkgname=dhcpcd-qt
version=0.8.0
revision=1
build_style=gnu-configure
build_helper=qmake
configure_args="--with-qt --without-dhcpcd-online --without-icons --enable-notification"
hostmakedepends="pkg-config"
makedepends="qt5-devel"
depends="dhcpcd dhcpcd-icons desktop-file-utils"
short_desc="Qt system tray monitor for dhcpcd"
maintainer="Orphaned <orphan@voidlinux.org>"
license="BSD-2-Clause"
homepage="https://roy.marples.name/projects/dhcpcd-ui"
distfiles="https://github.com/NetworkConfiguration/dhcpcd-ui/releases/download/v${version}/dhcpcd-ui-${version}.tar.xz"
checksum=547c6c61704257535873c5f6638f5da68784b049a4e6f45864e80bd658c20bcd

if [ "$CROSS_BUILD" ]; then
	hostmakedepends+=" qt5-devel qt5-host-tools"
fi

pre_configure() {
	export QMAKE=${XBPS_WRAPPERDIR}/qmake-qt5
}

pre_install() {
	head -n 25 src/dhcpcd-qt/dhcpcd-about.cpp > LICENSE
}

do_install() {
	make INSTALL_ROOT=${DESTDIR} install
	vlicense LICENSE
}
