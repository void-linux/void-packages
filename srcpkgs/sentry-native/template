# Template file for 'sentry-native'
pkgname=sentry-native
version=0.17.6
revision=1
build_style=cmake
configure_args="-DSENTRY_BACKEND=inproc -DSENTRY_TRANSPORT=curl"
makedepends="libcurl-devel"
short_desc="Sentry SDK for C, C++ and native applications"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://github.com/getsentry/sentry-native"
changelog="https://raw.githubusercontent.com/getsentry/sentry-native/refs/heads/master/CHANGELOG.md"
distfiles="https://github.com/getsentry/sentry-native/archive/refs/tags/${version}.tar.gz"
checksum=0c7a4d257453bd781ef88362ef786a07104bcdd99e3bb9bde6683fb98d0d2caa

post_install() {
	vlicense LICENSE
}

sentry-native-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
	}
}
