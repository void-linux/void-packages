# Workaround: setuptools-scm can only correctly detect version from PyPI
# tarballs or from git repos. GitHub's tarballs don't have a .git directory,
# hence the following must be set before bulding
pre_build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION="${version}"
}


# Workaround: scc/tools.py:find_library searches for binaries in the source root
# and doesn't respect PYTHONPATH. We symlink compiled libs to root for tests.
pre_check() {
	ln -sf $(find build/lib* -name '*.so') .
}
