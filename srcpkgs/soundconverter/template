# Template file for 'soundconverter'
pkgname=soundconverter
version=4.0.3
revision=4
build_style=python3-module
pycompile_dirs="/usr/lib/${pkgname}/python/${pkgname}"
hostmakedepends="glib gettext pkg-config python3-gobject python3-distutils-extra
 gtk+3 gstreamer1"
makedepends="gtk+3-devel gstreamer1-devel pango python3 gst-plugins-base1 libnotify"
depends="desktop-file-utils gtk+3 gst-plugins-good1 gst-plugins-ugly1
 hicolor-icon-theme python3-gobject python3-setuptools libnotify
 gst-plugins-base1 pango"
short_desc="Leading audio file converter for the GNOME Desktop"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-3.0-or-later"
homepage="http://soundconverter.org/"
distfiles="https://launchpad.net/soundconverter/trunk/${version}/+download/soundconverter-${version}.tar.gz"
checksum=873206ff82c3dfbd397ab3d8bd76fbba847017d2ed28a20a0778eb86960cb19d
python_version=3

post_patch() {
	printf '%s\n' po/*.po | sed 's;po/;;;s/.po//' >po/LINGUAS
	vsed -i 's/^_//' data/soundconverter.desktop.in

	vsed -i '/install.*Install/d' setup.py
}

post_configure() {
	ln -s /bin/true $XBPS_WRAPPERDIR/intltool-update
	msgfmt --desktop --template data/soundconverter.desktop.in \
		-d po -o data/soundconverter.desktop
	rm data/soundconverter.desktop.in
}

post_install() {
	vinstall data/soundconverter.desktop 644 usr/share/applications/
	# Generated by distutils-extra
	# pkg-resources (from setuptools) and other from main python
	sed -i '/Requires:/{/Requires: gi/!d}' \
		$DESTDIR/$py3_sitelib/soundconverter*.egg-info/PKG-INFO
}
